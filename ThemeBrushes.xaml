<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 文字/图标 ========== -->
    <SolidColorBrush x:Key="ForegroundBrush"     Color="#8a8a8a"/>

    <!-- ========== 主背景 ========== -->
    <SolidColorBrush x:Key="BackgroundBrush"     Color="#f3f3f3"/>
    <SolidColorBrush x:Key="MainBorderBrush"     Color="#808a8a8a"/>

    <!-- ========== 卡片/面板 ========== -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush"     Color="#ebebeb"/>

    <!-- ========== 搜索框 ========== -->
    <SolidColorBrush x:Key="SearchBackgroundBrush" Color="#e7e7e7"/>
    <SolidColorBrush x:Key="SearchBorderBrush"     Color="#e7e7e7"/>
    <SolidColorBrush x:Key="SearchFocusBgBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SearchFocusBorderBrush" Color="#c0c0c0"/>
    <SolidColorBrush x:Key="SearchHoverBorderBrush" Color="#d8d8d8"/>

    <!-- ========== 交互状态 ========== -->
    <SolidColorBrush x:Key="SubtleBackgroundBrush"   Color="#e6e6e6"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush"    Color="#e8e8e8"/>
    <SolidColorBrush x:Key="PressedBackgroundBrush"  Color="#d0d0d0"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#b0b0b0"/>

    <!-- ========== 窗口控制 ========== -->
    <SolidColorBrush x:Key="WinControlHoverBrush"   Color="#e0e0e0"/>
    <SolidColorBrush x:Key="WinControlPressedBrush" Color="#c0c0c0"/>

    <!-- ========== 辅助指示器配色 ========== -->

    <!-- ========== 菜单弹出层 ========== -->
    <SolidColorBrush x:Key="MenuPopupBackgroundBrush"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MenuPopupBorderBrush"       Color="#c8c8c8"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush"    Color="#b0b0b0"/>

    <!-- ========== 路径/图标描边 ========== -->
    <SolidColorBrush x:Key="IconStrokeBrush" Color="#8a8a8a"/>

    <!-- ========== 选中态前景色 ========== -->
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="#FFFFFF"/>

    <!-- ========== 终端/控制台 ========== -->
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="TerminalScrollBarBrush"  Color="#C0C0C0"/>
    <SolidColorBrush x:Key="TerminalScrollBarHoverBrush" Color="#A0A0A0"/>
    
    <!-- 启动按钮 -->
    <SolidColorBrush x:Key="RunButton" Color="#8a8a8a"/>

    <!-- ========== 主题色（可配置，运行时由 ThemeManager.ApplyAccentColor 覆盖） ========== -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#4CAF50"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#43A047"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#388E3C"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"    Color="#2E7D32"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"   Color="#C8E6C9"/>

</ResourceDictionary>
