<UserControl x:Class="OCCMissionGoals.Dialogs.NewEntryDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:loc="clr-namespace:OCCMissionGoals"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="660" d:DesignWidth="650">

    <UserControl.Resources>
        <Style x:Key="ColorSwatchRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Outer"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource ForegroundBrush}"/>
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="8">

        <Grid Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,10"
                    Margin="0,0,0,12">
                <Grid>
                    <TextBlock x:Name="DialogTitle" Text="{loc:Loc &quot;新建条目&quot;}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 表单区域（可滚动） -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <!-- 严重程度 -->
                    <TextBlock Text="{loc:Loc &quot;严重程度&quot;}" Style="{StaticResource DialogLabel}"/>
                    <ComboBox x:Name="SeverityComboBox" 
                              Style="{StaticResource DialogComboBox}"
                              Margin="0,0,0,14">
                        <ComboBoxItem Content="{loc:Loc &quot;🔴 致命&quot;}" Tag="0"
                                      Foreground="#D32F2F"
                                      Style="{StaticResource DialogComboBoxItem}"/>
                        <ComboBoxItem Content="{loc:Loc &quot;🔴 严重&quot;}" Tag="1"
                                      Foreground="#E65100"
                                      Style="{StaticResource DialogComboBoxItem}"/>
                        <ComboBoxItem Content="{loc:Loc &quot;🔴 一般&quot;}" Tag="2"
                                      Foreground="#F9A825"
                                      Style="{StaticResource DialogComboBoxItem}"/>
                        <ComboBoxItem Content="{loc:Loc &quot;🔴 补丁&quot;}" Tag="3"
                                      Foreground="#2E7D32"
                                      Style="{StaticResource DialogComboBoxItem}"/>
                        <ComboBoxItem Content="{loc:Loc &quot;🔵 更新&quot;}" Tag="4"
                                      Foreground="#1565C0"
                                      Style="{StaticResource DialogComboBoxItem}"/>
                    </ComboBox>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc &quot;类别&quot;}"
                                   Style="{StaticResource DialogLabel}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 类别输入行：ComboBox + 添加按钮 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="TypeComboBox"
                                  Style="{StaticResource DialogComboBox}"
                                  IsEditable="True"
                                  SelectionChanged="TypeComboBox_SelectionChanged"
                                  DropDownOpened="TypeComboBox_DropDownOpened"
                                  KeyDown="TypeComboBox_KeyDown"
                                  ToolTip="{loc:Loc &quot;选择已有类别直接添加，或输入新类别后按回车/点添加&quot;}"
                                  Margin="0,0,8,0"/>
                        <Button Grid.Column="1"
                                Content="{loc:Loc &quot;添加&quot;}"
                                Click="AddType_Click"
                                Style="{StaticResource DialogConfirmButton}"
                                Height="30" MinWidth="48"
                                FontSize="11" FontWeight="Normal"
                                Padding="8,0"/>
                    </Grid>

                    <!-- 类别颜色（可选） -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc &quot;颜色（可选）&quot;}"
                                   Style="{StaticResource DialogLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1"
                                    x:Name="ColorSwatchPanel"
                                    Orientation="Horizontal"/>
                    </Grid>

                    <!-- 已选类别徽章 -->
                    <ItemsControl x:Name="TypeListControl"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TagBg" Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,4" Margin="0,0,6,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TagText" Text="{Binding Text}"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource StatusBarIconButton}"
                                                Click="RemoveType_Click"
                                                Tag="{Binding}"
                                                Width="20" Height="20"
                                                Background="Transparent"
                                                Foreground="#e81123"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Margin="8,0,0,0">
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Width="12" Height="13"
                                                  Stretch="Uniform"
                                                  Data="M14 2H10C10 0.897 9.103 0 8 0C6.897 0 6 0.897 6 2H2C1.724 2 1.5 2.224 1.5 2.5C1.5 2.776 1.724 3 2 3H2.54L3.349 12.708C3.456 13.994 4.55 15 5.84 15H10.159C11.449 15 12.543 13.993 12.65 12.708L13.459 3H13.999C14.275 3 14.499 2.776 14.499 2.5C14.499 2.224 14.275 2 13.999 2H14ZM8 1C8.551 1 9 1.449 9 2H7C7 1.449 7.449 1 8 1ZM11.655 12.625C11.591 13.396 10.934 14 10.16 14H5.841C5.067 14 4.41 13.396 4.346 12.625L3.544 3H12.458L11.656 12.625H11.655ZM7 5.5V11.5C7 11.776 6.776 12 6.5 12C6.224 12 6 11.776 6 11.5V5.5C6 5.224 6.224 5 6.5 5C6.776 5 7 5.224 7 5.5ZM10 5.5V11.5C10 11.776 9.776 12 9.5 12C9.224 12 9 11.776 9 11.5V5.5C9 5.224 9.224 5 9.5 5C9.776 5 10 5.224 10 5.5Z"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasColor}" Value="True">
                                        <Setter TargetName="TagBg" Property="Background" Value="{Binding Background}"/>
                                        <Setter TargetName="TagBg" Property="BorderBrush" Value="{Binding Background}"/>
                                        <Setter TargetName="TagText" Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- 标题 -->
                    <TextBlock Text="{loc:Loc &quot;标题&quot;}" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="TitleTextBox"
                             Style="{StaticResource DialogTextBox}"
                             Margin="0,0,0,14"/>

                    <!-- 简介 -->
                    <TextBlock Text="{loc:Loc &quot;简介&quot;}" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="BriefTextBox"
                             Style="{StaticResource DialogTextBox}"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Margin="0,0,0,14"/>

                    <!-- 详细信息 -->
                    <TextBlock Text="{loc:Loc &quot;详细信息&quot;}" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="DetailTextBox"
                             Style="{StaticResource DialogTextBox}"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Hidden"
                             VerticalContentAlignment="Top"
                             Margin="0,0,0,14"/>

                    <!-- 截止日期 -->
                    <TextBlock Text="{loc:Loc &quot;截止日期&quot;}" Style="{StaticResource DialogLabel}"/>
                    <DatePicker x:Name="DeadlinePicker"
                                Style="{StaticResource DialogDatePicker}"
                                Margin="0,0,0,14"/>

                    <!-- 版本 -->
                    <TextBlock Text="{loc:Loc &quot;版本&quot;}" Style="{StaticResource DialogLabel}"/>
                    <ComboBox x:Name="VersionComboBox"
                              Style="{StaticResource DialogComboBox}"
                              Margin="0,0,0,14"
                              ToolTip="{loc:Loc &quot;条目所属版本号&quot;}"/>

                    <!-- 相关文件 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc &quot;相关文件&quot;}"
                                   Style="{StaticResource DialogLabel}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="{loc:Loc &quot;＋ 添加文件&quot;}"
                                Click="AddFile_Click"
                                Style="{StaticResource DialogConfirmButton}"
                                Height="28" MinWidth="80"
                                FontSize="11" FontWeight="Normal"
                                Padding="8,0"/>
                    </Grid>
                    <ItemsControl x:Name="FileListControl"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="8,6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 第一行：路径 + 移除 -->
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Path}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}"/>
                                            <Button Grid.Column="1"
                                                    Click="RemoveFile_Click"
                                                    Tag="{Binding}"
                                                    Width="20" Height="20"
                                                    Background="Transparent"
                                                    Foreground="#e81123"
                                                    BorderThickness="0"
                                                    Style="{StaticResource DialogConfirmButton}"
                                                    Cursor="Hand">
                                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="12" Height="13"
                                                      Stretch="Uniform"
                                                      Data="M14 2H10C10 0.897 9.103 0 8 0C6.897 0 6 0.897 6 2H2C1.724 2 1.5 2.224 1.5 2.5C1.5 2.776 1.724 3 2 3H2.54L3.349 12.708C3.456 13.994 4.55 15 5.84 15H10.159C11.449 15 12.543 13.993 12.65 12.708L13.459 3H13.999C14.275 3 14.499 2.776 14.499 2.5C14.499 2.224 14.275 2 13.999 2H14ZM8 1C8.551 1 9 1.449 9 2H7C7 1.449 7.449 1 8 1ZM11.655 12.625C11.591 13.396 10.934 14 10.16 14H5.841C5.067 14 4.41 13.396 4.346 12.625L3.544 3H12.458L11.656 12.625H11.655ZM7 5.5V11.5C7 11.776 6.776 12 6.5 12C6.224 12 6 11.776 6 11.5V5.5C6 5.224 6.224 5 6.5 5C6.776 5 7 5.224 7 5.5ZM10 5.5V11.5C10 11.776 9.776 12 9.5 12C9.224 12 9 11.776 9 11.5V5.5C9 5.224 9.224 5 9.5 5C9.776 5 10 5.224 10 5.5Z"/>
                                            </Button>
                                        </Grid>

                                        <!-- 第二行：函数 / 行 / 列 -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Function, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DialogTextBox}"
                                                     FontSize="11" Padding="4,2"
                                                     Margin="0,0,6,0"
                                                     ToolTip="{loc:Loc &quot;命名空间.类.方法&quot;}"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{loc:Loc &quot;行&quot;}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,3,0"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Line, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DialogTextBox}"
                                                     FontSize="11" Padding="4,2"
                                                     Width="44"
                                                     TextAlignment="Right"
                                                     Margin="0,0,6,0"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="{loc:Loc &quot;列&quot;}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,3,0"/>
                                            <TextBox Grid.Column="4"
                                                     Text="{Binding Column, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DialogTextBox}"
                                                     FontSize="11" Padding="4,2"
                                                     Width="44"
                                                     TextAlignment="Right"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,14,0,0"
                    Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{loc:Loc &quot;取消&quot;}"
                            Click="CancelButton_Click"
                            Style="{StaticResource DialogCancelButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="{loc:Loc &quot;确认&quot;}"
                            Click="ConfirmButton_Click"
                            Style="{StaticResource DialogConfirmButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
