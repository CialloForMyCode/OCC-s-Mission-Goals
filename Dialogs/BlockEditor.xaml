<UserControl x:Class="OCCMissionGoals.Dialogs.BlockEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OCCMissionGoals"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="620">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 添加区块的类型菜单：行的「＋」与底部按钮共用 -->
        <ContextMenu x:Key="AddBlockMenu" x:Shared="False">
            <MenuItem Header="{loc:Loc &quot;文本&quot;}" Tag="Text" Click="AddMenuItem_Click"/>
            <MenuItem Header="{loc:Loc &quot;表格&quot;}" Tag="Table" Click="AddMenuItem_Click"/>
            <MenuItem Header="{loc:Loc &quot;分割线&quot;}" Tag="Divider" Click="AddMenuItem_Click"/>
            <MenuItem Header="{loc:Loc &quot;代码块&quot;}" Tag="Code" Click="AddMenuItem_Click"/>
            <MenuItem Header="{loc:Loc &quot;文件引用&quot;}" Tag="FileRef" Click="AddMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{loc:Loc &quot;编号列表&quot;}" Tag="List:true" Click="AddMenuItem_Click"/>
            <MenuItem Header="{loc:Loc &quot;列表&quot;}" Tag="List:false" Click="AddMenuItem_Click"/>
            <MenuItem Header="{loc:Loc &quot;子任务&quot;}" Tag="SubTask" Click="AddMenuItem_Click"/>
        </ContextMenu>

        <!-- 区块行：拖拽手柄 / 勾选 / 类型徽章 / 编辑区 / 操作按钮 -->
        <DataTemplate x:Key="BlockRowTemplate">
            <StackPanel>
                <Border x:Name="RowBorder"
                        AllowDrop="True"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="{DynamicResource UiBorderThickness}"
                        CornerRadius="{DynamicResource UiCornerRadiusSmall}"
                        Padding="6,5" Margin="0,0,0,4"
                        PreviewDragOver="Row_PreviewDragOver"
                        PreviewDrop="Row_PreviewDrop">
                    <DockPanel>
                        <Border x:Name="TopLine" DockPanel.Dock="Top" Height="2" Margin="0,0,0,3"
                                Background="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                        <Border x:Name="BottomLine" DockPanel.Dock="Bottom" Height="2" Margin="0,3,0,0"
                                Background="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 拖拽手柄 -->
                            <TextBlock Grid.Column="0"
                                       Text="⣿"
                                       FontSize="11" Opacity="0.45"
                                       Cursor="SizeAll"
                                       VerticalAlignment="Top"
                                       Margin="0,3,6,0"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       ToolTip="{loc:Loc &quot;拖拽排序&quot;}"
                                       PreviewMouseLeftButtonDown="Handle_PreviewMouseLeftButtonDown"
                                       PreviewMouseMove="Handle_PreviewMouseMove"/>

                            <!-- 类型徽章 -->
                            <Border Grid.Column="2"
                                    CornerRadius="3" Padding="6,2"
                                    VerticalAlignment="Top"
                                    Margin="0,1,8,0"
                                    Background="{DynamicResource SubtleBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="{DynamicResource UiBorderThickness}">
                                <TextBlock Text="{Binding KindLabel}"
                                           FontSize="10" Opacity="0.75"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </Border>

                            <!-- 编辑区 -->
                            <Grid Grid.Column="3">
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DialogTextBox}"
                                         FontSize="12"
                                         MinHeight="46"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         ToolTip="{loc:Loc &quot;支持 # 标题、**粗体**、*斜体*、~~删除线~~、编号列表与列表&quot;}"
                                         Visibility="{Binding ShowTextEditor, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{loc:Loc &quot;一条分割线&quot;}"
                                           FontSize="11" Opacity="0.5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Visibility="{Binding ShowDividerLabel, Converter={StaticResource BoolToVis}}"/>

                                <StackPanel Visibility="{Binding ShowTableEditor, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Loc &quot;表头（用 | 分隔各列）&quot;}"
                                               FontSize="10" Opacity="0.55" Margin="0,0,0,2"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox Text="{Binding HeadersText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DialogTextBox}" FontSize="11" Padding="4,2"
                                             Margin="0,0,0,4"/>
                                    <TextBlock Text="{loc:Loc &quot;数据行（每行一条，用 | 分隔各列）&quot;}"
                                               FontSize="10" Opacity="0.55" Margin="0,0,0,2"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox Text="{Binding RowsText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DialogTextBox}" FontSize="11" Padding="4,2"
                                             MinHeight="46" AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ShowCodeEditor, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{loc:Loc &quot;语言&quot;}"
                                                   FontSize="10" Opacity="0.55"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DialogTextBox}" FontSize="11" Padding="4,2"
                                                 Width="110"/>
                                        <CheckBox Content="{loc:Loc &quot;行号&quot;}"
                                                  Style="{StaticResource SettingsCheckBox}"
                                                  IsChecked="{Binding ShowLineNumbers, UpdateSourceTrigger=PropertyChanged}"
                                                  FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DialogTextBox}"
                                             FontFamily="Consolas" FontSize="11" Padding="4,2"
                                             MinHeight="52" AcceptsReturn="True" AcceptsTab="True"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ShowFileEditor, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DialogTextBox}" FontSize="11" Padding="4,2"
                                             Margin="0,0,0,4"
                                             ToolTip="{loc:Loc &quot;文件的完整路径&quot;}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Function, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DialogTextBox}" FontSize="11" Padding="4,2"
                                                 Margin="0,0,6,0"
                                                 ToolTip="{loc:Loc &quot;命名空间.类.方法&quot;}"/>
                                        <TextBlock Grid.Column="1" Text="{loc:Loc &quot;行&quot;}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Line, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DialogTextBox}" FontSize="11" Padding="4,2"
                                                 Width="44" TextAlignment="Right" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="3" Text="{loc:Loc &quot;列&quot;}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBox Grid.Column="4"
                                                 Text="{Binding Column, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DialogTextBox}" FontSize="11" Padding="4,2"
                                                 Width="44" TextAlignment="Right"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding ShowListEditor, Converter={StaticResource BoolToVis}}">
                                    <CheckBox Content="{loc:Loc &quot;编号列表&quot;}"
                                              Style="{StaticResource SettingsCheckBox}"
                                              IsChecked="{Binding Ordered, UpdateSourceTrigger=PropertyChanged}"
                                              FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc &quot;条目就是它的子块，子块里再放列表即为多级列表&quot;}"
                                               FontSize="10" Opacity="0.55"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>

                                <!-- 子任务：一个勾选框 + 一个文本框，勾选状态计入完成度 -->
                                <Grid Visibility="{Binding ShowSubTaskEditor, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Style="{StaticResource SettingsCheckBox}"
                                              IsChecked="{Binding Done, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Top"
                                              Margin="0,3,6,0"
                                              ToolTip="{loc:Loc &quot;勾选表示该子任务已完成&quot;}"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DialogTextBox}"
                                             FontSize="12"
                                             MinHeight="34"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"
                                             ToolTip="{loc:Loc &quot;支持 # 标题、**粗体**、*斜体*、~~删除线~~、编号列表与列表&quot;}"/>
                                </Grid>
                            </Grid>

                            <!-- 操作按钮 -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                        VerticalAlignment="Top" Margin="4,0,0,0">
                                <Button Content="＋"
                                        Style="{StaticResource CardActionBtn}"
                                        ContextMenu="{StaticResource AddBlockMenu}"
                                        Click="AddChild_Click"
                                        Width="22" Height="20" Padding="0" FontSize="12"
                                        ToolTip="{loc:Loc &quot;添加子块&quot;}"/>
                                <Button Content="↑" Click="MoveUp_Click"
                                        Style="{StaticResource CardActionBtn}"
                                        Width="20" Height="20" Padding="0" FontSize="12"
                                        ToolTip="{loc:Loc &quot;上移&quot;}"/>
                                <Button Content="↓" Click="MoveDown_Click"
                                        Style="{StaticResource CardActionBtn}"
                                        Width="20" Height="20" Padding="0" FontSize="12"
                                        ToolTip="{loc:Loc &quot;下移&quot;}"/>
                                <Button Content="✕" Click="Remove_Click"
                                        Style="{StaticResource CardActionBtn}"
                                        Width="20" Height="20" Padding="0" FontSize="12"
                                        Foreground="#E86A6A"
                                        ToolTip="{loc:Loc &quot;删除&quot;}"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 子块：列表容器的子块即条目 -->
                <ItemsControl ItemsSource="{Binding Children}"
                              ItemTemplate="{DynamicResource BlockRowTemplate}"
                              Margin="18,0,0,0"/>
            </StackPanel>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DropBefore}" Value="True">
                    <Setter TargetName="TopLine" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DropAfter}" Value="True">
                    <Setter TargetName="BottomLine" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <ItemsControl x:Name="RootList" ItemTemplate="{DynamicResource BlockRowTemplate}"/>

        <TextBlock x:Name="EmptyHint"
                   Text="{loc:Loc &quot;内容区为空。用下面的按钮添加区块。&quot;}"
                   FontSize="11" Opacity="0.5" Margin="2,2,0,6"
                   Foreground="{DynamicResource ForegroundBrush}"/>

        <Button Content="{loc:Loc &quot;＋ 添加区块&quot;}"
                ContextMenu="{StaticResource AddBlockMenu}"
                Click="AddRoot_Click"
                HorizontalAlignment="Left"
                Style="{StaticResource DialogConfirmButton}"
                Height="26" FontSize="11" FontWeight="Normal" Padding="10,0"/>
    </StackPanel>
</UserControl>
