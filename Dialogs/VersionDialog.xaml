<UserControl x:Class="OCCMissionGoals.Dialogs.VersionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:loc="clr-namespace:OCCMissionGoals"
             Width="400">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 版本列表容器样式 -->
        <Style x:Key="VersionListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Padding="{TemplateBinding Padding}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource PressedBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 版本列表项样式 -->
        <Style x:Key="VersionListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Grid Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,10"
                    Margin="0,0,0,12">
                <TextBlock Text="{loc:Loc &quot;版本管理&quot;}"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- 内容区域 -->
            <StackPanel Grid.Row="1">
                <!-- 模式切换 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="NewModeBtn" Content="{loc:Loc &quot;新建版本&quot;}" GroupName="Mode"
                                 Style="{StaticResource ConsoleTabRadioButton}" Margin="0,0,12,0"
                                 Checked="NewModeBtn_Checked"/>
                    <RadioButton x:Name="OpenModeBtn" Content="{loc:Loc &quot;打开版本&quot;}" GroupName="Mode"
                                 Checked="OpenModeBtn_Checked"
                                 Style="{StaticResource ConsoleTabRadioButton}"/>
                    <RadioButton x:Name="DeleteModeBtn" Content="{loc:Loc &quot;删除版本&quot;}" GroupName="Mode"
                                 Checked="DeleteModeBtn_Checked"
                                 Style="{StaticResource ConsoleTabRadioButton}"/>
                </StackPanel>

                <!-- 新建模式 -->
                <StackPanel x:Name="NewPanel" Visibility="Visible">
                    <TextBlock Text="{loc:Loc &quot;版本号&quot;}" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="VersionNameBox" Text="0.2.0-alpha.0"
                             Style="{StaticResource DialogTextBox}"
                             Margin="0,0,0,10"/>
                    <TextBlock x:Name="NewHint" Text=""
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="11" Margin="0,0,0,8"/>
                </StackPanel>

                <!-- 打开模式 -->
                <StackPanel x:Name="OpenPanel" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc &quot;选择版本文件&quot;}" Style="{StaticResource DialogLabel}"/>
                    <ListBox x:Name="VersionListBox" MaxHeight="160"
                             Style="{StaticResource VersionListBoxStyle}"
                             ItemContainerStyle="{StaticResource VersionListBoxItemStyle}"
                             Margin="0,0,0,10"/>
                    <TextBlock x:Name="OpenHint" Text=""
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="11" Margin="0,0,0,8"/>
                </StackPanel>

                <!-- 删除模式 -->
                <StackPanel x:Name="DeletePanel" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc &quot;选择要删除的版本&quot;}" Style="{StaticResource DialogLabel}"/>
                    <ListBox x:Name="DeleteVersionListBox" MaxHeight="160"
                             Style="{StaticResource VersionListBoxStyle}"
                             ItemContainerStyle="{StaticResource VersionListBoxItemStyle}"
                             Margin="0,0,0,10"/>
                    <TextBlock x:Name="DeleteHint" Text=""
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="11" Margin="0,0,0,8"/>
                </StackPanel>
            </StackPanel>

            <!-- 底部按钮 -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,14,0,0"
                    Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="{loc:Loc &quot;取消&quot;}"
                            Click="CancelBtn_Click"
                            Style="{StaticResource DialogCancelButton}"
                            Margin="0,0,10,0"/>
                    <Button x:Name="ConfirmBtn" Content="{loc:Loc &quot;确定&quot;}"
                            Click="ConfirmBtn_Click"
                            Style="{StaticResource DialogConfirmButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
