<UserControl x:Class="OCCMissionGoals.Dialogs.NewProjectDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OCCMissionGoals.Dialogs"
             mc:Ignorable="d" 
             d:DesignHeight="580" d:DesignWidth="650">

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="8">

        <Grid Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,10"
                    Margin="0,0,0,12">
                <Grid>
                    <TextBlock x:Name="DialogTitle" Text="新建项目"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 表单区域 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <!-- 项目名称 -->
                    <TextBlock Text="项目名称" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="ProjectNameTextBox"
                             Style="{StaticResource DialogTextBox}"
                             Margin="0,0,0,14"/>

                    <!-- 项目描述 -->
                    <TextBlock Text="项目描述" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="DescriptionTextBox"
                             Style="{StaticResource DialogTextBox}"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Margin="0,0,0,14"/>

                    <!-- 初始版本 -->
                    <TextBlock Text="初始版本" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="VersionTextBox"
                             Style="{StaticResource DialogTextBox}"
                             Text="0.1.0-alpha.0"
                             Margin="0,0,0,14"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,14,0,0"
                    Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="取消"
                            Click="CancelButton_Click"
                            Style="{StaticResource DialogCancelButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="确认"
                            Click="ConfirmButton_Click"
                            Style="{StaticResource DialogConfirmButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
