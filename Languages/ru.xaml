<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!-- Русский (ru) -->
    <s:String x:Key="__lang_code">ru</s:String>
    <s:String x:Key="__lang_name">Русский</s:String>
    <s:String xml:space="preserve" x:Key="      例如: 0.1.0-alpha.0">      например 0.1.0-alpha.0</s:String>
    <s:String xml:space="preserve" x:Key="# 归档 — {0}"># Архив — {0}</s:String>
    <s:String xml:space="preserve" x:Key="-a 数据格式示例">-a пример формата данных</s:String>
    <s:String xml:space="preserve" x:Key="-v &lt;版本号&gt;">-v &lt;версия&gt;</s:String>
    <s:String xml:space="preserve" x:Key="-v Archive &lt;版本&gt;">-v Archive &lt;версия&gt;</s:String>
    <s:String xml:space="preserve" x:Key="-v Delete &lt;版本&gt;">-v Delete &lt;версия&gt;</s:String>
    <s:String xml:space="preserve" x:Key="&gt; 导出时间: {0:yyyy-MM-dd HH:mm:ss}">&gt; Экспортировано: {0:yyyy-MM-dd HH:mm:ss}</s:String>
    <s:String xml:space="preserve" x:Key="&gt; 条目数量: {0}">&gt; Количество записей: {0}</s:String>
    <s:String xml:space="preserve" x:Key="CLI 命令行模式">Режим CLI</s:String>
    <s:String xml:space="preserve" x:Key="Confirmed 事件未绑定，请通过菜单「项目」打开此弹窗。">Событие Confirmed не привязано. Откройте это окно через меню «Проект».</s:String>
    <s:String xml:space="preserve" x:Key="Date: 日期">Date: Дата</s:String>
    <s:String xml:space="preserve" x:Key="Expand: 已安装">Expand: Установленные</s:String>
    <s:String xml:space="preserve" x:Key="File: 文件">File: Файл</s:String>
    <s:String xml:space="preserve" x:Key="Function: 功能">Function: Функция</s:String>
    <s:String xml:space="preserve" x:Key="GitHub 推送配置">Настройки отправки в GitHub</s:String>
    <s:String xml:space="preserve" x:Key="GitHub 集成">Интеграция с GitHub</s:String>
    <s:String xml:space="preserve" x:Key="Github设置">Настройки GitHub</s:String>
    <s:String xml:space="preserve" x:Key="OCC's Mission &amp; Goals 是一款面向开发者和项目维护者的轻量级任务跟踪工具。以「条目（Mission）」为基本单位，每一条目记录一个独立的目标任务，支持严重程度分级、截止日期、版本归属、关联文件追踪以及多项目切换。">OCC's Mission &amp; Goals — это лёгкий инструмент отслеживания задач для разработчиков и сопровождающих проектов. Основной единицей является запись (Mission); каждая запись описывает одну самостоятельную цель и поддерживает уровни важности, сроки, привязку к версии, отслеживание связанных файлов и переключение между несколькими проектами.</s:String>
    <s:String xml:space="preserve" x:Key="OCCMissionGoals.exe [-p &lt;项目&gt;] &lt;命令&gt; [参数]">OCCMissionGoals.exe [-p &lt;проект&gt;] &lt;команда&gt; [аргументы]</s:String>
    <s:String xml:space="preserve" x:Key="OCCMissionGoals.exe 命令行接口">Интерфейс командной строки OCCMissionGoals.exe</s:String>
    <s:String xml:space="preserve" x:Key="Plugins: 插件">Plugins: Плагины</s:String>
    <s:String xml:space="preserve" x:Key="Plugins: 搜索扩展中心全部插件，Expand: 只搜索已安装插件。两者都不筛选条目列表，结果在搜索板中展示，关键词为空时列出全部对应插件；点击结果跳转到扩展中心。">Plugins: ищет все плагины в центре расширений; Expand: ищет только установленные плагины. Ни один из них не фильтрует список записей — результаты появляются на панели, при пустом ключевом слове перечисляются все подходящие плагины; нажмите на результат, чтобы перейти в центр расширений.</s:String>
    <s:String xml:space="preserve" x:Key="Setting: 模式不会筛选条目列表，而是在结果板中列出设置快捷项，且关键词为空时也会显示全部设置项。点击即可直接执行：切换深/浅色主题、打开项目设置、打开推送设置。">Режим Setting: не фильтрует список записей; вместо этого он показывает ярлыки настроек на панели результатов, причём показывает их все даже при пустом ключевом слове. Нажмите, чтобы выполнить напрямую: переключить тёмную/светлую тему, открыть настройки проекта или открыть настройки отправки.</s:String>
    <s:String xml:space="preserve" x:Key="Setting: 设置">Setting: Настройки</s:String>
    <s:String xml:space="preserve" x:Key="Tag: 标签">Tag: Тег</s:String>
    <s:String xml:space="preserve" x:Key="Text: 文字">Text: Текст</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}个月前">{0} мес. назад</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}分钟前">{0} мин. назад</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}天">{0} дн.</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}天前">{0} дн. назад</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}小时前">{0} ч. назад</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}年前">{0} г. назад</s:String>
    <s:String xml:space="preserve" x:Key="| 严重程度 | {0} |">| Важность | {0} |</s:String>
    <s:String xml:space="preserve" x:Key="| 字段 | 内容 |">| Поле | Содержимое |</s:String>
    <s:String xml:space="preserve" x:Key="| 完成时间 | {0:yyyy-MM-dd} |">| Завершено | {0:yyyy-MM-dd} |</s:String>
    <s:String xml:space="preserve" x:Key="| 截止日期 | {0:yyyy-MM-dd} |">| Срок | {0:yyyy-MM-dd} |</s:String>
    <s:String xml:space="preserve" x:Key="| 相关文件 | (无) |">| Связанные файлы | (нет) |</s:String>
    <s:String xml:space="preserve" x:Key="| 相关文件 | {0} |">| Связанные файлы | {0} |</s:String>
    <s:String xml:space="preserve" x:Key="| 详细信息 | {0} |">| Подробности | {0} |</s:String>
    <s:String xml:space="preserve" x:Key="• data.json —— 存储所有条目数据（未完成 + 已完成），JSON 数组格式">• data.json — хранит все данные записей (незавершённые + завершённые) в виде массива JSON</s:String>
    <s:String xml:space="preserve" x:Key="• Date: / 日期: —— 日期（yyyy-MM-dd）">• Date: — дата (yyyy-MM-dd)</s:String>
    <s:String xml:space="preserve" x:Key="• Expand: / 扩展: / 已安装: —— 已安装的插件（全局搜索）">• Expand: — установленные плагины (глобальный поиск)</s:String>
    <s:String xml:space="preserve" x:Key="• File: / 文件: —— 关联文件路径与函数名">• File: — путь к связанному файлу и имя функции</s:String>
    <s:String xml:space="preserve" x:Key="• Plugins: / 插件: —— 扩展中心插件（全局搜索）">• Plugins: — плагины центра расширений (глобальный поиск)</s:String>
    <s:String xml:space="preserve" x:Key="• project.json —— 存储项目元数据：项目名称、类型标签定义、版本号等">• project.json — хранит метаданные проекта: название проекта, определения тегов типа, номер версии и т. д.</s:String>
    <s:String xml:space="preserve" x:Key="• Setting: / 设置: / 配置: —— 设置（全局搜索）">• Setting: / settings: — настройки (глобальный поиск)</s:String>
    <s:String xml:space="preserve" x:Key="• Tag: / 标签: —— 类型标签">• Tag: — теги типа</s:String>
    <s:String xml:space="preserve" x:Key="• Text: / 文字: —— 标题、简要、详情">• Text: — заголовок, краткое описание, подробности</s:String>
    <s:String xml:space="preserve" x:Key="• 典型用法：0 = 无变更 / 1-3 = 小范围调整 / 4-6 = 中等重构 / 7+ = 大规模变更">• Типичное использование: 0 = без изменений / 1–3 = небольшие правки / 4–6 = средний рефакторинг / 7+ = крупное изменение</s:String>
    <s:String xml:space="preserve" x:Key="• 分类浏览 —— 按插件类别分组展示可用扩展">• Просмотр по категориям — доступные расширения сгруппированы и показаны по категориям</s:String>
    <s:String xml:space="preserve" x:Key="• 删除 —— 移除已完成条目">• Удаление — удалить завершённую запись</s:String>
    <s:String xml:space="preserve" x:Key="• 删除条目 —— 移除不需要的条目（不可恢复）">• Удалить запись — удалите ненужную запись (безвозвратно)</s:String>
    <s:String xml:space="preserve" x:Key="• 在仪表盘底部可编辑当前版本号，修改后新条目将归属新版本">• Измените текущую версию внизу панели управления; после изменения новые записи будут относиться к новой версии</s:String>
    <s:String xml:space="preserve" x:Key="• 安装 / 卸载 —— 一键安装或卸载扩展插件">• Установка / удаление — установите или удалите расширение в один клик</s:String>
    <s:String xml:space="preserve" x:Key="• 完成日期 —— 每条目卡片额外显示「完成于」日期信息">• Дата завершения — каждая карточка записи также показывает дату завершения</s:String>
    <s:String xml:space="preserve" x:Key="• 完成条目 —— 将条目标记为已完成，自动记录完成时间，条目从本页移至已完成页面">• Завершить запись — отметьте запись как завершённую, время завершения запишется автоматически, и запись переместится на страницу «Завершённые»</s:String>
    <s:String xml:space="preserve" x:Key="• 导航栏      仪表盘 / 未完成条目 / 已完成条目 / 扩展中心 / 帮助">• Навигация      Панель управления / Незавершённые / Завершённые / Расширения / Справка</s:String>
    <s:String xml:space="preserve" x:Key="• 展开详情 —— 点击「详情」按钮展开条目完整信息面板，包括详细描述和关联文件表格">• Развернуть подробности — нажмите кнопку «Подробнее», чтобы развернуть полную панель информации, включая описание и таблицу связанных файлов</s:String>
    <s:String xml:space="preserve" x:Key="• 工具栏      按住 Ctrl 显示：新建条目 / 搜索 / 排序 / 推送 / CLI 等快捷操作">• Панель инструментов      Удерживайте Ctrl, чтобы показать: Новая запись / Поиск / Сортировка / Отправка / CLI</s:String>
    <s:String xml:space="preserve" x:Key="• 已完成条目在版本内全部完成后才可归档，保持视图整洁">• Завершённые записи можно архивировать только после завершения всей версии, чтобы список оставался аккуратным</s:String>
    <s:String xml:space="preserve" x:Key="• 常见标签：bug（缺陷）、feature（新功能）、refactor（重构）、docs（文档）、test（测试）、chore（杂项）">• Распространённые теги: bug, feature, refactor, docs, test, chore</s:String>
    <s:String xml:space="preserve" x:Key="• 按版本归档 —— 仅当版本内所有条目均已完成时，才显示归档按钮。归档将导出 Markdown 并删除版本数据文件">• Архивация по версии — кнопка архивации появляется только тогда, когда все записи версии завершены. Архивация экспортирует Markdown и удаляет файл данных версии</s:String>
    <s:String xml:space="preserve" x:Key="• 排序 —— 按严重程度（高→低）、截止日期（近→远）、版本号（升/降）以及仅收藏排序">• Сортировка — по важности (высокая→низкая), по сроку (ближайший→дальний), по версии (возр./убыв.) или только избранное</s:String>
    <s:String xml:space="preserve" x:Key="• 搜索过滤 —— 顶部搜索框实时过滤插件列表">• Поиск и фильтр — верхнее поле поиска фильтрует список плагинов в реальном времени</s:String>
    <s:String xml:space="preserve" x:Key="• 搜索过滤 —— 顶部搜索框输入关键词实时过滤，支持前缀切换匹配范围：Text:内容、Tag:标签、Setting:设置（项目设置/主题/推送）、File:文件路径、Date:日期；不带前缀时按文字匹配，Setting: 下按回车执行设置项">• Поиск и фильтр — вводите ключевые слова в верхнее поле поиска для фильтрации в реальном времени; префиксы переключают область поиска: Text: содержимое, Tag: теги, Setting: настройки (проект/тема/отправка), File: путь к файлу, Date: дата; без префикса поиск идёт по тексту, а в режиме Setting: нажмите Enter, чтобы выполнить настройку</s:String>
    <s:String xml:space="preserve" x:Key="• 撤销完成 —— 将已完成条目恢复为未完成状态，条目移回 UnDonePage">• Отменить завершение — вернуть завершённую запись в статус незавершённой, переместив её обратно на UnDonePage</s:String>
    <s:String xml:space="preserve" x:Key="• 支持按变更需求升序或降序排列条目列表">• Записи можно сортировать по требованию изменений по возрастанию или убыванию</s:String>
    <s:String xml:space="preserve" x:Key="• 收藏加星 —— 点击星标按钮收藏条目，收藏的条目在列表中高亮显示">• Избранное — нажмите кнопку со звездой, чтобы добавить запись в избранное; избранные записи подсвечиваются в списке</s:String>
    <s:String xml:space="preserve" x:Key="• 数值越大表示变更越复杂、影响范围越广">• Чем больше значение, тем сложнее и масштабнее изменение</s:String>
    <s:String xml:space="preserve" x:Key="• 数据存储    所有条目以 JSON 格式保存在各项目目录下">• Хранилище      Все записи сохраняются в формате JSON в каталоге каждого проекта</s:String>
    <s:String xml:space="preserve" x:Key="• 整体结构与未完成页面一致 —— 版本分组、搜索过滤、详情展开等">• Та же общая структура, что и на странице «Незавершённые» — группировка по версиям, поиск и фильтр, развёртывание подробностей и т. д.</s:String>
    <s:String xml:space="preserve" x:Key="• 文件均为纯文本 JSON，可直接用 Git 进行版本追踪和团队协作">• Все файлы — обычный текстовый JSON, поэтому их можно отслеживать в Git и использовать для совместной работы команды</s:String>
    <s:String xml:space="preserve" x:Key="• 条目列表按版本号分组展示，支持折叠和展开各版本">• Список записей сгруппирован по версиям, каждую версию можно свернуть/развернуть</s:String>
    <s:String xml:space="preserve" x:Key="• 条目字段：index, id, title, severity, severityLabel, brief, detail, deadline, completedAt, changeDemand, isFavorited, version, relatedFiles">• Поля записи: index, id, title, severity, severityLabel, brief, detail, deadline, completedAt, changeDemand, isFavorited, version, relatedFiles</s:String>
    <s:String xml:space="preserve" x:Key="• 条目结果带类型标签（未完成 / 已完成），点击「跳转」定位到对应条目。">• Результаты записей показывают метку типа (Незавершённые / Завершённые); нажмите «Перейти», чтобы найти запись.</s:String>
    <s:String xml:space="preserve" x:Key="• 正常输出 JSON（stdout），带缩进便于阅读">• Обычный вывод — JSON (stdout) с отступами для читаемости</s:String>
    <s:String xml:space="preserve" x:Key="• 每个条目可附带一个或多个类型标签（多选）">• Каждая запись может иметь один или несколько тегов типа (множественный выбор)</s:String>
    <s:String xml:space="preserve" x:Key="• 每个条目归属于一个版本，创建时自动设为当前版本">• Каждая запись относится к версии и при создании получает текущую версию</s:String>
    <s:String xml:space="preserve" x:Key="• 点击「迭代标签」按钮自动将迭代编号 +1（如 alpha.0 → alpha.1）">• Нажмите кнопку «Итерация», чтобы увеличить номер итерации на 1 (например alpha.0 → alpha.1)</s:String>
    <s:String xml:space="preserve" x:Key="• 点击搜索框外部关闭结果板。">• Нажмите вне поля поиска, чтобы закрыть панель результатов.</s:String>
    <s:String xml:space="preserve" x:Key="• 版本分组折叠 —— 条目按版本号分组，每组可折叠 / 展开，标题显示版本名和条目数">• Группировка по версиям — записи группируются по версии; каждую группу можно свернуть/развернуть, а в заголовке показаны имя версии и количество записей</s:String>
    <s:String xml:space="preserve" x:Key="• 状态栏      项目切换下拉框">• Строка состояния      Выпадающий список переключения проекта</s:String>
    <s:String xml:space="preserve" x:Key="• 空输入时显示「按模式搜索」引导，点击前缀按钮可快速填入前缀。">• При пустом вводе появляется подсказка поиска по режиму; нажмите на чип префикса, чтобы подставить его.</s:String>
    <s:String xml:space="preserve" x:Key="• 类型标签在条目卡片上以标签形式展示，便于快速识别">• Теги типа отображаются как метки на карточках записей для быстрой идентификации</s:String>
    <s:String xml:space="preserve" x:Key="• 类型标签在项目配置（project.json）中统一定义和管理">• Теги типа определяются и управляются централизованно в конфигурации проекта (project.json)</s:String>
    <s:String xml:space="preserve" x:Key="• 编辑 —— 与未完成页面相同的编辑功能">• Изменение — то же редактирование, что и на странице «Незавершённые»</s:String>
    <s:String xml:space="preserve" x:Key="• 编辑条目 —— 点击编辑按钮打开编辑窗口，可修改所有字段：标题、简要、详情、严重程度、截止日期、变更需求、类型标签、关联文件">• Изменить запись — нажмите кнопку изменения, чтобы открыть редактор и изменить все поля: заголовок, краткое описание, подробности, важность, срок, требование изменений, теги типа, связанные файлы</s:String>
    <s:String xml:space="preserve" x:Key="• 编辑条目时在编辑窗口勾选或取消类型标签">• Отмечайте или снимайте теги типа в редакторе при изменении записи</s:String>
    <s:String xml:space="preserve" x:Key="• 编辑条目时在编辑窗口设置">• Задаётся в редакторе при изменении записи</s:String>
    <s:String xml:space="preserve" x:Key="• 详情查看 —— 点击插件卡片查看功能说明和使用方式">• Просмотр подробностей — нажмите на карточку плагина, чтобы увидеть описание и способ использования</s:String>
    <s:String xml:space="preserve" x:Key="• 返回码：0 = 成功，非 0 = 失败">• Код возврата: 0 = успех, не 0 = ошибка</s:String>
