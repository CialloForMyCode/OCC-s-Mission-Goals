    <s:String xml:space="preserve" x:Key="匿名开发者">Anonymous developer</s:String>
    <s:String xml:space="preserve" x:Key="保存">Save</s:String>
    <s:String xml:space="preserve" x:Key="保存项目信息">Save Project Info</s:String>
    <s:String xml:space="preserve" x:Key="保存项目设置失败：{0}">Failed to save project settings: {0}</s:String>
