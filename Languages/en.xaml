    <s:String xml:space="preserve" x:Key="{}{0}天">{0}d</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}天前">{0} d ago</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}小时前">{0} h ago</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}年前">{0} y ago</s:String>
