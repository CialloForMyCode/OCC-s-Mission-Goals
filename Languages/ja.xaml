<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!-- 日本語 (ja) -->
    <s:String x:Key="__lang_code">ja</s:String>
    <s:String x:Key="__lang_name">日本語</s:String>
    <s:String xml:space="preserve" x:Key="      例如: 0.1.0-alpha.0">      例: 0.1.0-alpha.0</s:String>
    <s:String xml:space="preserve" x:Key="# 归档 — {0}"># アーカイブ — {0}</s:String>
    <s:String xml:space="preserve" x:Key="-a 数据格式示例">-a データ形式の例</s:String>
    <s:String xml:space="preserve" x:Key="-v &lt;版本号&gt;">-v &lt;バージョン番号&gt;</s:String>
    <s:String xml:space="preserve" x:Key="-v Archive &lt;版本&gt;">-v Archive &lt;バージョン&gt;</s:String>
    <s:String xml:space="preserve" x:Key="-v Delete &lt;版本&gt;">-v Delete &lt;バージョン&gt;</s:String>
    <s:String xml:space="preserve" x:Key="&gt; 导出时间: {0:yyyy-MM-dd HH:mm:ss}">&gt; エクスポート時刻: {0:yyyy-MM-dd HH:mm:ss}</s:String>
    <s:String xml:space="preserve" x:Key="&gt; 条目数量: {0}">&gt; エントリ数: {0}</s:String>
    <s:String xml:space="preserve" x:Key="CLI 命令行模式">CLI コマンドラインモード</s:String>
    <s:String xml:space="preserve" x:Key="Confirmed 事件未绑定，请通过菜单「项目」打开此弹窗。">Confirmed イベントがバインドされていません。「プロジェクト」メニューからこのダイアログを開いてください。</s:String>
    <s:String xml:space="preserve" x:Key="Date: 日期">Date: 日付</s:String>
    <s:String xml:space="preserve" x:Key="Expand: 已安装">Expand: インストール済み</s:String>
    <s:String xml:space="preserve" x:Key="File: 文件">File: ファイル</s:String>
    <s:String xml:space="preserve" x:Key="Function: 功能">Function: 機能</s:String>
    <s:String xml:space="preserve" x:Key="GitHub 推送配置">GitHub プッシュ設定</s:String>
    <s:String xml:space="preserve" x:Key="GitHub 集成">GitHub 連携</s:String>
    <s:String xml:space="preserve" x:Key="Github设置">GitHub設定</s:String>
    <s:String xml:space="preserve" x:Key="OCC's Mission &amp; Goals 是一款面向开发者和项目维护者的轻量级任务跟踪工具。以「条目（Mission）」为基本单位，每一条目记录一个独立的目标任务，支持严重程度分级、截止日期、版本归属、关联文件追踪以及多项目切换。">OCC's Mission &amp; Goals は、開発者やプロジェクトメンテナ向けの軽量タスク追跡ツールです。「エントリ（Mission）」を基本単位とし、各エントリが独立した目標タスクを記録します。重要度の段階分け、期限、バージョン所属、関連ファイル追跡、複数プロジェクトの切り替えに対応しています。</s:String>
    <s:String xml:space="preserve" x:Key="OCCMissionGoals.exe [-p &lt;项目&gt;] &lt;命令&gt; [参数]">OCCMissionGoals.exe [-p &lt;プロジェクト&gt;] &lt;コマンド&gt; [引数]</s:String>
    <s:String xml:space="preserve" x:Key="OCCMissionGoals.exe 命令行接口">OCCMissionGoals.exe コマンドラインインターフェース</s:String>
    <s:String xml:space="preserve" x:Key="Plugins: 插件">Plugins: プラグイン</s:String>
    <s:String xml:space="preserve" x:Key="Plugins: 搜索扩展中心全部插件，Expand: 只搜索已安装插件。两者都不筛选条目列表，结果在搜索板中展示，关键词为空时列出全部对应插件；点击结果跳转到扩展中心。">Plugins: 拡張センターの全プラグインを検索、Expand: インストール済みプラグインのみ検索。どちらもエントリ一覧は絞り込まず、結果は検索ボードに表示されます。キーワードが空の場合は該当する全プラグインを一覧表示し、結果をクリックすると拡張センターへ移動します。</s:String>
    <s:String xml:space="preserve" x:Key="Setting: 模式不会筛选条目列表，而是在结果板中列出设置快捷项，且关键词为空时也会显示全部设置项。点击即可直接执行：切换深/浅色主题、打开项目设置、打开推送设置。">Setting: モードはエントリ一覧を絞り込まず、結果ボードに設定のショートカット項目を一覧表示します。キーワードが空でも全設定項目を表示します。クリックすると直接実行できます：ダーク/ライトテーマの切り替え、プロジェクト設定を開く、プッシュ設定を開く。</s:String>
    <s:String xml:space="preserve" x:Key="Setting: 设置">Setting: 設定</s:String>
    <s:String xml:space="preserve" x:Key="Tag: 标签">Tag: タグ</s:String>
    <s:String xml:space="preserve" x:Key="Text: 文字">Text: テキスト</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}个月前">{0}か月前</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}分钟前">{0}分前</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}天">{0}日</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}天前">{0}日前</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}小时前">{0}時間前</s:String>
    <s:String xml:space="preserve" x:Key="{}{0}年前">{0}年前</s:String>
    <s:String xml:space="preserve" x:Key="| 严重程度 | {0} |">| 重要度 | {0} |</s:String>
    <s:String xml:space="preserve" x:Key="| 字段 | 内容 |">| フィールド | 内容 |</s:String>
    <s:String xml:space="preserve" x:Key="| 完成时间 | {0:yyyy-MM-dd} |">| 完了時刻 | {0:yyyy-MM-dd} |</s:String>
    <s:String xml:space="preserve" x:Key="| 截止日期 | {0:yyyy-MM-dd} |">| 期限 | {0:yyyy-MM-dd} |</s:String>
    <s:String xml:space="preserve" x:Key="| 相关文件 | (无) |">| 関連ファイル | (なし) |</s:String>
    <s:String xml:space="preserve" x:Key="| 相关文件 | {0} |">| 関連ファイル | {0} |</s:String>
    <s:String xml:space="preserve" x:Key="| 详细信息 | {0} |">| 詳細情報 | {0} |</s:String>
    <s:String xml:space="preserve" x:Key="• data.json —— 存储所有条目数据（未完成 + 已完成），JSON 数组格式">• data.json —— 全エントリデータ（未完了 + 完了）を保存、JSON 配列形式</s:String>
    <s:String xml:space="preserve" x:Key="• Date: / 日期: —— 日期（yyyy-MM-dd）">• Date: / 日付: —— 日付（yyyy-MM-dd）</s:String>
    <s:String xml:space="preserve" x:Key="• Expand: / 扩展: / 已安装: —— 已安装的插件（全局搜索）">• Expand: / 拡張: / インストール済み: —— インストール済みプラグイン（グローバル検索）</s:String>
    <s:String xml:space="preserve" x:Key="• File: / 文件: —— 关联文件路径与函数名">• File: / ファイル: —— 関連ファイルのパスと関数名</s:String>
    <s:String xml:space="preserve" x:Key="• Plugins: / 插件: —— 扩展中心插件（全局搜索）">• Plugins: / プラグイン: —— 拡張センタープラグイン（グローバル検索）</s:String>
    <s:String xml:space="preserve" x:Key="• project.json —— 存储项目元数据：项目名称、类型标签定义、版本号等">• project.json —— プロジェクトメタデータを保存：プロジェクト名、タイプタグ定義、バージョン番号など</s:String>
    <s:String xml:space="preserve" x:Key="• Setting: / 设置: / 配置: —— 设置（全局搜索）">• Setting: / 設定: / 構成: —— 設定（グローバル検索）</s:String>
    <s:String xml:space="preserve" x:Key="• Tag: / 标签: —— 类型标签">• Tag: / タグ: —— タイプタグ</s:String>
    <s:String xml:space="preserve" x:Key="• Text: / 文字: —— 标题、简要、详情">• Text: / テキスト: —— タイトル、概要、詳細</s:String>
    <s:String xml:space="preserve" x:Key="• 典型用法：0 = 无变更 / 1-3 = 小范围调整 / 4-6 = 中等重构 / 7+ = 大规模变更">• 典型的な使い方：0 = 変更なし / 1-3 = 小規模な調整 / 4-6 = 中程度のリファクタリング / 7+ = 大規模な変更</s:String>
    <s:String xml:space="preserve" x:Key="• 分类浏览 —— 按插件类别分组展示可用扩展">• カテゴリ閲覧 —— プラグインのカテゴリごとに利用可能な拡張を表示</s:String>
    <s:String xml:space="preserve" x:Key="• 删除 —— 移除已完成条目">• 削除 —— 完了済みエントリを削除</s:String>
    <s:String xml:space="preserve" x:Key="• 删除条目 —— 移除不需要的条目（不可恢复）">• エントリの削除 —— 不要なエントリを削除（復元不可）</s:String>
    <s:String xml:space="preserve" x:Key="• 在仪表盘底部可编辑当前版本号，修改后新条目将归属新版本">• ダッシュボード下部で現在のバージョン番号を編集でき、変更後は新しいエントリが新バージョンに属します</s:String>
    <s:String xml:space="preserve" x:Key="• 安装 / 卸载 —— 一键安装或卸载扩展插件">• インストール / アンインストール —— ワンクリックで拡張プラグインを導入または削除</s:String>
    <s:String xml:space="preserve" x:Key="• 完成日期 —— 每条目卡片额外显示「完成于」日期信息">• 完了日 —— 各エントリカードに「完了日」の日付情報を追加表示</s:String>
    <s:String xml:space="preserve" x:Key="• 完成条目 —— 将条目标记为已完成，自动记录完成时间，条目从本页移至已完成页面">• エントリの完了 —— エントリを完了にマークし、完了時刻を自動記録、エントリは本ページから完了ページへ移動</s:String>
    <s:String xml:space="preserve" x:Key="• 导航栏      仪表盘 / 未完成条目 / 已完成条目 / 扩展中心 / 帮助">• ナビゲーション      ダッシュボード / 未完了エントリ / 完了済みエントリ / 拡張センター / ヘルプ</s:String>
    <s:String xml:space="preserve" x:Key="• 展开详情 —— 点击「详情」按钮展开条目完整信息面板，包括详细描述和关联文件表格">• 詳細を展開 —— 「詳細」ボタンをクリックして詳細説明と関連ファイルテーブルを含む完全な情報パネルを展開</s:String>
    <s:String xml:space="preserve" x:Key="• 工具栏      按住 Ctrl 显示：新建条目 / 搜索 / 排序 / 推送 / CLI 等快捷操作">• ツールバー      Ctrl を押して表示：新規エントリ / 検索 / 並べ替え / プッシュ / CLI などのショートカット操作</s:String>
    <s:String xml:space="preserve" x:Key="• 已完成条目在版本内全部完成后才可归档，保持视图整洁">• 完了済みエントリはバージョン内の全件が完了した後にのみアーカイブ可能で、ビューを整頓します</s:String>
    <s:String xml:space="preserve" x:Key="• 常见标签：bug（缺陷）、feature（新功能）、refactor（重构）、docs（文档）、test（测试）、chore（杂项）">• よく使うタグ：bug（不具合）、feature（新機能）、refactor（リファクタリング）、docs（ドキュメント）、test（テスト）、chore（雑務）</s:String>
    <s:String xml:space="preserve" x:Key="• 按版本归档 —— 仅当版本内所有条目均已完成时，才显示归档按钮。归档将导出 Markdown 并删除版本数据文件">• バージョンごとのアーカイブ —— バージョン内の全エントリが完了した場合のみアーカイブボタンを表示。アーカイブは Markdown をエクスポートし、バージョンデータファイルを削除します</s:String>
    <s:String xml:space="preserve" x:Key="• 排序 —— 按严重程度（高→低）、截止日期（近→远）、版本号（升/降）以及仅收藏排序">• 並べ替え —— 重要度（高→低）、期限（近い→遠い）、バージョン番号（昇順/降順）、お気に入りのみで並べ替え</s:String>
    <s:String xml:space="preserve" x:Key="• 搜索过滤 —— 顶部搜索框实时过滤插件列表">• 検索フィルター —— 上部の検索ボックスでプラグイン一覧をリアルタイムに絞り込み</s:String>
    <s:String xml:space="preserve" x:Key="• 搜索过滤 —— 顶部搜索框输入关键词实时过滤，支持前缀切换匹配范围：Text:内容、Tag:标签、Setting:设置（项目设置/主题/推送）、File:文件路径、Date:日期；不带前缀时按文字匹配，Setting: 下按回车执行设置项">• 検索フィルター —— 上部の検索ボックスにキーワードを入力してリアルタイムに絞り込み。接頭辞でマッチ範囲を切り替え：Text:内容、Tag:タグ、Setting:設定（プロジェクト設定/テーマ/プッシュ）、File:ファイルパス、Date:日付。接頭辞なしはテキストでマッチ、Setting: では Enter で設定項目を実行</s:String>
    <s:String xml:space="preserve" x:Key="• 撤销完成 —— 将已完成条目恢复为未完成状态，条目移回 UnDonePage">• 完了の取り消し —— 完了済みエントリを未完了に戻し、エントリを UnDonePage へ移動</s:String>
    <s:String xml:space="preserve" x:Key="• 支持按变更需求升序或降序排列条目列表">• 変更要求による昇順・降順のエントリ一覧並べ替えに対応</s:String>
    <s:String xml:space="preserve" x:Key="• 收藏加星 —— 点击星标按钮收藏条目，收藏的条目在列表中高亮显示">• お気に入りのスター —— スターアイコンをクリックしてエントリをお気に入り登録、お気に入りは一覧でハイライト表示</s:String>
    <s:String xml:space="preserve" x:Key="• 数值越大表示变更越复杂、影响范围越广">• 数値が大きいほど変更が複雑で影響範囲が広いことを示します</s:String>
    <s:String xml:space="preserve" x:Key="• 数据存储    所有条目以 JSON 格式保存在各项目目录下">• データ保存    全エントリは JSON 形式で各プロジェクトディレクトリに保存</s:String>
    <s:String xml:space="preserve" x:Key="• 整体结构与未完成页面一致 —— 版本分组、搜索过滤、详情展开等">• 全体構造は未完了ページと同一 —— バージョン分け、検索フィルター、詳細展開など</s:String>
    <s:String xml:space="preserve" x:Key="• 文件均为纯文本 JSON，可直接用 Git 进行版本追踪和团队协作">• ファイルはすべてプレーンテキストの JSON で、Git によるバージョン追跡とチームコラボレーションにそのまま利用可能</s:String>
    <s:String xml:space="preserve" x:Key="• 条目列表按版本号分组展示，支持折叠和展开各版本">• エントリ一覧はバージョン番号ごとにグループ表示され、各バージョンの折りたたみ・展開に対応</s:String>
    <s:String xml:space="preserve" x:Key="• 条目字段：index, id, title, severity, severityLabel, brief, detail, deadline, completedAt, changeDemand, isFavorited, version, relatedFiles">• エントリフィールド：index, id, title, severity, severityLabel, brief, detail, deadline, completedAt, changeDemand, isFavorited, version, relatedFiles</s:String>
    <s:String xml:space="preserve" x:Key="• 条目结果带类型标签（未完成 / 已完成），点击「跳转」定位到对应条目。">• エントリ結果はタイプタグ（未完了 / 完了）付きで、「移動」をクリックして該当エントリへ移動します。</s:String>
    <s:String xml:space="preserve" x:Key="• 正常输出 JSON（stdout），带缩进便于阅读">• 通常は JSON（stdout）を出力し、読みやすいようインデント付き</s:String>
    <s:String xml:space="preserve" x:Key="• 每个条目可附带一个或多个类型标签（多选）">• 各エントリに1つ以上のタイプタグを付与可能（複数選択）</s:String>
    <s:String xml:space="preserve" x:Key="• 每个条目归属于一个版本，创建时自动设为当前版本">• 各エントリは1つのバージョンに属し、作成時に自動で現在のバージョンに設定</s:String>
    <s:String xml:space="preserve" x:Key="• 点击「迭代标签」按钮自动将迭代编号 +1（如 alpha.0 → alpha.1）">• 「イテレーションタグ」ボタンをクリックするとイテレーション番号を自動で +1（例：alpha.0 → alpha.1）</s:String>
    <s:String xml:space="preserve" x:Key="• 点击搜索框外部关闭结果板。">• 検索ボックスの外側をクリックすると結果ボードを閉じます。</s:String>
    <s:String xml:space="preserve" x:Key="• 版本分组折叠 —— 条目按版本号分组，每组可折叠 / 展开，标题显示版本名和条目数">• バージョングループの折りたたみ —— エントリはバージョン番号ごとにグループ化され、各グループを折りたたみ/展開可能。タイトルにバージョン名とエントリ数を表示</s:String>
    <s:String xml:space="preserve" x:Key="• 状态栏      项目切换下拉框">• ステータスバー      プロジェクト切り替えドロップダウン</s:String>
    <s:String xml:space="preserve" x:Key="• 空输入时显示「按模式搜索」引导，点击前缀按钮可快速填入前缀。">• 空入力時は「モードで検索」ガイドを表示し、接頭辞ボタンをクリックすると接頭辞をすばやく入力できます。</s:String>
    <s:String xml:space="preserve" x:Key="• 类型标签在条目卡片上以标签形式展示，便于快速识别">• タイプタグはエントリカード上にタグ形式で表示され、すばやく識別できます</s:String>
    <s:String xml:space="preserve" x:Key="• 类型标签在项目配置（project.json）中统一定义和管理">• タイプタグはプロジェクト設定（project.json）で一元的に定義・管理</s:String>
    <s:String xml:space="preserve" x:Key="• 编辑 —— 与未完成页面相同的编辑功能">• 編集 —— 未完了ページと同じ編集機能</s:String>
    <s:String xml:space="preserve" x:Key="• 编辑条目 —— 点击编辑按钮打开编辑窗口，可修改所有字段：标题、简要、详情、严重程度、截止日期、变更需求、类型标签、关联文件">• エントリの編集 —— 編集ボタンをクリックして編集ウィンドウを開き、全フィールドを変更可能：タイトル、概要、詳細、重要度、期限、変更要求、タイプタグ、関連ファイル</s:String>
    <s:String xml:space="preserve" x:Key="• 编辑条目时在编辑窗口勾选或取消类型标签">• エントリ編集時に編集ウィンドウでタイプタグをチェック/解除</s:String>
    <s:String xml:space="preserve" x:Key="• 编辑条目时在编辑窗口设置">• エントリ編集時に編集ウィンドウで設定</s:String>
    <s:String xml:space="preserve" x:Key="• 详情查看 —— 点击插件卡片查看功能说明和使用方式">• 詳細表示 —— プラグインカードをクリックして機能説明と使い方を表示</s:String>
    <s:String xml:space="preserve" x:Key="• 返回码：0 = 成功，非 0 = 失败">• 戻り値：0 = 成功、0以外 = 失敗</s:String>
    <s:String xml:space="preserve" x:Key="• 错误信息输出至 stderr">• エラーメッセージは stderr に出力</s:String>
