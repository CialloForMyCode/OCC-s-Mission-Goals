<Page x:Class="OCCMissionGoals.ToolPages.SortPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      

      xmlns:loc="clr-namespace:OCCMissionGoals"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:OCCMissionGoals.ToolPages"
      mc:Ignorable="d" 
      d:DesignHeight="38" d:DesignWidth="225"
      Title="SortPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{loc:Loc Zh=排序方式：, En=Sort by:, Ru=&quot;Сортировка:&quot;}" Foreground="{DynamicResource ForegroundBrush}"
                   VerticalAlignment="Center" HorizontalAlignment="Left"
                   Grid.Column="0" Margin="7,6,0,6"/>

        <ComboBox x:Name="SortComboBox" Grid.Column="1" SelectedIndex="0" Margin="0,6.5,5,6.5"
                  SelectionChanged="SortComboBox_SelectionChanged"
                  Style="{StaticResource StatusBarActionComboBox}">
            <ComboBoxItem Content="{loc:Loc Zh=按照严重程度升序排序, En=Severity ascending, Ru=&quot;По важности (возрастание)&quot;}" Tag="0"/>
            <ComboBoxItem Content="{loc:Loc Zh=按照严重程度降序排序, En=Severity descending, Ru=&quot;По важности (убывание)&quot;}" Tag="1"/>
            <ComboBoxItem Content="{loc:Loc Zh=按照截止日期升序排序, En=Deadline ascending, Ru=&quot;По сроку (возрастание)&quot;}" Tag="2"/>
            <ComboBoxItem Content="{loc:Loc Zh=按照截止日期降序排序, En=Deadline descending, Ru=&quot;По сроку (убывание)&quot;}" Tag="3"/>
            <ComboBoxItem Content="{loc:Loc Zh=按照版本升序排序, En=Version ascending, Ru=&quot;По версии (возрастание)&quot;}" Tag="4"/>
            <ComboBoxItem Content="{loc:Loc Zh=按照版本降序排序, En=Version descending, Ru=&quot;По версии (убывание)&quot;}" Tag="5"/>
            <ComboBoxItem Content="{loc:Loc Zh=只显示收藏的, En=Favorites only, Ru=&quot;Только избранное&quot;}" Tag="6"/>
        </ComboBox>
    </Grid>
</Page>
