<Page x:Class="OCCMissionGoals.ToolPages.SortPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:loc="clr-namespace:OCCMissionGoals"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:OCCMissionGoals.ToolPages"
      mc:Ignorable="d" 
      d:DesignHeight="38" d:DesignWidth="225"
      Title="SortPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{loc:Loc &quot;排序方式：&quot;}" Foreground="{DynamicResource ForegroundBrush}"
                   VerticalAlignment="Center" HorizontalAlignment="Left"
                   Grid.Column="0" Margin="7,6,0,6"/>

        <ComboBox x:Name="SortComboBox" Grid.Column="1" SelectedIndex="0" Margin="0,6.5,5,6.5"
                  SelectionChanged="SortComboBox_SelectionChanged"
                  Style="{StaticResource StatusBarActionComboBox}">
            <ComboBoxItem Content="{loc:Loc &quot;按照严重程度升序排序&quot;}" Tag="0"/>
            <ComboBoxItem Content="{loc:Loc &quot;按照严重程度降序排序&quot;}" Tag="1"/>
            <ComboBoxItem Content="{loc:Loc &quot;按照截止日期升序排序&quot;}" Tag="2"/>
            <ComboBoxItem Content="{loc:Loc &quot;按照截止日期降序排序&quot;}" Tag="3"/>
            <ComboBoxItem Content="{loc:Loc &quot;按照版本升序排序&quot;}" Tag="4"/>
            <ComboBoxItem Content="{loc:Loc &quot;按照版本降序排序&quot;}" Tag="5"/>
            <ComboBoxItem Content="{loc:Loc &quot;只显示收藏的&quot;}" Tag="6"/>
            <ComboBoxItem Content="{loc:Loc &quot;按照类别排序&quot;}" Tag="7"/>
        </ComboBox>
    </Grid>
</Page>
