<Page x:Class="OCCMissionGoals.ToolPages.SortPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OCCMissionGoals.ToolPages"
      mc:Ignorable="d" 
      d:DesignHeight="38" d:DesignWidth="225"
      Title="SortPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="排序方式：" Foreground="{DynamicResource ForegroundBrush}"
                   VerticalAlignment="Center" HorizontalAlignment="Left"
                   Grid.Column="0" Margin="7,6,0,6"/>

        <ComboBox x:Name="SortComboBox" Grid.Column="1" SelectedIndex="0" Margin="0,6.5,5,6.5"
                  SelectionChanged="SortComboBox_SelectionChanged"
                  Style="{StaticResource StatusBarActionComboBox}">
            <ComboBoxItem Content="按照严重程度升序排序" Tag="0"/>
            <ComboBoxItem Content="按照严重程度降序排序" Tag="1"/>
            <ComboBoxItem Content="按照时间节点升序排序" Tag="2"/>
            <ComboBoxItem Content="按照时间节点降序排序" Tag="3"/>
            <ComboBoxItem Content="按照更改需求升序排序" Tag="4"/>
            <ComboBoxItem Content="按照更改需求降序排序" Tag="5"/>
            <ComboBoxItem Content="按照首字母升序排序" Tag="6"/>
            <ComboBoxItem Content="按照首字母降序排序" Tag="7"/>
            <ComboBoxItem Content="只显示收藏的" Tag="8"/>
        </ComboBox>
    </Grid>
</Page>
