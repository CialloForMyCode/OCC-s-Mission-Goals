<Page x:Class="OCCMissionGoals.ToolPages.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      

      xmlns:loc="clr-namespace:OCCMissionGoals"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:OCCMissionGoals.ToolPages"
      mc:Ignorable="d" 
      d:DesignHeight="38" d:DesignWidth="260"
      Title="MenuPage">
    <Grid>
        <Menu Grid.Column="0" Background="Transparent"
              VerticalAlignment="Center"
              Margin="5,5,0,5"
              ItemContainerStyle="{StaticResource MenuItemStyle}">
            <MenuItem x:Name="MenuItemFile"       Header="{loc:Loc &quot;项目(_P)&quot;}">
                <MenuItem x:Name="MenuItemNew"    Header="{loc:Loc &quot;新建项目(_N)&quot;}"/>
                <MenuItem x:Name="MenuItemOpen"   Header="{loc:Loc &quot;打开项目(_O)&quot;}"/>
                <MenuItem x:Name="MenuItemSetting"   Header="{loc:Loc &quot;设置项目(_S)&quot;}"/>
            </MenuItem>
            <MenuItem x:Name="MenuItemView"       Header="{loc:Loc &quot;条目(_V)&quot;}">
                <MenuItem x:Name="MenuItemNewEntry" Header="{loc:Loc &quot;新建条目(_N)&quot;}"/>
            </MenuItem>
            <MenuItem x:Name="MenuItemVersion" Header="{loc:Loc &quot;版本(_V)&quot;}">
                <MenuItem x:Name="MenuItemNewVersion" Header="{loc:Loc &quot;新建版本(_N)&quot;}"/>
                <MenuItem x:Name="MenuItemOpenVersion" Header="{loc:Loc &quot;打开版本(_O)&quot;}"/>
                <MenuItem x:Name="MenuItemDeleteVersion" Header="{loc:Loc &quot;删除版本(_D)&quot;}"/>
            </MenuItem>
            <MenuItem x:Name="MenuItemHelp"   Header="{loc:Loc &quot;帮助(_H)&quot;}"/>
        </Menu>
    </Grid>
</Page>
