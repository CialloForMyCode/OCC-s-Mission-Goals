<Page x:Class="OCCMissionGoals.Pages.UnDonePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OCCMissionGoals.Pages"
      xmlns:loc="clr-namespace:OCCMissionGoals"
      xmlns:svc="clr-namespace:OCCMissionGoals.Services"
      mc:Ignorable="d" 
      d:DesignHeight="758" d:DesignWidth="1240"
      Title="UnDonePage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <svc:MarkdownConverter x:Key="MarkdownConverter" />
        <svc:MarkdownInlineConverter x:Key="MarkdownInlineConverter" />
        <Style x:Key="StarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PressedBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" Grid.IsSharedSizeScope="True">
        <Grid>
            <ItemsControl x:Name="UnDoneList" ClipToBounds="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 每个 Item 是一个 UnDoneVersionGroupVM -->
                        <StackPanel>
                            <!-- 版本头：可点击折叠/展开 -->
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Margin="0,4,0,2" Padding="10,6"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="VersionHeader_Click"
                                    Tag="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="GroupArrow"
                                               Text="▼" FontSize="10"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               FontSize="14" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                                               FontSize="12" Opacity="0.5"
                                               VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Run Text="("/>
                                        <Run Text="{Binding DisplayCount, Mode=OneWay}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 该版本下的条目列表 -->
                            <ItemsControl x:Name="GroupItems"
                                          ItemsSource="{Binding Items}"
                                          Visibility="Visible">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                Margin="0,0,0,2" Padding="12,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource StarBtn}"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,4,0"
                                                            Click="Favorite_Click" Tag="{Binding}">
                                                        <Path x:Name="StarPath"
                                                              Fill="{DynamicResource ForegroundBrush}"
                                                              Stretch="Uniform" Width="16" Height="16"
                                                              Loaded="StarPath_Loaded"/>
                                                    </Button>

                                                    <Border Grid.Column="1"
                                                            CornerRadius="4" Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding SeverityBrush}">
                                                        <TextBlock Text="{Binding SeverityText}"
                                                                   Foreground="White" FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <Grid Grid.Column="3"
                                                          VerticalAlignment="Center"
                                                          Margin="10,0,8,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TitleCol"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <ContentControl Grid.Column="0"
                                                                        Content="{Binding Title, Mode=OneWay, Converter={StaticResource MarkdownInlineConverter}}"
                                                                        Foreground="{DynamicResource ForegroundBrush}"
                                                                        FontSize="14" FontWeight="SemiBold"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"/>
                                                        <ContentControl Grid.Column="1"
                                                                        Content="{Binding Brief, Mode=OneWay, Converter={StaticResource MarkdownInlineConverter}, ConverterParameter=trim}"
                                                                        Foreground="{DynamicResource ForegroundBrush}"
                                                                        FontSize="12"
                                                                        VerticalAlignment="Center"
                                                                        Margin="10,0,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        Visibility="{Binding IsExcerptVisible, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Grid.Column="2"
                                                                   x:Name="ToggleLink"
                                                                   Text="{Binding DetailToggleText}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   TextDecorations="Underline"
                                                                   FontSize="12" Cursor="Hand"
                                                                   Background="Transparent"
                                                                   VerticalAlignment="Center"
                                                                   Margin="6,0,0,0"
                                                                   MouseLeftButtonUp="DetailToggle_Click"/>
                                                    </Grid>

                                                    <StackPanel Grid.Column="4"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <Path Fill="{DynamicResource ForegroundBrush}" Stretch="Uniform"
                                                              Width="14" Height="14" Margin="0,0,4,0"
                                                              Data="M8 1C4.13401 1 1 4.13401 1 8C1 11.866 4.13401 15 8 15C11.866 15 15 11.866 15 8C15 4.13401 11.866 1 8 1ZM7.5 4C7.77614 4 8 4.22386 8 4.5V8H11.5C11.7761 8 12 8.22386 12 8.5C12 8.77614 11.7761 9 11.5 9H7.5C7.22386 9 7 8.77614 7 8.5V4.5C7 4.22386 7.22386 4 7.5 4Z"/>
                                                        <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                                                                   FontSize="12" VerticalAlignment="Center">
                                                            <Run Text="{loc:Loc &quot;截止&quot;}"/>
                                                            <Run Text="{Binding Deadline, StringFormat=yyyy-MM-dd, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="5"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CardActionBtn}"
                                                                Click="Edit_Click" Tag="{Binding}"
                                                                Foreground="{DynamicResource ForegroundBrush}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Fill="{DynamicResource ForegroundBrush}" Stretch="Uniform"
                                                                      Width="12" Height="12" Margin="0,0,4,0"
                                                                      Data="M14.452 1.548C14.087 1.183 13.608 1 13.13 1C12.652 1 12.173 1.183 11.808 1.548L6.979 6.377C6.697 6.659 6.498 7.011 6.401 7.398L6.027 8.896C5.883 9.473 6.329 10.002 6.886 10.002C6.958 10.002 7.031 9.993 7.106 9.975L8.604 9.601C8.99 9.504 9.343 9.305 9.625 9.023L14.454 4.194C15.184 3.464 15.184 2.28 14.454 1.549L14.452 1.548ZM13.745 3.485L8.916 8.314C8.763 8.467 8.57 8.576 8.36 8.629L7.04 8.962L7.371 7.64C7.424 7.43 7.532 7.237 7.686 7.084L12.516 2.255C12.68 2.091 12.899 2 13.131 2C13.363 2 13.582 2.091 13.746 2.255C14.085 2.594 14.085 3.146 13.746 3.486L13.745 3.485Z"/>
                                                                <TextBlock Text="{loc:Loc &quot;编辑&quot;}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource CardActionBtn}"
                                                                Click="Complete_Click" Tag="{Binding}"
                                                                Foreground="{DynamicResource PrimaryBrush}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Fill="{DynamicResource PrimaryBrush}" Stretch="Uniform"
                                                                      Width="12" Height="12" Margin="0,0,4,0"
                                                                      Data="M13.6572 3.13573C13.8583 2.9465 14.175 2.95614 14.3643 3.15722C14.5535 3.35831 14.5438 3.675 14.3428 3.86425L5.84277 11.8642C5.64597 12.0494 5.33756 12.0446 5.14648 11.8535L1.64648 8.35351C1.45121 8.15824 1.45121 7.84174 1.64648 7.64647C1.84174 7.45121 2.15825 7.45121 2.35351 7.64647L5.50976 10.8027L13.6572 3.13573Z"/>
                                                                <TextBlock Text="{loc:Loc &quot;完成&quot;}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Content="{loc:Loc &quot;删除&quot;}" Style="{StaticResource CardActionBtn}"
                                                                Click="Delete_Click" Tag="{Binding}"
                                                                Foreground="#E86A6A"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel x:Name="DetailPanel" Visibility="{Binding IsDetailExpanded, Converter={StaticResource BoolToVis}}">
                                                    <ContentControl Content="{Binding Detail, Mode=OneWay, Converter={StaticResource MarkdownConverter}}"
                                                                    Margin="0,6,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                                Visibility="{Binding HasType, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{loc:Loc &quot;类别&quot;}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                                        <ItemsControl ItemsSource="{Binding TypeTags}"
                                                                      VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border x:Name="TagBg" CornerRadius="3" Padding="6,2"
                                                                            Background="{DynamicResource SubtleBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                                                            BorderThickness="1"
                                                                            Margin="0,0,5,0">
                                                                        <TextBlock x:Name="TagText" Text="{Binding Text}"
                                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                                   FontSize="11"
                                                                                   VerticalAlignment="Center"
                                                                                   Opacity="0.8"/>
                                                                    </Border>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding HasColor}" Value="True">
                                                                            <Setter TargetName="TagBg" Property="Background" Value="{Binding Background}"/>
                                                                            <Setter TargetName="TagBg" Property="BorderBrush" Value="{Binding Background}"/>
                                                                            <Setter TargetName="TagText" Property="Foreground" Value="White"/>
                                                                            <Setter TargetName="TagText" Property="Opacity" Value="1"/>
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FileCol"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LineCol"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColCol"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FuncCol"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{loc:Loc &quot;相关文件&quot;}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{loc:Loc &quot;函数&quot;}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   FontSize="11" Opacity="0.5" FontFamily="Consolas"
                                                                   Margin="16,0,0,0"/>
                                                        <TextBlock Grid.Column="2" Text="{loc:Loc &quot;行&quot;}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   FontSize="11" Opacity="0.5" FontFamily="Consolas"
                                                                   Margin="24,0,0,0"/>
                                                        <TextBlock Grid.Column="3" Text="{loc:Loc &quot;列&quot;}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   FontSize="11" Opacity="0.5" FontFamily="Consolas"
                                                                   Margin="16,0,0,0"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding RelatedFiles, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FileCol"/>
                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LineCol"/>
                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ColCol"/>
                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FuncCol"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" FontSize="12"
                                                                               FontFamily="Consolas"
                                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                                               Text="{Binding Path, Mode=OneWay}"/>
                                                                    <TextBlock Grid.Column="1" FontSize="11"
                                                                               FontFamily="Consolas"
                                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                                               Opacity="0.6" Margin="16,0,0,0"
                                                                               Text="{Binding Function, Mode=OneWay}"/>
                                                                    <TextBlock Grid.Column="2" FontSize="11"
                                                                               FontFamily="Consolas"
                                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                                               Opacity="0.6" Margin="24,0,0,0"
                                                                               Text="{Binding Line, Mode=OneWay}"/>
                                                                    <TextBlock Grid.Column="3" FontSize="11"
                                                                               FontFamily="Consolas"
                                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                                               Opacity="0.6" Margin="16,0,0,0"
                                                                               Text="{Binding Column, Mode=OneWay}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button Style="{StaticResource CardActionBtn}"
                                                            Click="CopyInfo_Click" Tag="{Binding}"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,10,0,0"
                                                            Foreground="{DynamicResource ForegroundBrush}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Fill="{DynamicResource ForegroundBrush}" Stretch="Uniform"
                                                                  Width="12" Height="12" Margin="0,0,4,0"
                                                                  Data="M16 1H4C2.9 1 2 1.9 2 3V17H4V3H16V1ZM19 5H8C6.9 5 6 5.9 6 7V21C6 22.1 6.9 23 8 23H19C20.1 23 21 22.1 21 21V7C21 5.9 20.1 5 19 5ZM19 21H8V7H19V21Z"/>
                                                            <TextBlock Text="{loc:Loc &quot;复制信息&quot;}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="EmptyPlaceholder"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Margin="0,0,0,6" Padding="24,20"
                    VerticalAlignment="Top">
                <TextBlock Text="{loc:Loc &quot;没有未完成条目&quot;}"
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="15" Opacity="0.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
