<Page x:Class="OCCMissionGoals.Pages.ExpandPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:OCCMissionGoals.Pages"
      xmlns:loc="clr-namespace:OCCMissionGoals"
      mc:Ignorable="d" 
      d:DesignHeight="667" d:DesignWidth="1240"
      Title="ExpandPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- 标题 -->
            <Border CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Padding="16" Margin="0,0,0,5">
                <TextBlock Text="{loc:Loc Zh=扩展中心, En=Extension Center}"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="16,0,0,6"/>
            </Border>

            <!-- 搜索栏 -->
            <Border CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Padding="16" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Background="{DynamicResource SearchBackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderThickness="0" Padding="10,8"
                             FontSize="13" VerticalAlignment="Center"
                             TextChanged="SearchBox_TextChanged">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Grid.Column="0"
                               Text="{loc:Loc Zh=搜索扩展..., En=Search extensions...}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="13" Opacity="0.4"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1"
                            Content="{loc:Loc Zh=刷新, En=Refresh}" Width="72" Height="32"
                            Margin="12,0,0,0"
                            Style="{StaticResource CardActionBtn}"
                            Click="RefreshButton_Click"/>
                </Grid>
            </Border>

            <!-- 内容区域：分类 + 列表 + 空状态（Grid 重叠布局） -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 分类筛选 -->
                <Border x:Name="CategorySection" Grid.Row="0"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Padding="4" Margin="0,0,0,5">
                    <ItemsControl x:Name="CategoryList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Margin="4" Padding="12,6"
                                        FontSize="12"
                                        Style="{StaticResource CardActionBtn}"
                                        Click="CategoryButton_Click"
                                        Tag="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- 插件列表 -->
                <ItemsControl x:Name="PluginList" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    Padding="20" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 图标 -->
                                    <Border Grid.Column="0" Grid.RowSpan="3"
                                            Width="48" Height="48" CornerRadius="8"
                                            Background="{DynamicResource SearchBackgroundBrush}"
                                            VerticalAlignment="Top" Margin="0,0,16,0">
                                        <Image Source="{Binding Icon}"
                                               Width="32" Height="32"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 名称 + 版本 -->
                                    <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Version, StringFormat=' v{0}'}"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="11" Opacity="0.5"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <Border CornerRadius="3"
                                                Background="{DynamicResource PrimaryBrush}"
                                                Padding="4" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{loc:Loc Zh=已安装, En=Installed}" FontSize="10"
                                                       Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 描述 -->
                                    <TextBlock Grid.Column="1" Grid.Row="1"
                                               Text="{Binding Description}"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               FontSize="12" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,6"/>

                                    <!-- 底部信息 -->
                                    <StackPanel Grid.Column="1" Grid.Row="2"
                                                Orientation="Horizontal">
                                        <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="11" Opacity="0.4">
                                            <Run Text="{loc:Loc Zh=作者: , En=Author: }"/>
                                            <Run Text="{Binding Author}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Downloads, StringFormat='  |  ⬇ {0}'}"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="11" Opacity="0.4"/>
                                        <TextBlock Text="{Binding Category, StringFormat='  |  {0}'}"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   FontSize="11" Opacity="0.7"/>
                                    </StackPanel>

                                    <!-- 操作按钮 -->
                                    <StackPanel Grid.Column="2" Grid.RowSpan="3"
                                                VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button x:Name="InstallBtn"
                                                Width="80" Height="32"
                                                Click="InstallButton_Click"
                                                Tag="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
                                                    <Setter Property="Content" Value="{loc:Loc Zh=安装, En=Install}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                            <Setter Property="Content" Value="{loc:Loc Zh=卸载, En=Uninstall}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态（与 DonePage 一致：卡片风格 Border） -->
                <Border x:Name="EmptyHint"
                        Grid.RowSpan="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Margin="0,0,0,6" Padding="24,20"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc Zh=没有扩展, En=No extensions}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="15" Opacity="0.5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
