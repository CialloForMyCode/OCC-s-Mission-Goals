<Page x:Class="OCCMissionGoals.Pages.ExpandPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:OCCMissionGoals.Pages"
      xmlns:loc="clr-namespace:OCCMissionGoals"
      mc:Ignorable="d" 
      d:DesignHeight="667" d:DesignWidth="1240"
      Title="ExpandPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- 标题 + 刷新 -->
            <Border CornerRadius="{DynamicResource UiCornerRadiusLarge}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource UiBorderThickness}"
                    Padding="16" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc &quot;扩展中心&quot;}"
                               Grid.Column="0"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,6"/>
                    <Button Grid.Column="1"
                            Content="{loc:Loc &quot;刷新&quot;}" Width="72" Height="32"
                            Style="{StaticResource CardActionBtn}"
                            Click="RefreshButton_Click"/>
                </Grid>
            </Border>

            <!-- 内容区域：分类 + 列表 + 空状态（Grid 重叠布局） -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 分类筛选 -->
                <Border x:Name="CategorySection" Grid.Row="0"
                        CornerRadius="{DynamicResource UiCornerRadiusLarge}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource UiBorderThickness}"
                        Padding="4" Margin="0,0,0,5">
                    <ItemsControl x:Name="CategoryList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Margin="4" Padding="12,6"
                                        FontSize="12"
                                        Style="{StaticResource CardActionBtn}"
                                        Click="CategoryButton_Click"
                                        Tag="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- 插件列表 -->
                <ItemsControl x:Name="PluginList" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="{DynamicResource UiCornerRadiusLarge}"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource UiBorderThickness}"
                                    Padding="14,12" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 图标 -->
                                    <Border Grid.Column="0" Grid.RowSpan="2"
                                            Width="40" Height="40" CornerRadius="{DynamicResource UiCornerRadiusMedium}"
                                            Background="{DynamicResource SearchBackgroundBrush}"
                                            VerticalAlignment="Center" Margin="0,0,14,0">
                                        <Image Source="{Binding Icon}"
                                               Width="26" Height="26"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 第一行：标题 + 版本 ｜ 简介 ｜ 已安装徽标 -->
                                    <Grid Grid.Column="1" Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="11" Opacity="0.5"
                                                       VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Version, StringFormat=' v{0}'}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Version}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Description}"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="12" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="360"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>

                                        <Border Grid.Column="2" CornerRadius="3"
                                                Background="{DynamicResource PrimaryBrush}"
                                                Padding="4" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding InstalledLabel}" FontSize="10"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>

                                    <!-- 第二行：作者 / 下载量 / 分类 -->
                                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal"
                                                Margin="0,2,0,0">
                                        <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="11" Opacity="0.4">
                                            <Run Text="{loc:Loc &quot;作者:&quot;}"/>
                                            <Run Text="{Binding Author}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="11" Opacity="0.4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Downloads, StringFormat='  |  ⬇ {0}'}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Downloads}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CategoryName, StringFormat='  |  {0}'}"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   FontSize="11" Opacity="0.7"/>
                                    </StackPanel>

                                    <!-- 操作按钮（横排：安装 / 卸载 ｜ 更新）/ 安装进度 -->
                                    <StackPanel Grid.Column="2" Grid.RowSpan="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="14,0,0,0">
                                        <Button x:Name="InstallBtn"
                                                Width="80" Height="32"
                                                Click="InstallButton_Click"
                                                Tag="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
                                                    <!-- 文案由来源决定：语言包 / 主题为「安装 / 卸载」，本地扩展为「启用 / 禁用」。
                                                         安装在下载期间折叠，原位显示进度条。 -->
                                                    <Setter Property="Content" Value="{Binding ActionLabel}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- 有新版时才出现：升级到仓库中的最新内容（与安装共用进度条） -->
                                        <Button x:Name="UpdateBtn"
                                                Width="80" Height="32" Margin="6,0,0,0"
                                                Content="{loc:Loc &quot;更新&quot;}"
                                                Click="UpdateButton_Click"
                                                Tag="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                    <!-- 只有「已安装 + 仓库里有新内容」才出现：未安装时点「安装」拿到的就是最新版，
                                                         更新对未安装项没有意义。 -->
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasUpdate}" Value="True"/>
                                                                <Condition Binding="{Binding IsInstalled}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- 安装进度：出现条件为「正在下载」，安装结束后随状态自动收起 -->
                                        <StackPanel Width="88"
                                                    Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
                                            <ProgressBar Height="8"
                                                         HorizontalAlignment="Stretch"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding InstallProgress, Mode=OneWay}"/>
                                            <TextBlock Text="{Binding InstallProgressText}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="11" Opacity="0.6"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,6,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态（与 DonePage 一致：卡片风格 Border） -->
                <Border x:Name="EmptyHint"
                        Grid.RowSpan="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="{DynamicResource UiBorderThickness}" CornerRadius="{DynamicResource UiCornerRadiusLarge}"
                        Margin="0,0,0,6" Padding="24,20"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <TextBlock x:Name="EmptyHintText"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="15" Opacity="0.5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
