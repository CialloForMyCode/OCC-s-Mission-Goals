<Page x:Class="OCCMissionGoals.Pages.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OCCMissionGoals.Pages"
      xmlns:loc="clr-namespace:OCCMissionGoals"
      xmlns:svc="clr-namespace:OCCMissionGoals.Services"
      mc:Ignorable="d" 
      d:DesignHeight="758" d:DesignWidth="1240"
      Title="LogPage">

    <Page.Resources>
        <local:ProgressWidthConverter x:Key="ProgressWidthConverter"/>
        <!-- 修复严重程度月表的格子基色：取「致命」红（与 SeverityHelper 里的致命色一致），深浅由当日修复权重决定 -->
        <SolidColorBrush x:Key="SeverityHeatBrush" Color="#E83D3D"/>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

        <!-- ========== 总进度卡片 ========== -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="{DynamicResource UiBorderThickness}" CornerRadius="{DynamicResource UiCornerRadiusLarge}"
            Padding="24,20" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题行：项目名 + 版本 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ProjectName, FallbackValue='OCC&amp;apos;s Mission &amp; Goals'}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="24" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentVersionDisplay, StringFormat='  {0}', FallbackValue='  0.1.0-alpha.0'}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="16" Opacity="0.5"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 统计数字行 -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding CompletedCount, Mode=OneWay}"
                               Foreground="{DynamicResource PrimaryBrush}" FontSize="28" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc &quot;已完成&quot;}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="14" VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text=" / "
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="14" Opacity="0.4"
                           VerticalAlignment="Center" Margin="8,0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="{Binding TotalCount, Mode=OneWay}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="28" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc &quot;总计&quot;}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="14" VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 进度条 -->
                <Border Grid.Row="2" Margin="0,0,0,10"
                    Background="{DynamicResource SearchBackgroundBrush}"
                    CornerRadius="5" Height="14">
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="5"
                        HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgressRatio}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                <Binding Path="ProgressRatio" Mode="OneWay"/>
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>

                <!-- 百分比 -->
                <TextBlock Grid.Row="3"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="13" Opacity="0.6">
                <Run Text="{loc:Loc &quot;完成度&quot;}"/>
                <Run Text="{Binding ProgressPercent, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ========== 贡献分布：环形图 + GitHub 风格月表 ========== -->
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 严重程度分布（环形图） -->
            <Border Grid.Column="0" MinWidth="428"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="{DynamicResource UiBorderThickness}" CornerRadius="{DynamicResource UiCornerRadiusLarge}"
                    Padding="24,20">
                <StackPanel>
                    <TextBlock Text="{loc:Loc &quot;严重程度分布&quot;}"
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="16" FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                    <Grid HorizontalAlignment="Center">
                        <!-- 环形图本体：所有扇环叠放在同一格；外部标签与引线由 code-behind 按扇区角度排布 -->
                        <ItemsControl x:Name="SeverityPie"
                                      Width="{Binding ChartWidth}" Height="{Binding ChartHeight}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas Width="{Binding DataContext.ChartWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Height="{Binding DataContext.ChartHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <!-- 描边取主题的卡片背景色：相邻扇区之间留出背景色的缝，区块分明 -->
                                        <Path Data="{Binding Geometry}"
                                              Fill="{Binding Brush}"
                                              Stroke="{DynamicResource CardBackgroundBrush}"
                                              StrokeThickness="2"/>

                                        <!-- 引线：扇区边缘 → 折点 → 标签列 -->
                                        <Polyline Points="{Binding LeaderPoints}"
                                                  Stroke="{DynamicResource ForegroundBrush}"
                                                  StrokeThickness="1" Opacity="0.4"/>

                                        <TextBlock Text="{Binding LabelText}"
                                                   Canvas.Left="{Binding LabelLeft}"
                                                   Canvas.Top="{Binding LabelTop}"
                                                   Width="{Binding LabelWidth}"
                                                   TextAlignment="{Binding LabelAlignment}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="12"
                                                   ToolTip="{Binding TooltipText}"/>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 空态占位 -->
                        <TextBlock Text="{loc:Loc &quot;没有动态&quot;}"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13" Opacity="0.4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UnfinishedCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 贡献记录（GitHub 同款月表） -->
            <Border Grid.Column="1" Margin="6,0,0,0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="{DynamicResource UiBorderThickness}" CornerRadius="{DynamicResource UiCornerRadiusLarge}"
                    Padding="24,20">
                <StackPanel>
                    <TextBlock Text="{loc:Loc &quot;贡献记录&quot;}"
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="16" FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                    <!-- 月份刻度：与格子左边缘对齐（左侧留 30 给星期标签） -->
                    <Grid Margin="30,0,0,4" Width="636" HorizontalAlignment="Left">
                        <ItemsControl x:Name="MonthLabels">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Margin="{Binding Margin}"
                                               FontSize="10" Opacity="0.7"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 星期标签 + 每日格子 -->
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="30" Height="84">
                            <ItemsControl x:Name="WeekdayLabels">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Margin="{Binding Margin}"
                                                   FontSize="10" Opacity="0.7"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- 53 周 × 7 天；ItemPanel 为 UniformGrid，按行填充，故索引 = 星期 * 53 + 周 -->
                        <ItemsControl x:Name="ContributionGrid" Width="636" Height="84">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="7" Columns="53"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="10" Height="10"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip="{Binding Tooltip}">
                                        <!-- 空档底衬：深色主题下若只画低透明度主题色会黑成一片 -->
                                        <Rectangle RadiusX="2" RadiusY="2"
                                                   Fill="{DynamicResource ContributionEmptyBrush}"
                                                   Opacity="{Binding EmptyOpacity}"/>
                                        <Rectangle RadiusX="2" RadiusY="2"
                                                   Fill="{DynamicResource PrimaryBrush}"
                                                   Opacity="{Binding Opacity}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 色阶图例：少 → 多 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock Text="{loc:Loc &quot;少&quot;}"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="10" Opacity="0.7" VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource ContributionEmptyBrush}" Margin="0,0,3,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource PrimaryBrush}" Opacity="0.28" Margin="0,0,3,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource PrimaryBrush}" Opacity="0.48" Margin="0,0,3,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource PrimaryBrush}" Opacity="0.72" Margin="0,0,3,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource PrimaryBrush}" Opacity="1.00"/>

                        <TextBlock Text="{loc:Loc &quot;多&quot;}"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="10" Opacity="0.7" VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- 月度修复严重程度表：外观与上方月表同款，格子深浅由当日修复问题的严重程度权重决定 -->
                    <TextBlock Text="{loc:Loc &quot;月度修复严重程度&quot;}"
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           Margin="0,22,0,10"/>

                    <!-- 月份刻度：与格子左边缘对齐（左侧留 30 给星期标签） -->
                    <Grid Margin="30,0,0,4" Width="636" HorizontalAlignment="Left">
                        <ItemsControl x:Name="SeverityMonthLabels">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Margin="{Binding Margin}"
                                               FontSize="10" Opacity="0.7"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 星期标签 + 每日格子 -->
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="30" Height="84">
                            <ItemsControl x:Name="SeverityWeekdayLabels">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Margin="{Binding Margin}"
                                                   FontSize="10" Opacity="0.7"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- 53 周 × 7 天；ItemPanel 为 UniformGrid，按行填充，故索引 = 星期 * 53 + 周 -->
                        <ItemsControl x:Name="SeverityGrid" Width="636" Height="84">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="7" Columns="53"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="10" Height="10"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip="{Binding Tooltip}">
                                        <!-- 空档底衬：深色主题下若只画低透明度基色会黑成一片 -->
                                        <Rectangle RadiusX="2" RadiusY="2"
                                                   Fill="{DynamicResource ContributionEmptyBrush}"
                                                   Opacity="{Binding EmptyOpacity}"/>
                                        <Rectangle RadiusX="2" RadiusY="2"
                                                   Fill="{DynamicResource SeverityHeatBrush}"
                                                   Opacity="{Binding Opacity}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 色阶图例：少 → 多 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock Text="{loc:Loc &quot;少&quot;}"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="10" Opacity="0.7" VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource ContributionEmptyBrush}" Margin="0,0,3,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource SeverityHeatBrush}" Opacity="0.28" Margin="0,0,3,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource SeverityHeatBrush}" Opacity="0.48" Margin="0,0,3,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource SeverityHeatBrush}" Opacity="0.72" Margin="0,0,3,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource SeverityHeatBrush}" Opacity="1.00"/>

                        <TextBlock Text="{loc:Loc &quot;多&quot;}"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="10" Opacity="0.7" VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== 已完成条目：最近 30 天完成条目的严重程度折线图 ========== -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="{DynamicResource UiBorderThickness}" CornerRadius="{DynamicResource UiCornerRadiusLarge}"
            Padding="24,20" Margin="0,0,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="{loc:Loc &quot;已完成条目&quot;}"
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FinishedCountText, Mode=OneWay}"
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="12" Opacity="0.5"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 折线图：横轴 = 最近 30 天，纵轴 = 条目完成时的严重程度。
                     画布高度固定、宽度跟随卡片，坐标由 code-behind 按实际宽度计算。 -->
                <Canvas x:Name="SeverityTrendCanvas" Height="300"
                        SizeChanged="SeverityTrendCanvas_SizeChanged">
                    <Canvas.Style>
                        <Style TargetType="Canvas">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TrendPointCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Canvas.Style>
                </Canvas>

                <!-- 空态：最近 30 天没有任何完成动态 -->
                <TextBlock Text="{loc:Loc &quot;没有动态&quot;}"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="13" Opacity="0.4" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TrendPointCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

            </StackPanel>
        </ScrollViewer>


    </Grid>
</Page>
