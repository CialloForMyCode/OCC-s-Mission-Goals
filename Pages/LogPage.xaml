<Page x:Class="OCCMissionGoals.Pages.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OCCMissionGoals.Pages"
      xmlns:loc="clr-namespace:OCCMissionGoals"
      xmlns:svc="clr-namespace:OCCMissionGoals.Services"
      mc:Ignorable="d" 
      d:DesignHeight="758" d:DesignWidth="1240"
      Title="LogPage">

    <Page.Resources>
        <local:ProgressWidthConverter x:Key="ProgressWidthConverter"/>
        <local:TimeAgoConverter x:Key="TimeAgoConverter"/>
        <svc:MarkdownInlineConverter x:Key="MarkdownInlineConverter" />
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

        <!-- ========== 总进度卡片 ========== -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="8"
            Padding="24,20" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题行：项目名 + 版本 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ProjectName, FallbackValue='OCC&amp;apos;s Mission &amp; Goals'}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="24" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentVersionDisplay, StringFormat='  {0}', FallbackValue='  0.1.0-alpha.0'}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="16" Opacity="0.5"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 统计数字行 -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding CompletedCount, Mode=OneWay}"
                               Foreground="{DynamicResource PrimaryBrush}" FontSize="28" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc &quot;已完成&quot;}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="14" VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text=" / "
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="14" Opacity="0.4"
                           VerticalAlignment="Center" Margin="8,0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="{Binding TotalCount, Mode=OneWay}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="28" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc &quot;总计&quot;}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="14" VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 进度条 -->
                <Border Grid.Row="2" Margin="0,0,0,10"
                    Background="{DynamicResource SearchBackgroundBrush}"
                    CornerRadius="5" Height="14">
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="5"
                        HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgressRatio}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                <Binding Path="ProgressRatio" Mode="OneWay"/>
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>

                <!-- 百分比 -->
                <TextBlock Grid.Row="3"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="13" Opacity="0.6">
                <Run Text="{loc:Loc &quot;完成度&quot;}"/>
                <Run Text="{Binding ProgressPercent, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ========== 严重程度分布 ========== -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="24,20" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc &quot;严重程度分布&quot;}"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,14"/>

                <ItemsControl Grid.Row="1" x:Name="SeverityBars">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>

                                <!-- 标签 -->
                                <TextBlock Grid.Column="0"
                                       Text="{Binding Label}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>

                                <!-- 柱体 -->
                                <Border Grid.Column="1" Margin="8,0"
                                    Background="{DynamicResource SearchBackgroundBrush}"
                                    CornerRadius="4" Height="20">
                                    <Border CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Background="{Binding ColorBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                                <Binding Path="Ratio" Mode="OneWay"/>
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>

                                <!-- 数量 -->
                                <TextBlock Grid.Column="2"
                                       Text="{Binding Count}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ========== 即将到期条目 ========== -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="24,20" Margin="0,0,0,6"
                x:Name="DeadlineCard">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasUpcomingDeadlines}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc &quot;即将到期&quot;}"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,14"/>

                <ItemsControl Grid.Row="1" x:Name="DeadlineList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6" Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 严重度色点 -->
                                <Ellipse Grid.Column="0" Width="10" Height="10"
                                     Fill="{Binding SeverityBrush}"
                                     VerticalAlignment="Center"/>

                                <!-- 标题 -->
                                <ContentControl Grid.Column="1"
                                       Content="{Binding Title, Mode=OneWay, Converter={StaticResource MarkdownInlineConverter}, ConverterParameter=trim}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       HorizontalContentAlignment="Stretch"/>

                                <!-- 剩余天数 -->
                                <TextBlock Grid.Column="2"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding DaysLeftText}"/>
                                            <Setter Property="Foreground" Value="#E8D43D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter Property="Foreground" Value="#E83D3D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ========== 最近活动 ========== -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="24,20" Margin="0,0,0,6"
                x:Name="ActivityCard">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRecentActivity}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc &quot;最近活动&quot;}"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,14"/>

                <ItemsControl Grid.Row="1" x:Name="ActivityList"
                              MaxHeight="300">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 严重度色点 -->
                                <Ellipse Grid.Column="0" Width="10" Height="10"
                                     Fill="{Binding SeverityBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>

                                <!-- 标题 + 类型 -->
                                <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                    <Border CornerRadius="3" Padding="4,1"
                                        Background="{Binding TypeBrush}"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeLabel}"
                                               Foreground="#FFFFFF"
                                               FontSize="10"/>
                                    </Border>
                                    <ContentControl Content="{Binding Title, Mode=OneWay, Converter={StaticResource MarkdownInlineConverter}, ConverterParameter=trim}"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="13" VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           HorizontalContentAlignment="Stretch"/>
                                </StackPanel>

                                <!-- 时间 -->
                                <TextBlock Grid.Column="2"
                                       Text="{Binding TimeAgo}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="11" Opacity="0.5"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ========== 月度贡献卡片 ========== -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="8"
            Padding="24,20" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc &quot;贡献记录&quot;}"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,16"/>

                <!-- 刻度线 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="1" Margin="8,0">
                        <!-- 刻度值 -->
                        <TextBlock Text="{Binding TickLabels[2]}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="10" Opacity="0.7"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding TickLabels[4]}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="10" Opacity="0.7"
                               HorizontalAlignment="Right" Margin="4,8,0,0"/>
                    </Grid>
                </Grid>

                <ItemsControl Grid.Row="1" x:Name="MonthlyBars">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CompletedCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <!-- 日期标签 -->
                                <TextBlock Grid.Column="0"
                                       Text="{Binding Label}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12" Opacity="0.7"
                                       VerticalAlignment="Center"/>

                                <!-- 柱体区域 -->
                                <Border Grid.Column="1" Margin="8,0"
                                    Background="{DynamicResource SearchBackgroundBrush}"
                                    CornerRadius="4" Height="22">
                                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4"
                                        HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                                <Binding Path="Ratio" Mode="OneWay"/>
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>

                                <!-- 数量标签 -->
                                <TextBlock Grid.Column="2"
                                       Text="{Binding Count}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="1" Text="{loc:Loc &quot;没有动态&quot;}"
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="16" Opacity="0.4"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,40,0,40">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CompletedCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

            </StackPanel>
        </ScrollViewer>


    </Grid>
</Page>
