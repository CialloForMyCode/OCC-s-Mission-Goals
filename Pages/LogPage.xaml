<Page x:Class="OCCMissionGoals.Pages.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OCCMissionGoals.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="758" d:DesignWidth="1240"
      Title="LogPage">

    <Page.Resources>
        <local:ProgressWidthConverter x:Key="ProgressWidthConverter"/>
        <local:TimeAgoConverter x:Key="TimeAgoConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

        <!-- ========== 总进度卡片 ========== -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="8"
            Padding="24,20" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题行：项目名 + 版本 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ProjectName, FallbackValue='OCC&amp;apos;s Mission &amp; Goals'}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="24" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentVersionDisplay, StringFormat='  {0}', FallbackValue='  0.1.0-alpha.0'}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="16" Opacity="0.5"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 统计数字行 -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding CompletedCount, Mode=OneWay}"
                               Foreground="#4CAF50" FontSize="28" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                        <TextBlock Text=" 已完成"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="14" VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text=" / "
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="14" Opacity="0.4"
                           VerticalAlignment="Center" Margin="8,0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="{Binding TotalCount, Mode=OneWay}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="28" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                        <TextBlock Text=" 总计"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="14" VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 进度条 -->
                <Border Grid.Row="2" Margin="0,0,0,10"
                    Background="{DynamicResource SearchBackgroundBrush}"
                    CornerRadius="5" Height="14">
                    <Border Background="#4CAF50" CornerRadius="5"
                        HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgressRatio}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                <Binding Path="ProgressRatio" Mode="OneWay"/>
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>

                <!-- 百分比 -->
                <TextBlock Grid.Row="3"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="13" Opacity="0.6">
                <Run Text="完成度 "/>
                <Run Text="{Binding ProgressPercent, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ========== 严重程度分布 ========== -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="24,20" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="严重程度分布"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,14"/>

                <ItemsControl Grid.Row="1" x:Name="SeverityBars">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>

                                <!-- 标签 -->
                                <TextBlock Grid.Column="0"
                                       Text="{Binding Label}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>

                                <!-- 柱体 -->
                                <Border Grid.Column="1" Margin="8,0"
                                    Background="{DynamicResource SearchBackgroundBrush}"
                                    CornerRadius="4" Height="20">
                                    <Border CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Background="{Binding ColorBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                                <Binding Path="Ratio" Mode="OneWay"/>
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>

                                <!-- 数量 -->
                                <TextBlock Grid.Column="2"
                                       Text="{Binding Count}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ========== 即将到期条目 ========== -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="24,20" Margin="0,0,0,6"
                x:Name="DeadlineCard">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasUpcomingDeadlines}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="即将到期"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,14"/>

                <ItemsControl Grid.Row="1" x:Name="DeadlineList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6" Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 严重度色点 -->
                                <Ellipse Grid.Column="0" Width="10" Height="10"
                                     Fill="{Binding SeverityBrush}"
                                     VerticalAlignment="Center"/>

                                <!-- 标题 -->
                                <TextBlock Grid.Column="1"
                                       Text="{Binding Title}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>

                                <!-- 剩余天数 -->
                                <TextBlock Grid.Column="2"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding DaysLeft, StringFormat='{}{0}天'}"/>
                                            <Setter Property="Foreground" Value="#E8D43D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter Property="Text" Value="已过期"/>
                                                    <Setter Property="Foreground" Value="#E83D3D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ========== 最近活动 ========== -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="24,20" Margin="0,0,0,6"
                x:Name="ActivityCard">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRecentActivity}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="最近活动"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,14"/>

                <ItemsControl Grid.Row="1" x:Name="ActivityList"
                              MaxHeight="300">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 严重度色点 -->
                                <Ellipse Grid.Column="0" Width="10" Height="10"
                                     Fill="{Binding SeverityBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>

                                <!-- 标题 + 类型 -->
                                <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                    <Border CornerRadius="3" Padding="4,1"
                                        Background="{Binding TypeBrush}"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeLabel}"
                                               Foreground="#FFFFFF"
                                               FontSize="10"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="13" VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- 时间 -->
                                <TextBlock Grid.Column="2"
                                       Text="{Binding TimeAgo}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="11" Opacity="0.5"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ========== 月度贡献卡片 ========== -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="8"
            Padding="24,20" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="贡献记录"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,16"/>

                <!-- 刻度线 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="1" Margin="8,0">
                        <!-- 刻度值 -->
                        <TextBlock Text="{Binding TickLabels[2]}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="10" Opacity="0.7"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding TickLabels[4]}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="10" Opacity="0.7"
                               HorizontalAlignment="Right" Margin="4,8,0,0"/>
                    </Grid>
                </Grid>

                <ItemsControl Grid.Row="1" x:Name="MonthlyBars">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CompletedCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <!-- 日期标签 -->
                                <TextBlock Grid.Column="0"
                                       Text="{Binding Label}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12" Opacity="0.7"
                                       VerticalAlignment="Center"/>

                                <!-- 柱体区域 -->
                                <Border Grid.Column="1" Margin="8,0"
                                    Background="{DynamicResource SearchBackgroundBrush}"
                                    CornerRadius="4" Height="22">
                                    <Border Background="#4CAF50" CornerRadius="4"
                                        HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                                <Binding Path="Ratio" Mode="OneWay"/>
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>

                                <!-- 数量标签 -->
                                <TextBlock Grid.Column="2"
                                       Text="{Binding Count}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="1" Text="没有动态"
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="16" Opacity="0.4"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,40,0,40">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CompletedCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ========== 开发者信息 ========== -->
        <Grid Grid.Row="1" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 用户 -->
            <Border Grid.Column="0" Margin="0,0,5,0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 头像图片框 -->
                    <Border Width="48" Height="48" CornerRadius="24"
                            Background="{DynamicResource SearchBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Image x:Name="UserAvatar"
                               Source="{Binding UserAvatarPath}"
                               Stretch="UniformToFill"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Column="1" Margin="6,6,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Michael"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1"
                                   Text="bear, give up!"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="10" VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Grid.Column="2" Margin="6,6,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Male"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1"
                                   Text="TerraGroup Usec"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="10" VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 版本标签 -->
            <Border Grid.Column="1" Margin="0,0,5,0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="版本标签" Grid.Column="0"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="VersionTagBox"
                                 Grid.Column="1"
                                 VerticalAlignment="Center" Margin="10,0,8,0"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 FontSize="13" FontWeight="SemiBold"
                                 Text="0.1.0-alpha.0"/>
                        <Button x:Name="SaveVersionButton"
                                Grid.Column="2"
                                Height="26" Width="50"
                                Click="SaveVersionButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="Background" Value="#4CAF50"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="8,3">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#43A047"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#388E3C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="保存"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主" Grid.Column="0"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                            <TextBox x:Name="VersionMajor" Grid.Column="1" Margin="2,0"
                                     Height="24" VerticalAlignment="Center"
                                     Background="{DynamicResource SearchBackgroundBrush}"
                                     BorderBrush="{DynamicResource CardBorderBrush}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     CaretBrush="{DynamicResource ForegroundBrush}"
                                     FontSize="11" Padding="2" Text="0">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background"
                                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBlock Text="次" Grid.Column="2"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                            <TextBox x:Name="VersionMinor" Grid.Column="3" Margin="2,0"
                                     Height="24" VerticalAlignment="Center"
                                     Background="{DynamicResource SearchBackgroundBrush}"
                                     BorderBrush="{DynamicResource CardBorderBrush}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     CaretBrush="{DynamicResource ForegroundBrush}"
                                     FontSize="11" Padding="2" Text="1">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background"
                                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBlock Text="补" Grid.Column="4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                            <TextBox x:Name="VersionPatch" Grid.Column="5" Margin="2,0"
                                     Height="24" VerticalAlignment="Center"
                                     Background="{DynamicResource SearchBackgroundBrush}"
                                     BorderBrush="{DynamicResource CardBorderBrush}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     CaretBrush="{DynamicResource ForegroundBrush}"
                                     FontSize="11" Padding="2" Text="0">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background"
                                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </Trigger>
