<Page x:Class="OCCMissionGoals.Pages.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1240"
      Title="帮助中心"
      Background="Transparent">

    <Page.Resources>
        <!-- 章节图标 -->
        <Style x:Key="FeatureIconBorder" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#C8E6C9"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- 链接按钮 -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#804CAF50"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#388E3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 快捷键键帽 -->
        <Style x:Key="KbdStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SearchBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- 章节卡片 -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="32,28"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- 章节标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Center" MaxWidth="800">

            <!-- ======================================================== -->
            <!--  1. 关于                                                      -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="64" Height="64" CornerRadius="14"
                            Background="#4CAF50" Margin="0,0,20,0">
                        <TextBlock Text="OMG"
                                   Foreground="#FFFFFF"
                                   FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="OCC's Mission &amp; Goals"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="任务与目标追踪工具　—　规划、追踪、完成，一步到位。"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="14" Opacity="0.5" Margin="0,4,0,0"/>
                        <TextBlock x:Name="VersionLabel"
                                   Foreground="#4CAF50"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!--  2. 功能亮点                                                    -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="功能亮点"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 版本管理 -->
                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FeatureIconBorder}">
                                <TextBlock Text="⇄" Foreground="#2E7D32" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="版本管理"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="多版本数据隔离，一键切换迭代"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="11" Opacity="0.5" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- 条目追踪 -->
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FeatureIconBorder}">
                                <TextBlock Text="☑" Foreground="#2E7D32" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="条目追踪"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="创建、编辑、完成目标条目，按严重程度分类"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="11" Opacity="0.5" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- 进度可视化 -->
                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FeatureIconBorder}">
                                <TextBlock Text="▤" Foreground="#2E7D32" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="进度可视化"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="实时统计完成率、严重度分布、趋势变化"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="11" Opacity="0.5" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- 扩展中心 -->
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FeatureIconBorder}">
                                <TextBlock Text="🧩" Foreground="#2E7D32" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="扩展中心"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="安装主题、工具、集成等扩展，自由定制功能"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="11" Opacity="0.5" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- 命令行接口 -->
                        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FeatureIconBorder}">
                                <TextBlock Text=">" Foreground="#2E7D32" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="命令行接口"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="CLI 批量操作，输出 JSON，可集成到脚本/CI"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="11" Opacity="0.5" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- 深浅主题 -->
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FeatureIconBorder}">
                                <TextBlock Text="☀" Foreground="#2E7D32" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="深浅主题"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="自动跟随系统明暗模式，护眼舒适"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="11" Opacity="0.5" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- 数据文件管理 -->
                        <Grid Grid.Row="3" Grid.Column="0" Margin="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FeatureIconBorder}">
                                <TextBlock Text="📁" Foreground="#2E7D32" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="JSON 数据文件"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="纯 JSON 存储，易于版本控制和手动编辑"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="11" Opacity="0.5" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- GitHub 集成 -->
                        <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FeatureIconBorder}">
                                <TextBlock Text="⬡" Foreground="#2E7D32" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="GitHub 集成"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="推送项目数据到仓库，版本文件历史追溯"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="11" Opacity="0.5" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!--  3. 界面导航                                                    -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="界面导航"/>

                    <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="13" TextWrapping="Wrap"
                               Margin="0,0,0,16">
                        主窗口分为四个功能页签，通过顶部<Bold>页签栏</Bold>或
                        <Bold>Ctrl</Bold> + 侧边栏按钮切换：
                    </TextBlock>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="📋 更新日志"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="项目仪表盘：进度总览、严重度分布、即将到期、最近活动"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="12" Opacity="0.6" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="📝 未完成的条目"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="按版本分组展示所有未完成条目，支持编辑、标记完成、删除"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="12" Opacity="0.6" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="✅ 完成的条目"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="查看已完成条目列表，支持撤销完成和归档操作"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="12" Opacity="0.6" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="🧩 扩展"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="扩展中心：浏览、搜索、安装/卸载扩展"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="12" Opacity="0.6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!--  4. 键盘快捷键                                                  -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="键盘快捷键"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KbdStyle}" Margin="0,0,8,8">
                            <TextBlock Text="Ctrl" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </Border>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,0,8">
                            + 侧边栏切换按钮 → 切到对应页签
                        </TextBlock>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KbdStyle}" Margin="0,0,8,8">
                            <TextBlock Text="Ctrl" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,0,8">
                            按住不放 → 展开左侧工具栏和顶部菜单栏
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!--  5. 命令行接口                                                  -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="命令行接口 (CLI)"/>

                    <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12">
                        在项目目录或通过 <Bold>OCCMissionGoals.exe</Bold> 直接调用，
                        所有输出为 <Bold>JSON</Bold> 格式，可集成到脚本和 CI 流程。
                    </TextBlock>

                    <!-- 基础用法 -->
                    <Border Background="{DynamicResource SearchBackgroundBrush}"
                            CornerRadius="6" Padding="14,12" Margin="0,0,0,8">
                        <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="12" FontFamily="Consolas"
                                   TextWrapping="Wrap">
                            OCCMissionGoals.exe project list
                            OCCMissionGoals.exe project info -p "项目名"

                            OCCMissionGoals.exe version list
                            OCCMissionGoals.exe version current

                            OCCMissionGoals.exe entry list --type u
                            OCCMissionGoals.exe entry add --title "标题" --severity General
                            OCCMissionGoals.exe entry edit 1 --brief "摘要"
                            OCCMissionGoals.exe entry done 3
                            OCCMissionGoals.exe entry delete 5 --type u
                        </TextBlock>
                    </Border>

                    <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="12" Opacity="0.5" TextWrapping="Wrap" Margin="0,0,0,4">
                        <Bold>严重程度：</Bold>Fatal | Severe | General | Patch | Update
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="12" Opacity="0.5" TextWrapping="Wrap" Margin="0,0,0,4">
                        <Bold>全局选项：</Bold>-p, --project · -v, --version
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="12" Opacity="0.5" TextWrapping="Wrap">
                        <Bold>输出：</Bold>成功数据 → stdout (JSON) · 错误/帮助 → stderr
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!--  6. 技术栈                                                      -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="技术栈"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="框架"
                                   Foreground="{DynamicResource ForegroundBrush}" Opacity="0.5"
                                   FontSize="12" Margin="0,0,20,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text=".NET 8 · WPF"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="数据"
                                   Foreground="{DynamicResource ForegroundBrush}" Opacity="0.5"
                                   FontSize="12" Margin="0,0,20,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="JSON 文件存储 · 多版本隔离"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="架构"
                                   Foreground="{DynamicResource ForegroundBrush}" Opacity="0.5"
                                   FontSize="12" Margin="0,0,20,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="MVVM · Service 层解耦 · CLI 复用 Service"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!--  7. 反馈与链接                                                  -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="反馈与链接"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource LinkButton}" Content="🔗  GitHub 仓库"
                                Click="GitHubRepo_Click"/>
                        <Button Style="{StaticResource LinkButton}" Content="🐛  提交 Issue"
                                Click="GitHubIssue_Click" Margin="16,0,0,0"/>
                        <Button Style="{StaticResource LinkButton}" Content="📖  查看许可证"
                                Click="License_Click" Margin="16,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!--  页脚                                                        -->
            <!-- ======================================================== -->
            <TextBlock HorizontalAlignment="Center"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="11" Opacity="0.3" Margin="0,0,0,16">
                OCC's Mission &amp; Goals　·　OCC Toolchain　· ♥ Love For I-AM-SOLO
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</Page>
