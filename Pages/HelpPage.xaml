                    <!-- ==================== 命令行 ==================== -->
                    <Border x:Name="Section_CLI"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0">
                        <StackPanel>
                            <TextBlock Text="命令行（CLI）"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12">
                                OCCMissionGoals.exe 命令行接口
                            </TextBlock>

                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12">
                                程序在启动时检测命令行参数：带参数启动进入 CLI 模式（控制台），
                                无参数启动进入 GUI 模式。CLI 所有输出为标准 JSON，错误输出至 stderr，
                                适合 AI / 脚本 / CI 集成。
                            </TextBlock>

                            <!-- 基本用法 -->
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6">
                                基本用法
                            </TextBlock>
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="12,8" Margin="6,0,0,12">
                                <TextBlock FontSize="13" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.7">
                                    <Run Text="OCCMissionGoals.exe [-p &lt;项目&gt;] &lt;命令&gt; [参数]" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>

                            <!-- 条目命令 -->
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,8">
                                条目操作
                            </TextBlock>

                            <Grid Margin="6,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -a, --add
                                </TextBlock>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                    添加条目。数据格式为 JSON 或简化的 key=value 语法。
                                </TextBlock>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -c, --check
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                    查看条目详情（如 -c 001000001），返回完整 JSON。
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -d, --done
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                    将条目标记为已完成，自动记录完成日期。
                                </TextBlock>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -u, --undone
                                </TextBlock>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                    将已完成条目恢复为未完成状态。
                                </TextBlock>

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -D, --delete
                                </TextBlock>
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                    删除条目（不可恢复）。
                                </TextBlock>

                                <TextBlock Grid.Row="5" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -f, --favorited
                                </TextBlock>
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                    收藏 / 取消收藏。用法：-f &lt;编号&gt; true|false
                                </TextBlock>

                                <TextBlock Grid.Row="6" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -l, --list
                                </TextBlock>
                                <TextBlock Grid.Row="6" Grid.Column="1"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                    列出当前项目的所有条目（未完成 + 已完成），JSON 数组。
                                </TextBlock>
                            </Grid>

                            <!-- 版本命令 -->
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,8">
                                版本操作
                            </TextBlock>

                            <Grid Margin="6,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -v &lt;版本号&gt;
                                </TextBlock>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                    切换到指定版本，后续操作在该版本的数据文件上进行。
                                </TextBlock>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -v Iterate
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                    版本迭代：当前版本号的迭代编号 +1（如 alpha.0 → alpha.1）。
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -v Delete &lt;版本&gt;
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                    删除指定版本的数据文件。不能删除当前版本。
                                </TextBlock>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -v Archive &lt;版本&gt;
                                </TextBlock>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                    归档指定版本 → versions/archive/ 目录。需版本内全部条目均已完成，不能归档当前版本。
                                </TextBlock>
                            </Grid>

                            <!-- 全局选项 -->
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,8">
                                全局选项
                            </TextBlock>

                            <Grid Margin="6,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -p, --project
                                </TextBlock>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                    指定目标项目（按目录名或 project.json 中的项目名匹配）。
                                </TextBlock>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -v &lt;版本号&gt;
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                    配合条目命令时，指定操作的目标版本。
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    help, -h, --help
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                    打印帮助信息。
                                </TextBlock>
                            </Grid>

                            <!-- 添加条目示例 -->
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6">
                                -a 数据格式示例
                            </TextBlock>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,8">
                                支持标准 JSON 或用 = 代替 : 的简化语法（字段名可不加引号）：
                            </TextBlock>
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="12,10" Margin="6,0,0,12">
                                <TextBlock FontSize="11" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" LineHeight="18" TextWrapping="Wrap">
                                    <Run Text="OCCMissionGoals.exe -a {Title=&quot;修复Bug&quot;, Severity=&quot;Fatal&quot;, Brief=&quot;...&quot;, Detail=&quot;...&quot;, IsFavorited=false, Version=&quot;0.1.0&quot;, Type=[&quot;Bug&quot;], RelatedFiles={&quot;P:\auth.cs&quot;=[10,5,&quot;Login&quot;]}}"/>
                                </TextBlock>
                            </Border>

                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12">
                                必填字段仅 Title。Severity 默认 General。Type 为字符串数组，
                                RelatedFiles 为路径 → [行, 列, 函数] 的映射。
                            </TextBlock>

                            <Separator Margin="0,6,0,6" Opacity="0.2"/>

                            <!-- 输出格式 -->
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6">
                                输出格式
                            </TextBlock>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="• 正常输出 JSON（stdout），带缩进便于阅读&#x0a;"/>
                                <Run Text="• 错误信息输出至 stderr&#x0a;"/>
                                <Run Text="• 返回码：0 = 成功，非 0 = 失败&#x0a;"/>
                                <Run Text="• 条目字段：index, id, title, severity, severityLabel, brief, detail, deadline, completedAt, changeDemand, isFavorited, version, relatedFiles"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
