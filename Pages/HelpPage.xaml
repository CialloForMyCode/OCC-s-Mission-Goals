<Page x:Class="OCCMissionGoals.Pages.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loc="clr-namespace:OCCMissionGoals"
      mc:Ignorable="d"
      d:DesignHeight="5667" d:DesignWidth="1240"
      Title="HelpPage"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border CornerRadius="8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                Padding="24,16" Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc &quot;帮助 / 使用指南&quot;}"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}"
                       Margin="8,0,0,0"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====== 侧边导航 ====== -->
            <Border Grid.Column="0"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Padding="10,12"
                    VerticalAlignment="Top"
                    Margin="0,0,8,0">
                <StackPanel>
                    <Button x:Name="Nav_Overview"
                            Content="{loc:Loc &quot;概述&quot;}" Tag="Overview"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"
                            FontWeight="Bold"/>

                    <Separator Margin="6,8,6,6" Opacity="0.3"/>

                    <Button x:Name="Nav_Dashboard"
                            Content="{loc:Loc &quot;仪表盘&quot;}" Tag="Dashboard"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_UnDone"
                            Content="{loc:Loc &quot;未完成条目&quot;}" Tag="UnDone"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_Done"
                            Content="{loc:Loc &quot;已完成条目&quot;}" Tag="Done"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_Expand"
                            Content="{loc:Loc &quot;扩展中心&quot;}" Tag="Expand"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>

                    <Separator Margin="6,8,6,6" Opacity="0.3"/>

                    <Button x:Name="Nav_Severity"
                            Content="{loc:Loc &quot;严重程度&quot;}" Tag="Severity"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_ChangeDemand"
                            Content="{loc:Loc &quot;变更需求&quot;}" Tag="ChangeDemand"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_Version"
                            Content="{loc:Loc &quot;版本号&quot;}" Tag="Version"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_Type"
                            Content="{loc:Loc &quot;条目类型&quot;}" Tag="Type"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_RelatedFiles"
                            Content="{loc:Loc &quot;关联文件&quot;}" Tag="RelatedFiles"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>

                    <Separator Margin="6,8,6,6" Opacity="0.3"/>

                    <Button x:Name="Nav_Shortcuts"
                            Content="{loc:Loc &quot;快捷键&quot;}" Tag="Shortcuts"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"/>
                    <Button x:Name="Nav_Search"
                            Content="{loc:Loc &quot;搜索&quot;}" Tag="Search"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"/>
                    <Button x:Name="Nav_Project"
                            Content="{loc:Loc &quot;项目管理&quot;}" Tag="Project"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"/>
                    <Button x:Name="Nav_CLI"
                            Content="{loc:Loc &quot;命令行&quot;}" Tag="CLI"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- ====== 内容区 ====== -->
            <ScrollViewer x:Name="ContentScroll"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="ContentScroll_ScrollChanged">
                <StackPanel>

                    <!-- ==================== 概述 ==================== -->
                    <Border x:Name="Section_Overview"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc &quot;概述&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;OCC's Mission &amp; Goals 是一款面向开发者和项目维护者的轻量级任务跟踪工具。以「条目（Mission）」为基本单位，每一条目记录一个独立的目标任务，支持严重程度分级、截止日期、版本归属、关联文件追踪以及多项目切换。&quot;}"
                                       FontSize="13" Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" LineHeight="22" Opacity="0.7"
                                       Margin="0,0,0,10"/>

                            <!-- 核心概念 Grid -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Padding="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc &quot;条目 (Mission)&quot;}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{loc:Loc &quot;最基本的工作单元，包含标题、简要、详情、严重程度、截止日期、变更需求、类型标签等字段。&quot;}"
                                                   FontSize="12" LineHeight="20" Opacity="0.5"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Padding="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc &quot;版本 (Version)&quot;}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{loc:Loc &quot;条目按版本号分组管理。版本格式为「主.次.补丁-标签.迭代」，如 0.1.0-alpha.0。&quot;}"
                                                   FontSize="12" LineHeight="20" Opacity="0.5"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc &quot;项目 (Project)&quot;}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{loc:Loc &quot;支持多项目目录，每个项目有独立的 data.json 和 project.json，便于 Git 版本控制与团队协作。&quot;}"
                                                   FontSize="12" LineHeight="20" Opacity="0.5"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Separator Margin="0,14,0,6" Opacity="0.2"/>

                            <TextBlock Text="{loc:Loc &quot;应用结构&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Margin="6,0,0,0">
                                <Run Text="{loc:Loc &quot;• 导航栏      仪表盘 / 未完成条目 / 已完成条目 / 扩展中心 / 帮助&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 状态栏      项目切换下拉框&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 工具栏      按住 Ctrl 显示：新建条目 / 搜索 / 排序 / 数据统计 / CLI 等快捷操作&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 数据存储    所有条目以 JSON 格式保存在各项目目录下&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 仪表盘 ==================== -->
                    <Border x:Name="Section_Dashboard"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc &quot;仪表盘（LogPage）&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;项目总览与数据统计中心&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <!-- 总进度 -->
                            <TextBlock Text="{loc:Loc &quot;总进度卡片&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;显示当前项目的条目完成率：已完成数 / 总数，配百分比进度条。一目了然地反映项目整体推进情况。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <!-- 严重程度分布 -->
                            <TextBlock Text="{loc:Loc &quot;严重程度分布&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;以可视化图表展示五个严重等级（致命/严重/一般/补丁/更新）各自的条目数量，帮助快速识别项目风险分布。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <!-- 即将到期 -->
                            <TextBlock Text="{loc:Loc &quot;即将到期&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;列出 7 天内截止的未完成条目，按到期日远近排列。点击可直接跳转到对应条目。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <!-- 最近活动 -->
                            <TextBlock Text="{loc:Loc &quot;最近活动时间线&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;按时间倒序展示最近完成的条目，附带完成日期，方便追踪团队最新进展。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <!-- 贡献记录 -->
                            <TextBlock Text="{loc:Loc &quot;贡献记录柱状图&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;按日期汇总完成数量，以柱状图直观展示每日贡献趋势，支持切换时间范围和查看明细。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                        </StackPanel>
                    </Border>

                    <!-- ==================== 未完成条目 ==================== -->
                    <Border x:Name="Section_UnDone"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc &quot;未完成条目（UnDonePage）&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;管理所有未完成的目标任务&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;核心功能&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>

                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc &quot;• 版本分组折叠 —— 条目按版本号分组，每组可折叠 / 展开，标题显示版本名和条目数&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 收藏加星 —— 点击星标按钮收藏条目，收藏的条目在列表中高亮显示&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 排序 —— 按严重程度（高→低）、截止日期（近→远）、版本号（升/降）以及仅收藏排序&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 搜索过滤 —— 顶部搜索框输入关键词实时过滤，支持前缀切换匹配范围：Text:内容、Tag:标签、Setting:设置（项目设置/主题/数据统计）、File:文件路径、Date:日期；不带前缀时按文字匹配，Setting: 下按回车执行设置项&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 展开详情 —— 点击「详情」按钮展开条目完整信息面板，包括详细描述和关联文件表格&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 编辑条目 —— 点击编辑按钮打开编辑窗口，可修改所有字段：标题、简要、详情、严重程度、截止日期、变更需求、类型标签、关联文件&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 完成条目 —— 将条目标记为已完成，自动记录完成时间，条目从本页移至已完成页面&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 删除条目 —— 移除不需要的条目（不可恢复）&quot;}"/>
                            </TextBlock>

                            <Separator Margin="0,10,0,6" Opacity="0.2"/>

                            <TextBlock Text="{loc:Loc &quot;条目字段一览&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc &quot;标题 —— 必填，条目的简短名称&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;简要 —— 可选，一句话描述&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;详情 —— 可选，Markdown 格式的完整描述文本&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;严重程度 —— 致命 / 严重 / 一般 / 补丁 / 更新&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;截止日期 —— 可选，过期条目以红色高亮提醒&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;变更需求 —— 可选整数，表示变更复杂度和影响范围&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;类型标签 —— 可选多选，如 bug、feature、refactor 等&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;关联文件 —— 可选多条，每条含路径、函数名、行号、列号&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;版本号 —— 条目创建时自动归属当前版本，不可手动修改&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 已完成条目 ==================== -->
                    <Border x:Name="Section_Done"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc &quot;已完成条目（DonePage）&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;查看和管理已完成的条目&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;核心功能&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc &quot;• 整体结构与未完成页面一致 —— 版本分组、搜索过滤、详情展开等&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 撤销完成 —— 将已完成条目恢复为未完成状态，条目移回 UnDonePage&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 按版本归档 —— 仅当版本内所有条目均已完成时，才显示归档按钮。归档将导出 Markdown 并删除版本数据文件&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 编辑 —— 与未完成页面相同的编辑功能&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 删除 —— 移除已完成条目&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 完成日期 —— 每条目卡片额外显示「完成于」日期信息&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 扩展中心 ==================== -->
                    <Border x:Name="Section_Expand"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc &quot;扩展中心（ExpandPage）&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;插件与功能扩展管理&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;核心功能&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc &quot;• 分类浏览 —— 按插件类别分组展示可用扩展&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 搜索过滤 —— 顶部搜索框实时过滤插件列表&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 安装 / 卸载 —— 一键安装或卸载扩展插件&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 详情查看 —— 点击插件卡片查看功能说明和使用方式&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 严重程度 ==================== -->
                    <Border x:Name="Section_Severity"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc &quot;严重程度（Severity）&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;条目优先级分级体系&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;严重程度从高到低共分五级，每级以对应颜色标识：&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,10"/>

                            <WrapPanel Margin="6,0,0,14">
                                    <!-- Fatal -->
                                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,8,8"
                                            Background="#E83D3D">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc &quot;致命 Fatal&quot;}"
                                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Loc &quot;阻断级问题，必须立即处理&quot;}"
                                                       Foreground="#DDFFFFFF" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Severe -->
                                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,8,8"
                                            Background="#E88D3D">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc &quot;严重 Severe&quot;}"
                                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Loc &quot;重要问题，需尽快解决&quot;}"
                                                       Foreground="#DDFFFFFF" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- General -->
                                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,8,8"
                                            Background="#E8D43D">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc &quot;一般 General&quot;}"
                                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Loc &quot;常规任务和需求，默认等级&quot;}"
                                                       Foreground="#DDFFFFFF" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Patch -->
                                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,8,8"
                                            Background="#3D9DE8">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc &quot;补丁 Patch&quot;}"
                                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Loc &quot;小幅修改和修复，低优先级&quot;}"
                                                       Foreground="#DDFFFFFF" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Update -->
                                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,8,8"
                                            Background="#4CAF50">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc &quot;更新 Update&quot;}"
                                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Loc &quot;功能更新和体验优化，最低优先级&quot;}"
                                                       Foreground="#DDFFFFFF" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                            <TextBlock Text="{loc:Loc &quot;严重程度直接影响列表默认排序（高→低），同时在仪表盘分布图表中可视化。编辑条目时可随时调整。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 变更需求 ==================== -->
                    <Border x:Name="Section_ChangeDemand"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc &quot;变更需求（ChangeDemand）&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;任务变更影响度量&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;变更需求是一个可选的整数字段，用于量化条目所涉及的变更复杂度和影响范围。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,10"/>

                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc &quot;• 数值越大表示变更越复杂、影响范围越广&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 支持按变更需求升序或降序排列条目列表&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 典型用法：0 = 无变更 / 1-3 = 小范围调整 / 4-6 = 中等重构 / 7+ = 大规模变更&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 编辑条目时在编辑窗口设置&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 版本号 ==================== -->
                    <Border x:Name="Section_Version"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc &quot;版本号（Version）&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;版本管理体系&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;版本号采用五段式语义化格式：&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,10"/>

                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="12,8" Margin="6,0,0,10">
                                <TextBlock FontSize="14" FontWeight="SemiBold"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.7">
                                    <Run Text="{loc:Loc &quot;主版本.次版本.补丁版本-标签.迭代编号&quot;}" FontWeight="Bold"/>
                                    <Run Text="{loc:Loc &quot;      例如: 0.1.0-alpha.0&quot;}"/>
                                </TextBlock>
                            </Border>

                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc &quot;• 每个条目归属于一个版本，创建时自动设为当前版本&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 通过「版本管理」弹窗新建、打开或删除版本，新条目将归属当前版本&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 使用命令 -v Iterate 将迭代编号 +1（如 alpha.0 → alpha.1）&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 条目列表按版本号分组展示，支持折叠和展开各版本&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 已完成条目在版本内全部完成后才可归档，保持视图整洁&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 条目类型 ==================== -->
                    <Border x:Name="Section_Type"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc &quot;条目类型（Type）&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;分类标签系统&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc &quot;• 每个条目可附带一个或多个类型标签（多选）&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 类型标签在项目配置（project.json）中统一定义和管理&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 常见标签：bug（缺陷）、feature（新功能）、refactor（重构）、docs（文档）、test（测试）、chore（杂项）&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 类型标签在条目卡片上以标签形式展示，便于快速识别&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 编辑条目时在编辑窗口勾选或取消类型标签&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 关联文件 ==================== -->
                    <Border x:Name="Section_RelatedFiles"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc &quot;关联文件（RelatedFiles）&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;代码文件引用追踪&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;每个条目可关联多条代码文件引用，用于记录与任务相关的源代码位置。每条引用包含以下字段：&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,10"/>

                            <Grid Margin="6,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{loc:Loc &quot;路径 Path&quot;}"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0.6"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{loc:Loc &quot;关联的源代码文件路径（必填）&quot;}"
                                           FontSize="12" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{loc:Loc &quot;函数 Function&quot;}"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0.6"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{loc:Loc &quot;相关的函数或方法名（可选）&quot;}"
                                           FontSize="12" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="{loc:Loc &quot;行号 Line&quot;}"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0.6"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{loc:Loc &quot;精确的代码行号（可选）&quot;}"
                                           FontSize="12" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="{loc:Loc &quot;列号 Column&quot;}"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0.6"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{loc:Loc &quot;精确的代码列号（可选）&quot;}"
                                           FontSize="12" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </Grid>

                            <TextBlock Text="{loc:Loc &quot;在条目详情面板中，「相关文件」表格展示所有关联引用。编辑条目时可添加、修改或删除关联文件。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 快捷键 ==================== -->
                    <Border x:Name="Section_Shortcuts"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc &quot;快捷键&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;键盘快捷操作&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <Grid Margin="6,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition Height="24"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Padding="8,2" CornerRadius="3"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{loc:Loc &quot;按住 Ctrl&quot;}" VerticalAlignment="Center"
                                               FontSize="11" FontFamily="Consolas"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Opacity="0.6"/>
                                </Border>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="{loc:Loc &quot;显示底部工具栏和侧边栏选项卡标签&quot;}"
                                           FontSize="12" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>

                                <Border Grid.Row="2" Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Padding="8,2" CornerRadius="3"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{loc:Loc &quot;松开 Ctrl&quot;}" VerticalAlignment="Center"
                                               FontSize="11" FontFamily="Consolas"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Opacity="0.6"/>
                                </Border>
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Text="{loc:Loc &quot;自动收起工具栏和侧边栏，最大化内容视野&quot;}"
                                           FontSize="12" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>

                            <Separator Margin="0,12,0,6" Opacity="0.2"/>

                            <TextBlock Text="{loc:Loc &quot;底部工具栏提供快速操作入口：新建条目、搜索过滤、排序切换、数据统计、CLI 命令行模式等。按住 Ctrl 键即可查看和使用。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 搜索 ==================== -->
                    <Border x:Name="Section_Search"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc &quot;搜索&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;查找条目与设置的完整指南&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;基本用法&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc &quot;搜索框位于窗口顶部工具栏中央，始终可见。输入关键词即可实时过滤当前列表页面，同时弹出搜索结果板；点击结果可跳转，或按回车直接执行首条结果。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;搜索模式&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc &quot;支持前缀语法切换匹配范围；不加前缀时默认按文字模式匹配。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12">
                                <Run Text="{loc:Loc &quot;• Text: / 文字: —— 标题、简要、详情&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• Tag: / 标签: —— 类型标签&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• Setting: / 设置: / 配置: —— 设置（全局搜索）&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• File: / 文件: —— 关联文件路径与函数名&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• Date: / 日期: —— 日期（yyyy-MM-dd）&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• Plugins: / 插件: —— 扩展中心插件（全局搜索）&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• Expand: / 扩展: / 已安装: —— 已安装的插件（全局搜索）&quot;}"/>
                            </TextBlock>

                            <TextBlock Text="{loc:Loc &quot;设置搜索&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc &quot;Setting: 模式不会筛选条目列表，而是在结果板中列出设置快捷项，且关键词为空时也会显示全部设置项。点击即可直接执行：切换深/浅色主题、打开项目设置、打开数据统计。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;插件搜索&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc &quot;Plugins: 搜索扩展中心全部插件，Expand: 只搜索已安装插件。两者都不筛选条目列表，结果在搜索板中展示，关键词为空时列出全部对应插件；点击结果跳转到扩展中心。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;结果板&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc &quot;• 条目结果带类型标签（未完成 / 已完成），点击「跳转」定位到对应条目。&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 空输入时显示「按模式搜索」引导，点击前缀按钮可快速填入前缀。&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 点击搜索框外部关闭结果板。&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 项目管理 ==================== -->
                    <Border x:Name="Section_Project"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc &quot;项目管理&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;多项目目录与数据管理&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;项目目录&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc &quot;支持多项目目录，每个项目有独立的文件夹。右上角下拉框可随时切换当前项目。各项目之间的条目和版本完全独立，互不影响。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;数据文件&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12">
                                <Run Text="{loc:Loc &quot;• data.json —— 存储所有条目数据（未完成 + 已完成），JSON 数组格式&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• project.json —— 存储项目元数据：项目名称、类型标签定义、版本号等&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 文件均为纯文本 JSON，可直接用 Git 进行版本追踪和团队协作&quot;}"/>
                            </TextBlock>

                            <TextBlock Text="{loc:Loc &quot;CLI 命令行模式&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc &quot;支持通过命令行进行脚本化操作，适用于 CI/CD 集成和批量处理场景。点击底部工具栏的 CLI 按钮或使用命令行参数启动。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 命令行 ==================== -->
                    <Border x:Name="Section_CLI"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc &quot;命令行（CLI）&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc &quot;OCCMissionGoals.exe 命令行接口&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc &quot;程序在启动时检测命令行参数：带参数启动进入 CLI 模式（控制台），无参数启动进入 GUI 模式。CLI 所有输出为标准 JSON，错误输出至 stderr，适合 AI / 脚本 / CI 集成。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <!-- 基本用法 -->
                            <TextBlock Text="{loc:Loc &quot;基本用法&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="12,8" Margin="6,0,0,12">
                                <TextBlock FontSize="13" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.7">
                                    <Run Text="{loc:Loc &quot;OCCMissionGoals.exe [-p &lt;项目&gt;] &lt;命令&gt; [参数]&quot;}" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>

                            <!-- 条目命令 -->
                            <TextBlock Text="{loc:Loc &quot;条目操作&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="6,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -a, --add
                                </TextBlock>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{loc:Loc &quot;添加条目。数据格式为 JSON 或简化的 key=value 语法。&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -c, --check
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{loc:Loc &quot;查看条目详情（如 -c 001000001），返回完整 JSON。&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -d, --done
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{loc:Loc &quot;将条目标记为已完成，自动记录完成日期。&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -u, --undone
                                </TextBlock>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{loc:Loc &quot;将已完成条目恢复为未完成状态。&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -D, --delete
                                </TextBlock>
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Text="{loc:Loc &quot;删除条目（不可恢复）。&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="5" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -f, --favorited
                                </TextBlock>
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Text="{loc:Loc &quot;收藏 / 取消收藏。用法：-f &lt;编号&gt; true|false&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="6" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -l, --list
                                </TextBlock>
                                <TextBlock Grid.Row="6" Grid.Column="1"
                                           Text="{loc:Loc &quot;列出当前项目的所有条目（未完成 + 已完成），JSON 数组。&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>

                            <!-- 版本命令 -->
                            <TextBlock Text="{loc:Loc &quot;版本操作&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="6,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{loc:Loc &quot;-v &lt;版本号&gt;&quot;}"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{loc:Loc &quot;切换到指定版本，后续操作在该版本的数据文件上进行。&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -v Iterate
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{loc:Loc &quot;版本迭代：当前版本号的迭代编号 +1（如 alpha.0 → alpha.1）。&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="{loc:Loc &quot;-v Delete &lt;版本&gt;&quot;}"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{loc:Loc &quot;删除指定版本的数据文件。不能删除当前版本。&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="{loc:Loc &quot;-v Archive &lt;版本&gt;&quot;}"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{loc:Loc &quot;归档指定版本 → versions/archive/ 目录。需版本内全部条目均已完成，不能归档当前版本。&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>

                            <!-- 全局选项 -->
                            <TextBlock Text="{loc:Loc &quot;全局选项&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="6,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -p, --project
                                </TextBlock>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{loc:Loc &quot;指定目标项目（按目录名或 project.json 中的项目名匹配）。&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{loc:Loc &quot;-v &lt;版本号&gt;&quot;}"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{loc:Loc &quot;配合条目命令时，指定操作的目标版本。&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    help, -h, --help
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{loc:Loc &quot;打印帮助信息。&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>

                            <!-- 添加条目示例 -->
                            <TextBlock Text="{loc:Loc &quot;-a 数据格式示例&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc &quot;支持标准 JSON 或用 = 代替 : 的简化语法（字段名可不加引号）：&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,8"/>
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="12,10" Margin="6,0,0,12">
                                <TextBlock FontSize="11" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" LineHeight="18" TextWrapping="Wrap">
                                    <Run Text="OCCMissionGoals.exe -a {Title=&quot;"/><Run Text="{loc:Loc &quot;修复Bug&quot;}"/><Run Text="&quot;, Severity=&quot;Fatal&quot;, Brief=&quot;...&quot;, Detail=&quot;...&quot;, IsFavorited=false, Version=&quot;0.1.0&quot;, Type=[&quot;Bug&quot;], RelatedFiles={&quot;P:\auth.cs&quot;=[10,5,&quot;Login&quot;]}}"/>
                                </TextBlock>
                            </Border>

                            <TextBlock Text="{loc:Loc &quot;必填字段仅 Title。Severity 默认 General。Type 为字符串数组，RelatedFiles 为路径 → [行, 列, 函数] 的映射。&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <Separator Margin="0,6,0,6" Opacity="0.2"/>

                            <!-- 输出格式 -->
                            <TextBlock Text="{loc:Loc &quot;输出格式&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc &quot;• 正常输出 JSON（stdout），带缩进便于阅读&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 错误信息输出至 stderr&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 返回码：0 = 成功，非 0 = 失败&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc &quot;• 条目字段：index, id, title, severity, severityLabel, brief, detail, deadline, completedAt, changeDemand, isFavorited, version, relatedFiles&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
