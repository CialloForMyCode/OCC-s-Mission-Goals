<Page x:Class="OCCMissionGoals.Pages.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="5667" d:DesignWidth="1240"
      Title="HelpPage"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border CornerRadius="8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                Padding="24,16" Margin="0,0,0,8">
            <TextBlock Text="帮助 / 使用指南"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}"
                       Margin="8,0,0,0"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====== 侧边导航 ====== -->
            <Border Grid.Column="0"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Padding="10,12"
                    VerticalAlignment="Top"
                    Margin="0,0,8,0">
                <StackPanel>
                    <Button x:Name="Nav_Overview"
                            Content="概述" Tag="Overview"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"
                            FontWeight="Bold"/>

                    <Separator Margin="6,8,6,6" Opacity="0.3"/>

                    <Button x:Name="Nav_Dashboard"
                            Content="仪表盘" Tag="Dashboard"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_UnDone"
                            Content="未完成条目" Tag="UnDone"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_Done"
                            Content="已完成条目" Tag="Done"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_Expand"
                            Content="扩展中心" Tag="Expand"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>

                    <Separator Margin="6,8,6,6" Opacity="0.3"/>

                    <Button x:Name="Nav_Severity"
                            Content="严重程度" Tag="Severity"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_ChangeDemand"
                            Content="变更需求" Tag="ChangeDemand"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_Version"
                            Content="版本号" Tag="Version"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_Type"
                            Content="条目类型" Tag="Type"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_RelatedFiles"
                            Content="关联文件" Tag="RelatedFiles"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>

                    <Separator Margin="6,8,6,6" Opacity="0.3"/>

                    <Button x:Name="Nav_Shortcuts"
                            Content="快捷键" Tag="Shortcuts"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"/>
                    <Button x:Name="Nav_Project"
                            Content="项目管理" Tag="Project"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"/>
                    <Button x:Name="Nav_CLI"
                            Content="命令行" Tag="CLI"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- ====== 内容区 ====== -->
            <ScrollViewer x:Name="ContentScroll"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="ContentScroll_ScrollChanged">
                <StackPanel>

                    <!-- ==================== 概述 ==================== -->
                    <Border x:Name="Section_Overview"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="概述"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock FontSize="13" Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" LineHeight="22" Opacity="0.7"
                                       Margin="0,0,0,10">
                                OCC's Mission &amp; Goals 是一款面向开发者和项目维护者的轻量级任务跟踪工具。
                                以「条目（Mission）」为基本单位，每一条目记录一个独立的目标任务，
                                支持严重程度分级、截止日期、版本归属、关联文件追踪以及多项目切换。
                            </TextBlock>

                            <!-- 核心概念 Grid -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Padding="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="条目 (Mission)"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   TextWrapping="Wrap">
                                            最基本的工作单元，包含标题、简要、详情、
                                            严重程度、截止日期、变更需求、类型标签等字段。
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Padding="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="版本 (Version)"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   TextWrapping="Wrap">
                                            条目按版本号分组管理。版本格式为
                                            「主.次.补丁-标签.迭代」，如 0.1.0-alpha.0。
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2">
                                    <StackPanel>
                                        <TextBlock Text="项目 (Project)"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   TextWrapping="Wrap">
                                            支持多项目目录，每个项目有独立的
                                            data.json 和 project.json，
                                            便于 Git 版本控制与团队协作。
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Separator Margin="0,14,0,6" Opacity="0.2"/>

                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6">
                                应用结构
                            </TextBlock>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Margin="6,0,0,0">
                                <Run Text="• 导航栏      仪表盘 / 未完成条目 / 已完成条目 / 扩展中心 / 帮助&#x0a;"/>
                                <Run Text="• 状态栏      项目切换下拉框&#x0a;"/>
                                <Run Text="• 工具栏      按住 Ctrl 显示：新建条目 / 搜索 / 排序 / 推送 / CLI 等快捷操作&#x0a;"/>
                                <Run Text="• 数据存储    所有条目以 JSON 格式保存在各项目目录下"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 仪表盘 ==================== -->
                    <Border x:Name="Section_Dashboard"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="仪表盘（LogPage）"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12">
                                项目总览与数据统计中心
                            </TextBlock>

                            <!-- 总进度 -->
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4">
                                总进度卡片
                            </TextBlock>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12">
                                显示当前项目的条目完成率：已完成数 / 总数，配百分比进度条。
                                一目了然地反映项目整体推进情况。
                            </TextBlock>

                            <!-- 严重程度分布 -->
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4">
                                严重程度分布
                            </TextBlock>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12">
                                以可视化图表展示五个严重等级（致命/严重/一般/补丁/更新）各自的条目数量，
                                帮助快速识别项目风险分布。
                            </TextBlock>

                            <!-- 即将到期 -->
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4">
                                即将到期
                            </TextBlock>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12">
                                列出 7 天内截止的未完成条目，按到期日远近排列。
                                点击可直接跳转到对应条目。
                            </TextBlock>

                            <!-- 最近活动 -->
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4">
                                最近活动时间线
                            </TextBlock>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12">
                                按时间倒序展示最近完成的条目，附带完成日期，
                                方便追踪团队最新进展。
                            </TextBlock>

                            <!-- 贡献记录 -->
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4">
                                贡献记录柱状图
                            </TextBlock>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12">
                                按日期汇总完成数量，以柱状图直观展示每日贡献趋势，
                                支持切换时间范围和查看明细。
                            </TextBlock>

                            <!-- 版本管理 -->
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4">
                                版本号编辑区
                            </TextBlock>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12">
                                在仪表盘底部可直接编辑当前版本号。点击「迭代标签」按钮自动递增
                                迭代编号（末段 +1）。编辑后保存，新条目将自动归属该版本。
                            </TextBlock>

                            <!-- GitHub 配置 -->
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4">
                                GitHub 推送配置
                            </TextBlock>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                配置 GitHub 仓库地址、分支名、Personal Access Token，
                                实现数据文件的一键推送。支持自动生成 commit message。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 未完成条目 ==================== -->
                    <Border x:Name="Section_UnDone"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="未完成条目（UnDonePage）"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12">
                                管理所有未完成的目标任务
                            </TextBlock>

                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6">
                                核心功能
                            </TextBlock>

                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="• 版本分组折叠 —— 条目按版本号分组，每组可折叠 / 展开，标题显示版本名和条目数&#x0a;"/>
                                <Run Text="• 收藏加星 —— 点击星标按钮收藏条目，收藏的条目在列表中高亮显示&#x0a;"/>
                                <Run Text="• 排序 —— 按严重程度（高→低）、截止日期（近→远）、版本号（升/降）以及仅收藏排序&#x0a;"/>
                                <Run Text="• 搜索过滤 —— 顶部搜索框输入关键词，在标题、简要描述、详细内容中实时过滤匹配结果&#x0a;"/>
                                <Run Text="• 展开详情 —— 点击「详情」按钮展开条目完整信息面板，包括详细描述和关联文件表格&#x0a;"/>
                                <Run Text="• 编辑条目 —— 点击编辑按钮打开编辑窗口，可修改所有字段：标题、简要、详情、严重程度、截止日期、变更需求、类型标签、关联文件&#x0a;"/>
                                <Run Text="• 完成条目 —— 将条目标记为已完成，自动记录完成时间，条目从本页移至已完成页面&#x0a;"/>
                                <Run Text="• 删除条目 —— 移除不需要的条目（不可恢复）"/>
                            </TextBlock>

                            <Separator Margin="0,10,0,6" Opacity="0.2"/>

                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6">
                                条目字段一览
                            </TextBlock>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="标题 —— 必填，条目的简短名称&#x0a;"/>
                                <Run Text="简要 —— 可选，一句话描述&#x0a;"/>
                                <Run Text="详情 —— 可选，Markdown 格式的完整描述文本&#x0a;"/>
                                <Run Text="严重程度 —— 致命 / 严重 / 一般 / 补丁 / 更新&#x0a;"/>
                                <Run Text="截止日期 —— 可选，过期条目以红色高亮提醒&#x0a;"/>
                                <Run Text="变更需求 —— 可选整数，表示变更复杂度和影响范围&#x0a;"/>
                                <Run Text="类型标签 —— 可选多选，如 bug、feature、refactor 等&#x0a;"/>
                                <Run Text="关联文件 —— 可选多条，每条含路径、函数名、行号、列号&#x0a;"/>
                                <Run Text="版本号 —— 条目创建时自动归属当前版本，不可手动修改"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 已完成条目 ==================== -->
                    <Border x:Name="Section_Done"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="已完成条目（DonePage）"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12">
                                查看和管理已完成的条目
                            </TextBlock>

                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6">
                                核心功能
                            </TextBlock>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="• 整体结构与未完成页面一致 —— 版本分组、搜索过滤、详情展开等&#x0a;"/>
                                <Run Text="• 撤销完成 —— 将已完成条目恢复为未完成状态，条目移回 UnDonePage&#x0a;"/>
                                <Run Text="• 按版本归档 —— 仅当版本内所有条目均已完成时，才显示归档按钮。归档将导出 Markdown 并删除版本数据文件&#x0a;"/>
                                <Run Text="• 编辑 —— 与未完成页面相同的编辑功能&#x0a;"/>
                                <Run Text="• 删除 —— 移除已完成条目&#x0a;"/>
                                <Run Text="• 完成日期 —— 每条目卡片额外显示「完成于」日期信息"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 扩展中心 ==================== -->
                    <Border x:Name="Section_Expand"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="扩展中心（ExpandPage）"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12">
                                插件与功能扩展管理
                            </TextBlock>

                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6">
                                核心功能
                            </TextBlock>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="• 分类浏览 —— 按插件类别分组展示可用扩展&#x0a;"/>
                                <Run Text="• 搜索过滤 —— 顶部搜索框实时过滤插件列表&#x0a;"/>
                                <Run Text="• 安装 / 卸载 —— 一键安装或卸载扩展插件&#x0a;"/>
                                <Run Text="• 详情查看 —— 点击插件卡片查看功能说明和使用方式"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 严重程度 ==================== -->
                    <Border x:Name="Section_Severity"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="严重程度（Severity）"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12">
                                条目优先级分级体系
                            </TextBlock>

                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,10">
                                严重程度从高到低共分五级，每级以对应颜色标识：
                            </TextBlock>

