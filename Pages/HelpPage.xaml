                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12">
                                多项目目录与数据管理
                            </TextBlock>

                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6">
