<Page x:Class="OCCMissionGoals.Pages.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loc="clr-namespace:OCCMissionGoals"
      mc:Ignorable="d"
      d:DesignHeight="5667" d:DesignWidth="1240"
      Title="HelpPage"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border CornerRadius="8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                Padding="24,16" Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc Zh=&quot;帮助 / 使用指南&quot;, En=&quot;Help / User Guide&quot;}"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}"
                       Margin="8,0,0,0"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====== 侧边导航 ====== -->
            <Border Grid.Column="0"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Padding="10,12"
                    VerticalAlignment="Top"
                    Margin="0,0,8,0">
                <StackPanel>
                    <Button x:Name="Nav_Overview"
                            Content="{loc:Loc Zh=&quot;概述&quot;, En=&quot;Overview&quot;}" Tag="Overview"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"
                            FontWeight="Bold"/>

                    <Separator Margin="6,8,6,6" Opacity="0.3"/>

                    <Button x:Name="Nav_Dashboard"
                            Content="{loc:Loc Zh=&quot;仪表盘&quot;, En=&quot;Dashboard&quot;}" Tag="Dashboard"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_UnDone"
                            Content="{loc:Loc Zh=&quot;未完成条目&quot;, En=&quot;Unfinished&quot;}" Tag="UnDone"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_Done"
                            Content="{loc:Loc Zh=&quot;已完成条目&quot;, En=&quot;Finished&quot;}" Tag="Done"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_Expand"
                            Content="{loc:Loc Zh=&quot;扩展中心&quot;, En=&quot;Extensions&quot;}" Tag="Expand"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>

                    <Separator Margin="6,8,6,6" Opacity="0.3"/>

                    <Button x:Name="Nav_Severity"
                            Content="{loc:Loc Zh=&quot;严重程度&quot;, En=&quot;Severity&quot;}" Tag="Severity"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_ChangeDemand"
                            Content="{loc:Loc Zh=&quot;变更需求&quot;, En=&quot;Change Demand&quot;}" Tag="ChangeDemand"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_Version"
                            Content="{loc:Loc Zh=&quot;版本号&quot;, En=&quot;Version&quot;}" Tag="Version"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_Type"
                            Content="{loc:Loc Zh=&quot;条目类型&quot;, En=&quot;Type&quot;}" Tag="Type"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>
                    <Button x:Name="Nav_RelatedFiles"
                            Content="{loc:Loc Zh=&quot;关联文件&quot;, En=&quot;Related Files&quot;}" Tag="RelatedFiles"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="28" Padding="14,0,8,0" Margin="0,1"
                            FontSize="11"/>

                    <Separator Margin="6,8,6,6" Opacity="0.3"/>

                    <Button x:Name="Nav_Shortcuts"
                            Content="{loc:Loc Zh=&quot;快捷键&quot;, En=&quot;Shortcuts&quot;}" Tag="Shortcuts"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"/>
                    <Button x:Name="Nav_Search"
                            Content="{loc:Loc Zh=&quot;搜索&quot;, En=&quot;Search&quot;}" Tag="Search"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"/>
                    <Button x:Name="Nav_Project"
                            Content="{loc:Loc Zh=&quot;项目管理&quot;, En=&quot;Projects&quot;}" Tag="Project"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"/>
                    <Button x:Name="Nav_CLI"
                            Content="{loc:Loc Zh=&quot;命令行&quot;, En=&quot;CLI&quot;}" Tag="CLI"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- ====== 内容区 ====== -->
            <ScrollViewer x:Name="ContentScroll"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="ContentScroll_ScrollChanged">
                <StackPanel>

                    <!-- ==================== 概述 ==================== -->
                    <Border x:Name="Section_Overview"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Zh=&quot;概述&quot;, En=&quot;Overview&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;OCC's Mission &amp; Goals 是一款面向开发者和项目维护者的轻量级任务跟踪工具。以「条目（Mission）」为基本单位，每一条目记录一个独立的目标任务，支持严重程度分级、截止日期、版本归属、关联文件追踪以及多项目切换。&quot;, En=&quot;OCC's Mission &amp; Goals is a lightweight task-tracking tool for developers and project maintainers. It uses the entry (Mission) as its basic unit; each entry records one independent goal, supporting severity levels, deadlines, version ownership, related-file tracking, and multi-project switching.&quot;}"
                                       FontSize="13" Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" LineHeight="22" Opacity="0.7"
                                       Margin="0,0,0,10"/>

                            <!-- 核心概念 Grid -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Padding="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Zh=&quot;条目 (Mission)&quot;, En=&quot;Mission&quot;}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{loc:Loc Zh=&quot;最基本的工作单元，包含标题、简要、详情、严重程度、截止日期、变更需求、类型标签等字段。&quot;, En=&quot;The most basic unit of work, containing fields such as title, brief, details, severity, deadline, change demand, and type tags.&quot;}"
                                                   FontSize="12" LineHeight="20" Opacity="0.5"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Padding="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Zh=&quot;版本 (Version)&quot;, En=&quot;Version&quot;}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{loc:Loc Zh=&quot;条目按版本号分组管理。版本格式为「主.次.补丁-标签.迭代」，如 0.1.0-alpha.0。&quot;, En=&quot;Entries are grouped by version number. The version format is major.minor.patch-tag.iteration, e.g. 0.1.0-alpha.0.&quot;}"
                                                   FontSize="12" LineHeight="20" Opacity="0.5"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Zh=&quot;项目 (Project)&quot;, En=&quot;Project&quot;}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{loc:Loc Zh=&quot;支持多项目目录，每个项目有独立的 data.json 和 project.json，便于 Git 版本控制与团队协作。&quot;, En=&quot;Supports multiple project directories; each project has its own data.json and project.json for Git version control and team collaboration.&quot;}"
                                                   FontSize="12" LineHeight="20" Opacity="0.5"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Separator Margin="0,14,0,6" Opacity="0.2"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;应用结构&quot;, En=&quot;App Structure&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Margin="6,0,0,0">
                                <Run Text="{loc:Loc Zh=&quot;• 导航栏      仪表盘 / 未完成条目 / 已完成条目 / 扩展中心 / 帮助&quot;, En=&quot;• Navigation      Dashboard / Unfinished / Finished / Extensions / Help&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 状态栏      项目切换下拉框&quot;, En=&quot;• Status bar      Project switcher dropdown&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 工具栏      按住 Ctrl 显示：新建条目 / 搜索 / 排序 / 推送 / CLI 等快捷操作&quot;, En=&quot;• Toolbar      Hold Ctrl to show: New Entry / Search / Sort / Push / CLI shortcuts&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 数据存储    所有条目以 JSON 格式保存在各项目目录下&quot;, En=&quot;• Storage      All entries are saved as JSON in each project directory&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 仪表盘 ==================== -->
                    <Border x:Name="Section_Dashboard"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Zh=&quot;仪表盘（LogPage）&quot;, En=&quot;Dashboard (LogPage)&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;项目总览与数据统计中心&quot;, En=&quot;Project overview and statistics center&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <!-- 总进度 -->
                            <TextBlock Text="{loc:Loc Zh=&quot;总进度卡片&quot;, En=&quot;Progress card&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;显示当前项目的条目完成率：已完成数 / 总数，配百分比进度条。一目了然地反映项目整体推进情况。&quot;, En=&quot;Shows the completion rate of the current project: finished / total, with a percentage progress bar. Gives an at-a-glance view of overall project progress.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <!-- 严重程度分布 -->
                            <TextBlock Text="{loc:Loc Zh=&quot;严重程度分布&quot;, En=&quot;Severity distribution&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;以可视化图表展示五个严重等级（致命/严重/一般/补丁/更新）各自的条目数量，帮助快速识别项目风险分布。&quot;, En=&quot;Visualizes the entry count for each of the five severity levels (Fatal/Severe/General/Patch/Update), helping you quickly identify risk distribution.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <!-- 即将到期 -->
                            <TextBlock Text="{loc:Loc Zh=&quot;即将到期&quot;, En=&quot;Upcoming deadlines&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;列出 7 天内截止的未完成条目，按到期日远近排列。点击可直接跳转到对应条目。&quot;, En=&quot;Lists unfinished entries due within 7 days, sorted by due date. Click to jump to the corresponding entry.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <!-- 最近活动 -->
                            <TextBlock Text="{loc:Loc Zh=&quot;最近活动时间线&quot;, En=&quot;Recent activity timeline&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;按时间倒序展示最近完成的条目，附带完成日期，方便追踪团队最新进展。&quot;, En=&quot;Shows recently completed entries in reverse chronological order with completion dates, for tracking the latest progress.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <!-- 贡献记录 -->
                            <TextBlock Text="{loc:Loc Zh=&quot;贡献记录柱状图&quot;, En=&quot;Contribution chart&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;按日期汇总完成数量，以柱状图直观展示每日贡献趋势，支持切换时间范围和查看明细。&quot;, En=&quot;Aggregates completions by date and shows daily contribution trends as a bar chart, with switchable time ranges and details.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <!-- 版本管理 -->
                            <TextBlock Text="{loc:Loc Zh=&quot;版本号编辑区&quot;, En=&quot;Version editor&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;在仪表盘底部可直接编辑当前版本号。点击「迭代标签」按钮自动递增迭代编号（末段 +1）。编辑后保存，新条目将自动归属该版本。&quot;, En=&quot;Edit the current version directly at the bottom of the dashboard. Click the Iterate button to auto-increment the iteration number (last segment +1). Save after editing, and new entries will belong to that version.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <!-- GitHub 配置 -->
                            <TextBlock Text="{loc:Loc Zh=&quot;GitHub 推送配置&quot;, En=&quot;GitHub push settings&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;配置 GitHub 仓库地址、分支名、Personal Access Token，实现数据文件的一键推送。支持自动生成 commit message。&quot;, En=&quot;Configure the GitHub repository URL, branch name, and Personal Access Token for one-click pushing of data files. Supports auto-generated commit messages.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 未完成条目 ==================== -->
                    <Border x:Name="Section_UnDone"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Zh=&quot;未完成条目（UnDonePage）&quot;, En=&quot;Unfinished (UnDonePage)&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;管理所有未完成的目标任务&quot;, En=&quot;Manage all unfinished goals&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;核心功能&quot;, En=&quot;Core features&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>

                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc Zh=&quot;• 版本分组折叠 —— 条目按版本号分组，每组可折叠 / 展开，标题显示版本名和条目数&quot;, En=&quot;• Version grouping — entries are grouped by version; each group can collapse/expand, and its header shows the version name and entry count&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 收藏加星 —— 点击星标按钮收藏条目，收藏的条目在列表中高亮显示&quot;, En=&quot;• Favoriting — click the star button to favorite an entry; favorited entries are highlighted in the list&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 排序 —— 按严重程度（高→低）、截止日期（近→远）、版本号（升/降）以及仅收藏排序&quot;, En=&quot;• Sorting — by severity (high→low), deadline (soonest→latest), version (asc/desc), or favorites only&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 搜索过滤 —— 顶部搜索框输入关键词实时过滤，支持前缀切换匹配范围：Text:内容、Tag:标签、Setting:设置（项目设置/主题/推送）、File:文件路径、Date:日期；不带前缀时按文字匹配，Setting: 下按回车执行设置项&quot;, En=&quot;• Search filter — type keywords in the top search box for real-time filtering, with prefix switches for match scope: Text: content, Tag: tags, Setting: settings (project/theme/push), File: file path, Date: date; without a prefix it matches text, and under Setting: press Enter to run a setting&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 展开详情 —— 点击「详情」按钮展开条目完整信息面板，包括详细描述和关联文件表格&quot;, En=&quot;• Expand details — click the Details button to expand the full info panel, including the description and related-file table&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 编辑条目 —— 点击编辑按钮打开编辑窗口，可修改所有字段：标题、简要、详情、严重程度、截止日期、变更需求、类型标签、关联文件&quot;, En=&quot;• Edit entry — click the edit button to open the editor and modify all fields: title, brief, details, severity, deadline, change demand, type tags, related files&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 完成条目 —— 将条目标记为已完成，自动记录完成时间，条目从本页移至已完成页面&quot;, En=&quot;• Complete entry — mark an entry as finished, record the completion time automatically, and move it from this page to the Finished page&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 删除条目 —— 移除不需要的条目（不可恢复）&quot;, En=&quot;• Delete entry — remove an unwanted entry (irreversible)&quot;}"/>
                            </TextBlock>

                            <Separator Margin="0,10,0,6" Opacity="0.2"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;条目字段一览&quot;, En=&quot;Entry fields&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc Zh=&quot;标题 —— 必填，条目的简短名称&quot;, En=&quot;Title — required, the entry's short name&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;简要 —— 可选，一句话描述&quot;, En=&quot;Brief — optional, one-line description&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;详情 —— 可选，Markdown 格式的完整描述文本&quot;, En=&quot;Details — optional, full description in Markdown&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;严重程度 —— 致命 / 严重 / 一般 / 补丁 / 更新&quot;, En=&quot;Severity — Fatal / Severe / General / Patch / Update&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;截止日期 —— 可选，过期条目以红色高亮提醒&quot;, En=&quot;Deadline — optional; overdue entries are highlighted in red&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;变更需求 —— 可选整数，表示变更复杂度和影响范围&quot;, En=&quot;Change demand — optional integer representing change complexity and impact&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;类型标签 —— 可选多选，如 bug、feature、refactor 等&quot;, En=&quot;Type tags — optional multi-select, e.g. bug, feature, refactor&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;关联文件 —— 可选多条，每条含路径、函数名、行号、列号&quot;, En=&quot;Related files — optional multiple entries, each with path, function name, line, and column&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;版本号 —— 条目创建时自动归属当前版本，不可手动修改&quot;, En=&quot;Version — assigned to the current version at creation and cannot be changed manually&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 已完成条目 ==================== -->
                    <Border x:Name="Section_Done"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Zh=&quot;已完成条目（DonePage）&quot;, En=&quot;Finished (DonePage)&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;查看和管理已完成的条目&quot;, En=&quot;View and manage finished entries&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;核心功能&quot;, En=&quot;Core features&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc Zh=&quot;• 整体结构与未完成页面一致 —— 版本分组、搜索过滤、详情展开等&quot;, En=&quot;• Same overall structure as the Unfinished page — version grouping, search filter, detail expansion, etc.&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 撤销完成 —— 将已完成条目恢复为未完成状态，条目移回 UnDonePage&quot;, En=&quot;• Undo completion — restore a finished entry to unfinished status, moving it back to UnDonePage&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 按版本归档 —— 仅当版本内所有条目均已完成时，才显示归档按钮。归档将导出 Markdown 并删除版本数据文件&quot;, En=&quot;• Archive by version — the archive button only appears when all entries in a version are finished. Archiving exports Markdown and deletes the version data file&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 编辑 —— 与未完成页面相同的编辑功能&quot;, En=&quot;• Edit — the same editing as on the Unfinished page&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 删除 —— 移除已完成条目&quot;, En=&quot;• Delete — remove a finished entry&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 完成日期 —— 每条目卡片额外显示「完成于」日期信息&quot;, En=&quot;• Completion date — each entry card also shows a Completed-on date&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 扩展中心 ==================== -->
                    <Border x:Name="Section_Expand"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Zh=&quot;扩展中心（ExpandPage）&quot;, En=&quot;Extensions (ExpandPage)&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;插件与功能扩展管理&quot;, En=&quot;Plugin and feature extension management&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;核心功能&quot;, En=&quot;Core features&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc Zh=&quot;• 分类浏览 —— 按插件类别分组展示可用扩展&quot;, En=&quot;• Browse by category — available extensions are grouped and shown by category&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 搜索过滤 —— 顶部搜索框实时过滤插件列表&quot;, En=&quot;• Search filter — the top search box filters the plugin list in real time&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 安装 / 卸载 —— 一键安装或卸载扩展插件&quot;, En=&quot;• Install / uninstall — install or remove an extension with one click&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 详情查看 —— 点击插件卡片查看功能说明和使用方式&quot;, En=&quot;• View details — click a plugin card to see its description and usage&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 严重程度 ==================== -->
                    <Border x:Name="Section_Severity"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Zh=&quot;严重程度（Severity）&quot;, En=&quot;Severity&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;条目优先级分级体系&quot;, En=&quot;Entry priority and severity system&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;严重程度从高到低共分五级，每级以对应颜色标识：&quot;, En=&quot;There are five severity levels from high to low, each marked by its own color:&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,10"/>

                            <WrapPanel Margin="6,0,0,14">
                                    <!-- Fatal -->
                                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,8,8"
                                            Background="#E83D3D">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Zh=&quot;致命 Fatal&quot;, En=&quot;Fatal&quot;}"
                                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Loc Zh=&quot;阻断级问题，必须立即处理&quot;, En=&quot;Blocker-level issue, must be handled immediately&quot;}"
                                                       Foreground="#DDFFFFFF" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Severe -->
                                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,8,8"
                                            Background="#E88D3D">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Zh=&quot;严重 Severe&quot;, En=&quot;Severe&quot;}"
                                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Loc Zh=&quot;重要问题，需尽快解决&quot;, En=&quot;Important issue, resolve as soon as possible&quot;}"
                                                       Foreground="#DDFFFFFF" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- General -->
                                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,8,8"
                                            Background="#E8D43D">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Zh=&quot;一般 General&quot;, En=&quot;General&quot;}"
                                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Loc Zh=&quot;常规任务和需求，默认等级&quot;, En=&quot;Routine tasks and requirements, the default level&quot;}"
                                                       Foreground="#DDFFFFFF" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Patch -->
                                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,8,8"
                                            Background="#3D9DE8">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Zh=&quot;补丁 Patch&quot;, En=&quot;Patch&quot;}"
                                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Loc Zh=&quot;小幅修改和修复，低优先级&quot;, En=&quot;Minor changes and fixes, low priority&quot;}"
                                                       Foreground="#DDFFFFFF" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Update -->
                                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,8,8"
                                            Background="#4CAF50">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Zh=&quot;更新 Update&quot;, En=&quot;Update&quot;}"
                                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Loc Zh=&quot;功能更新和体验优化，最低优先级&quot;, En=&quot;Feature updates and experience improvements, lowest priority&quot;}"
                                                       Foreground="#DDFFFFFF" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                            <TextBlock Text="{loc:Loc Zh=&quot;严重程度直接影响列表默认排序（高→低），同时在仪表盘分布图表中可视化。编辑条目时可随时调整。&quot;, En=&quot;Severity directly affects the default list sorting (high→low) and is visualized in the dashboard distribution chart. It can be adjusted at any time when editing an entry.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 变更需求 ==================== -->
                    <Border x:Name="Section_ChangeDemand"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Zh=&quot;变更需求（ChangeDemand）&quot;, En=&quot;Change Demand&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;任务变更影响度量&quot;, En=&quot;Measuring task change impact&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;变更需求是一个可选的整数字段，用于量化条目所涉及的变更复杂度和影响范围。&quot;, En=&quot;Change demand is an optional integer field that quantifies the complexity and impact of the changes involved in an entry.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,10"/>

                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc Zh=&quot;• 数值越大表示变更越复杂、影响范围越广&quot;, En=&quot;• The larger the value, the more complex and wide-ranging the change&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 支持按变更需求升序或降序排列条目列表&quot;, En=&quot;• Entries can be sorted by change demand ascending or descending&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 典型用法：0 = 无变更 / 1-3 = 小范围调整 / 4-6 = 中等重构 / 7+ = 大规模变更&quot;, En=&quot;• Typical usage: 0 = no change / 1-3 = small adjustments / 4-6 = medium refactor / 7+ = large-scale change&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 编辑条目时在编辑窗口设置&quot;, En=&quot;• Set it in the editor when editing an entry&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 版本号 ==================== -->
                    <Border x:Name="Section_Version"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Zh=&quot;版本号（Version）&quot;, En=&quot;Version&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;版本管理体系&quot;, En=&quot;Version management system&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;版本号采用五段式语义化格式：&quot;, En=&quot;The version number uses a five-segment semantic format:&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,10"/>

                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="12,8" Margin="6,0,0,10">
                                <TextBlock FontSize="14" FontWeight="SemiBold"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.7">
                                    <Run Text="{loc:Loc Zh=&quot;主版本.次版本.补丁版本-标签.迭代编号&quot;, En=&quot;major.minor.patch-tag.iteration&quot;}" FontWeight="Bold"/>
                                    <Run Text="{loc:Loc Zh=&quot;      例如: 0.1.0-alpha.0&quot;, En=&quot;      e.g. 0.1.0-alpha.0&quot;}"/>
                                </TextBlock>
                            </Border>

                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc Zh=&quot;• 每个条目归属于一个版本，创建时自动设为当前版本&quot;, En=&quot;• Each entry belongs to a version and is set to the current version when created&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 在仪表盘底部可编辑当前版本号，修改后新条目将归属新版本&quot;, En=&quot;• Edit the current version at the bottom of the dashboard; new entries belong to the new version after the change&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 点击「迭代标签」按钮自动将迭代编号 +1（如 alpha.0 → alpha.1）&quot;, En=&quot;• Click the Iterate button to increment the iteration number by 1 (e.g. alpha.0 → alpha.1)&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 条目列表按版本号分组展示，支持折叠和展开各版本&quot;, En=&quot;• The entry list is grouped by version, and each version can collapse/expand&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 已完成条目在版本内全部完成后才可归档，保持视图整洁&quot;, En=&quot;• Finished entries can only be archived after the whole version is finished, keeping the view tidy&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 条目类型 ==================== -->
                    <Border x:Name="Section_Type"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Zh=&quot;条目类型（Type）&quot;, En=&quot;Type&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;分类标签系统&quot;, En=&quot;Category tag system&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc Zh=&quot;• 每个条目可附带一个或多个类型标签（多选）&quot;, En=&quot;• Each entry can have one or more type tags (multi-select)&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 类型标签在项目配置（project.json）中统一定义和管理&quot;, En=&quot;• Type tags are defined and managed centrally in the project config (project.json)&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 常见标签：bug（缺陷）、feature（新功能）、refactor（重构）、docs（文档）、test（测试）、chore（杂项）&quot;, En=&quot;• Common tags: bug, feature, refactor, docs, test, chore&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 类型标签在条目卡片上以标签形式展示，便于快速识别&quot;, En=&quot;• Type tags appear as labels on entry cards for quick identification&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 编辑条目时在编辑窗口勾选或取消类型标签&quot;, En=&quot;• Check or uncheck type tags in the editor when editing an entry&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 关联文件 ==================== -->
                    <Border x:Name="Section_RelatedFiles"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Zh=&quot;关联文件（RelatedFiles）&quot;, En=&quot;Related Files&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;代码文件引用追踪&quot;, En=&quot;Code file reference tracking&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;每个条目可关联多条代码文件引用，用于记录与任务相关的源代码位置。每条引用包含以下字段：&quot;, En=&quot;Each entry can link to multiple code file references for recording source code locations related to the task. Each reference contains the following fields:&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,10"/>

                            <Grid Margin="6,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{loc:Loc Zh=&quot;路径 Path&quot;, En=&quot;Path&quot;}"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0.6"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;关联的源代码文件路径（必填）&quot;, En=&quot;The associated source file path (required)&quot;}"
                                           FontSize="12" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{loc:Loc Zh=&quot;函数 Function&quot;, En=&quot;Function&quot;}"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0.6"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;相关的函数或方法名（可选）&quot;, En=&quot;The related function or method name (optional)&quot;}"
                                           FontSize="12" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="{loc:Loc Zh=&quot;行号 Line&quot;, En=&quot;Line&quot;}"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0.6"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;精确的代码行号（可选）&quot;, En=&quot;The exact code line number (optional)&quot;}"
                                           FontSize="12" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="{loc:Loc Zh=&quot;列号 Column&quot;, En=&quot;Column&quot;}"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0.6"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;精确的代码列号（可选）&quot;, En=&quot;The exact code column number (optional)&quot;}"
                                           FontSize="12" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </Grid>

                            <TextBlock Text="{loc:Loc Zh=&quot;在条目详情面板中，「相关文件」表格展示所有关联引用。编辑条目时可添加、修改或删除关联文件。&quot;, En=&quot;In the entry detail panel, the Related Files table shows all linked references. You can add, modify, or delete related files when editing an entry.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 快捷键 ==================== -->
                    <Border x:Name="Section_Shortcuts"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Zh=&quot;快捷键&quot;, En=&quot;Shortcuts&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;键盘快捷操作&quot;, En=&quot;Keyboard shortcuts&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <Grid Margin="6,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition Height="24"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Padding="8,2" CornerRadius="3"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{loc:Loc Zh=&quot;按住 Ctrl&quot;, En=&quot;Hold Ctrl&quot;}" VerticalAlignment="Center"
                                               FontSize="11" FontFamily="Consolas"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Opacity="0.6"/>
                                </Border>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="{loc:Loc Zh=&quot;显示底部工具栏和侧边栏选项卡标签&quot;, En=&quot;Show the bottom toolbar and sidebar tab labels&quot;}"
                                           FontSize="12" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>

                                <Border Grid.Row="2" Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Padding="8,2" CornerRadius="3"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{loc:Loc Zh=&quot;松开 Ctrl&quot;, En=&quot;Release Ctrl&quot;}" VerticalAlignment="Center"
                                               FontSize="11" FontFamily="Consolas"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Opacity="0.6"/>
                                </Border>
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Text="{loc:Loc Zh=&quot;自动收起工具栏和侧边栏，最大化内容视野&quot;, En=&quot;Automatically collapse the toolbar and sidebar to maximize the content view&quot;}"
                                           FontSize="12" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>

                            <Separator Margin="0,12,0,6" Opacity="0.2"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;底部工具栏提供快速操作入口：新建条目、搜索过滤、排序切换、GitHub 推送、CLI 命令行模式等。按住 Ctrl 键即可查看和使用。&quot;, En=&quot;The bottom toolbar provides quick actions: new entry, search filter, sort toggle, GitHub push, CLI mode, etc. Hold Ctrl to view and use them.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 搜索 ==================== -->
                    <Border x:Name="Section_Search"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Zh=&quot;搜索&quot;, En=&quot;Search&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;查找条目与设置的完整指南&quot;, En=&quot;A guide to finding entries and settings&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;基本用法&quot;, En=&quot;Basic usage&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;搜索框位于窗口顶部工具栏中央，始终可见。输入关键词即可实时过滤当前列表页面，同时弹出搜索结果板；点击结果可跳转，或按回车直接执行首条结果。&quot;, En=&quot;The search box sits in the center of the top toolbar and is always visible. Type a keyword to filter the current list page in real time and pop up the results board; click a result to jump, or press Enter to run the top result.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;搜索模式&quot;, En=&quot;Search modes&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;支持前缀语法切换匹配范围；不加前缀时默认按文字模式匹配。&quot;, En=&quot;Prefix syntax switches the match scope; without a prefix it matches as text by default.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12">
                                <Run Text="{loc:Loc Zh=&quot;• Text: / 文字: —— 标题、简要、详情&quot;, En=&quot;• Text: — title, brief, details&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• Tag: / 标签: —— 类型标签&quot;, En=&quot;• Tag: — type tags&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• Setting: / 设置: / 配置: —— 设置（全局搜索）&quot;, En=&quot;• Setting: / settings: — settings (global search)&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• File: / 文件: —— 关联文件路径与函数名&quot;, En=&quot;• File: — related-file path and function name&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• Date: / 日期: —— 日期（yyyy-MM-dd）&quot;, En=&quot;• Date: — date (yyyy-MM-dd)&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• Plugins: / 插件: —— 扩展中心插件（全局搜索）&quot;, En=&quot;• Plugins: — Extension Center plugins (global search)&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• Expand: / 扩展: / 已安装: —— 已安装的插件（全局搜索）&quot;, En=&quot;• Expand: — installed plugins (global search)&quot;}"/>
                            </TextBlock>

                            <TextBlock Text="{loc:Loc Zh=&quot;设置搜索&quot;, En=&quot;Setting search&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;Setting: 模式不会筛选条目列表，而是在结果板中列出设置快捷项，且关键词为空时也会显示全部设置项。点击即可直接执行：切换深/浅色主题、打开项目设置、打开推送设置。&quot;, En=&quot;Setting: mode does not filter the entry list; it lists setting shortcuts in the results board instead, and shows all of them even when the keyword is empty. Click to run directly: toggle dark/light theme, open project settings, or open push settings.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;插件搜索&quot;, En=&quot;Plugin search&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;Plugins: 搜索扩展中心全部插件，Expand: 只搜索已安装插件。两者都不筛选条目列表，结果在搜索板中展示，关键词为空时列出全部对应插件；点击结果跳转到扩展中心。&quot;, En=&quot;Plugins: searches all plugins in the Extension Center; Expand: searches only installed plugins. Neither filters the entry list — results appear in the board, listing all matching plugins when the keyword is empty; click a result to jump to the Extension Center.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;结果板&quot;, En=&quot;Results board&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc Zh=&quot;• 条目结果带类型标签（未完成 / 已完成），点击「跳转」定位到对应条目。&quot;, En=&quot;• Entry results show a type label (Unfinished / Finished); click Go to locate the entry.&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 空输入时显示「按模式搜索」引导，点击前缀按钮可快速填入前缀。&quot;, En=&quot;• With empty input, a search-by-mode guide appears; click a prefix chip to fill it in.&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 点击搜索框外部关闭结果板。&quot;, En=&quot;• Click outside the search box to close the results board.&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 项目管理 ==================== -->
                    <Border x:Name="Section_Project"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Zh=&quot;项目管理&quot;, En=&quot;Projects&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;多项目目录与数据管理&quot;, En=&quot;Multi-project directories and data management&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;项目目录&quot;, En=&quot;Project directories&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;支持多项目目录，每个项目有独立的文件夹。右上角下拉框可随时切换当前项目。各项目之间的条目和版本完全独立，互不影响。&quot;, En=&quot;Supports multiple project directories, each with its own folder. Use the top-right dropdown to switch projects at any time. Entries and versions are fully independent between projects.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;数据文件&quot;, En=&quot;Data files&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12">
                                <Run Text="{loc:Loc Zh=&quot;• data.json —— 存储所有条目数据（未完成 + 已完成），JSON 数组格式&quot;, En=&quot;• data.json — stores all entry data (unfinished + finished) as a JSON array&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• project.json —— 存储项目元数据：项目名称、类型标签定义、版本号等&quot;, En=&quot;• project.json — stores project metadata: project name, type tag definitions, version number, etc.&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 文件均为纯文本 JSON，可直接用 Git 进行版本追踪和团队协作&quot;, En=&quot;• All files are plain-text JSON, so they can be tracked with Git and used for team collaboration&quot;}"/>
                            </TextBlock>

                            <TextBlock Text="{loc:Loc Zh=&quot;CLI 命令行模式&quot;, En=&quot;CLI mode&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;支持通过命令行进行脚本化操作，适用于 CI/CD 集成和批量处理场景。点击底部工具栏的 CLI 按钮或使用命令行参数启动。&quot;, En=&quot;Supports scripted operations via the command line, for CI/CD integration and batch processing. Click the CLI button in the bottom toolbar or launch with command-line arguments.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;GitHub 集成&quot;, En=&quot;GitHub integration&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;配置 GitHub 仓库、分支和 Personal Access Token 后，可一键将 data.json 推送到远程仓库。支持自动生成 commit message（包含版本号和变更摘要），实现数据的自动备份和团队共享。&quot;, En=&quot;After configuring the GitHub repository, branch, and Personal Access Token, you can push data.json to the remote repository with one click. It supports auto-generated commit messages (including the version number and change summary) for automatic backup and team sharing.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 命令行 ==================== -->
                    <Border x:Name="Section_CLI"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="24,20" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Zh=&quot;命令行（CLI）&quot;, En=&quot;CLI&quot;}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;OCCMissionGoals.exe 命令行接口&quot;, En=&quot;OCCMissionGoals.exe command-line interface&quot;}"
                                       FontSize="12" Opacity="0.4"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Zh=&quot;程序在启动时检测命令行参数：带参数启动进入 CLI 模式（控制台），无参数启动进入 GUI 模式。CLI 所有输出为标准 JSON，错误输出至 stderr，适合 AI / 脚本 / CI 集成。&quot;, En=&quot;The program detects command-line arguments at startup: launching with arguments enters CLI mode (console), and launching without arguments enters GUI mode. All CLI output is standard JSON; errors go to stderr. Suitable for AI / scripts / CI integration.&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <!-- 基本用法 -->
                            <TextBlock Text="{loc:Loc Zh=&quot;基本用法&quot;, En=&quot;Basic usage&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="12,8" Margin="6,0,0,12">
                                <TextBlock FontSize="13" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.7">
                                    <Run Text="{loc:Loc Zh=&quot;OCCMissionGoals.exe [-p &lt;项目&gt;] &lt;命令&gt; [参数]&quot;, En=&quot;OCCMissionGoals.exe [-p &lt;project&gt;] &lt;command&gt; [args]&quot;}" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>

                            <!-- 条目命令 -->
                            <TextBlock Text="{loc:Loc Zh=&quot;条目操作&quot;, En=&quot;Entry operations&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="6,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -a, --add
                                </TextBlock>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;添加条目。数据格式为 JSON 或简化的 key=value 语法。&quot;, En=&quot;Add an entry. The data format is JSON or simplified key=value syntax.&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -c, --check
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;查看条目详情（如 -c 001000001），返回完整 JSON。&quot;, En=&quot;View entry details (e.g. -c 001000001), returns the full JSON.&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -d, --done
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;将条目标记为已完成，自动记录完成日期。&quot;, En=&quot;Mark an entry as finished and record the completion date automatically.&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -u, --undone
                                </TextBlock>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;将已完成条目恢复为未完成状态。&quot;, En=&quot;Restore a finished entry to unfinished status.&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -D, --delete
                                </TextBlock>
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;删除条目（不可恢复）。&quot;, En=&quot;Delete an entry (irreversible).&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="5" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -f, --favorited
                                </TextBlock>
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;收藏 / 取消收藏。用法：-f &lt;编号&gt; true|false&quot;, En=&quot;Favorite / unfavorite. Usage: -f &lt;id&gt; true|false&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="6" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -l, --list
                                </TextBlock>
                                <TextBlock Grid.Row="6" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;列出当前项目的所有条目（未完成 + 已完成），JSON 数组。&quot;, En=&quot;List all entries in the current project (unfinished + finished) as a JSON array.&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>

                            <!-- 版本命令 -->
                            <TextBlock Text="{loc:Loc Zh=&quot;版本操作&quot;, En=&quot;Version operations&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="6,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{loc:Loc Zh=&quot;-v &lt;版本号&gt;&quot;, En=&quot;-v &lt;version&gt;&quot;}"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;切换到指定版本，后续操作在该版本的数据文件上进行。&quot;, En=&quot;Switch to a specified version; subsequent operations run on that version's data file.&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -v Iterate
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;版本迭代：当前版本号的迭代编号 +1（如 alpha.0 → alpha.1）。&quot;, En=&quot;Version iteration: increments the current version's iteration number by 1 (e.g. alpha.0 → alpha.1).&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="{loc:Loc Zh=&quot;-v Delete &lt;版本&gt;&quot;, En=&quot;-v Delete &lt;version&gt;&quot;}"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;删除指定版本的数据文件。不能删除当前版本。&quot;, En=&quot;Delete the specified version's data file. The current version cannot be deleted.&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="{loc:Loc Zh=&quot;-v Archive &lt;版本&gt;&quot;, En=&quot;-v Archive &lt;version&gt;&quot;}"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;归档指定版本 → versions/archive/ 目录。需版本内全部条目均已完成，不能归档当前版本。&quot;, En=&quot;Archive the specified version to the versions/archive/ directory. Requires all entries in the version to be finished; the current version cannot be archived.&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>

                            <!-- 全局选项 -->
                            <TextBlock Text="{loc:Loc Zh=&quot;全局选项&quot;, En=&quot;Global options&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="6,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    -p, --project
                                </TextBlock>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;指定目标项目（按目录名或 project.json 中的项目名匹配）。&quot;, En=&quot;Specify the target project (matched by directory name or project name in project.json).&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{loc:Loc Zh=&quot;-v &lt;版本号&gt;&quot;, En=&quot;-v &lt;version&gt;&quot;}"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;配合条目命令时，指定操作的目标版本。&quot;, En=&quot;When used with entry commands, specifies the target version.&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" Margin="0,4,0,0">
                                    help, -h, --help
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{loc:Loc Zh=&quot;打印帮助信息。&quot;, En=&quot;Print help information.&quot;}"
                                           FontSize="12" LineHeight="20" Opacity="0.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>

                            <!-- 添加条目示例 -->
                            <TextBlock Text="{loc:Loc Zh=&quot;-a 数据格式示例&quot;, En=&quot;-a data format example&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Loc Zh=&quot;支持标准 JSON 或用 = 代替 : 的简化语法（字段名可不加引号）：&quot;, En=&quot;Supports standard JSON or simplified syntax using = instead of : (field names can be unquoted):&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,8"/>
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="12,10" Margin="6,0,0,12">
                                <TextBlock FontSize="11" FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Opacity="0.6" LineHeight="18" TextWrapping="Wrap">
                                    <Run Text="OCCMissionGoals.exe -a {Title=&quot;"/><Run Text="{loc:Loc Zh=&quot;修复Bug&quot;, En=&quot;FixBug&quot;}"/><Run Text="&quot;, Severity=&quot;Fatal&quot;, Brief=&quot;...&quot;, Detail=&quot;...&quot;, IsFavorited=false, Version=&quot;0.1.0&quot;, Type=[&quot;Bug&quot;], RelatedFiles={&quot;P:\auth.cs&quot;=[10,5,&quot;Login&quot;]}}"/>
                                </TextBlock>
                            </Border>

                            <TextBlock Text="{loc:Loc Zh=&quot;必填字段仅 Title。Severity 默认 General。Type 为字符串数组，RelatedFiles 为路径 → [行, 列, 函数] 的映射。&quot;, En=&quot;Only Title is required. Severity defaults to General. Type is a string array; RelatedFiles maps a path → [line, column, function].&quot;}"
                                       FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,12"/>

                            <Separator Margin="0,6,0,6" Opacity="0.2"/>

                            <!-- 输出格式 -->
                            <TextBlock Text="{loc:Loc Zh=&quot;输出格式&quot;, En=&quot;Output format&quot;}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="6,0,0,0">
                                <Run Text="{loc:Loc Zh=&quot;• 正常输出 JSON（stdout），带缩进便于阅读&quot;, En=&quot;• Normal output is JSON (stdout), indented for readability&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 错误信息输出至 stderr&quot;, En=&quot;• Errors are written to stderr&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 返回码：0 = 成功，非 0 = 失败&quot;, En=&quot;• Exit code: 0 = success, non-zero = failure&quot;}"/><LineBreak/>
                                <Run Text="{loc:Loc Zh=&quot;• 条目字段：index, id, title, severity, severityLabel, brief, detail, deadline, completedAt, changeDemand, isFavorited, version, relatedFiles&quot;, En=&quot;• Entry fields: index, id, title, severity, severityLabel, brief, detail, deadline, completedAt, changeDemand, isFavorited, version, relatedFiles&quot;}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
