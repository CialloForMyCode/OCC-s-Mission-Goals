<Page x:Class="OCCMissionGoals.Pages.DonePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OCCMissionGoals.Pages"
      xmlns:loc="clr-namespace:OCCMissionGoals"
      xmlns:svc="clr-namespace:OCCMissionGoals.Services"
      mc:Ignorable="d" 
      d:DesignHeight="758" d:DesignWidth="1240"
      Title="DonePage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <svc:ContentBlockConverter x:Key="ContentBlockConverter"/>
        <svc:MarkdownConverter x:Key="MarkdownConverter" />
        <svc:MarkdownInlineConverter x:Key="MarkdownInlineConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" Grid.IsSharedSizeScope="True">
        <Grid>
            <ItemsControl x:Name="DoneList" ClipToBounds="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 每个 Item 是一个 DoneVersionGroupVM -->
                        <StackPanel>
                            <!-- 版本头：可点击折叠/展开 -->
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="{DynamicResource UiBorderThickness}" CornerRadius="{DynamicResource UiCornerRadiusMedium}"
                                    Margin="0,0,0,2" Padding="10,6"
                                    Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧：箭头+名称+计数，点击折叠 -->
                                    <Border Grid.Column="0"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="VersionHeader_Click"
                                            Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="GroupArrow"
                                                       Text="{Binding ArrowText}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="12" Opacity="0.5"
                                                       VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Run Text="("/>
                                                <Run Text="{Binding DisplayCount, Mode=OneWay}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- 右侧：归档按钮 -->
                                    <Button Grid.Column="1"
                                            Content="{loc:Loc &quot;归档&quot;}"
                                            Style="{StaticResource CardActionBtn}"
                                            Click="Archive_Click"
                                            Tag="{Binding}"
                                            Visibility="{Binding CanArchive, Converter={StaticResource BoolToVis}}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 该版本下的条目列表 -->
                            <!-- 
                                我认为应该固定标题，简介和严重程度，只在内容区做更改。做出可以拖拽的控件来代替MD。
                                我认为把原先的文件那栏撤销文件选择的自行填充，转而使用自动填充才好。这个东西适合做成总结。
                                在内容区里可以放置表格，分割线，文本输入框(只支持#标题、粗体、斜体、删除线、编号和·)
                                添加一个代码块，代码块可以选择语言，支持行号，复制，可以添加扩展包以便支持文本高亮。
                                可以添加文件导项，在这里输入文件的路径，行号列号和函数。最好是在内容去里只显示文件名，在下面的文件列表里显示完整路径。
                                可以添加一个表图，折线图/柱状图/饼图，用来支持一些东西吧。
                                最主要的是添加多级别列表，可以将一个大问题分步做，这个多级表也要支持上面说的这些。
                                最后，在条目没展开的时候，鼠标悬停超过两秒就将条目变宽展开一个概览区域，概览区域包括Type和完成度进度条。
                                ok，这是非常好的设计。最后，我希望他们都可以拖拽添加/排序删除。
                             -->
                            <ItemsControl x:Name="GroupItems"
                                          ItemsSource="{Binding Items}"
                                          ClipToBounds="True"
                                          svc:ExpandAnimation.Expanded="{Binding IsExpanded}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CardBorder"
                                                Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="{DynamicResource UiBorderThickness}" CornerRadius="{DynamicResource UiCornerRadiusLarge}"
                                                Margin="6,0,6,0" Padding="12,8"
                                                Tag="{Binding}"
                                                MouseEnter="Card_MouseEnter"
                                                MouseLeave="Card_MouseLeave">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            CornerRadius="{DynamicResource UiCornerRadiusSmall}" Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding SeverityBrush}">
                                                        <TextBlock Text="{Binding SeverityText}"
                                                                   Foreground="White" FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <Grid Grid.Column="2"
                                                          VerticalAlignment="Center"
                                                          Margin="10,0,8,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TitleCol"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <ContentControl Grid.Column="0"
                                                                        Content="{Binding Title, Mode=OneWay, Converter={StaticResource MarkdownInlineConverter}}"
                                                                        Foreground="{DynamicResource ForegroundBrush}"
                                                                        FontSize="14" FontWeight="SemiBold"
                                                                        VerticalAlignment="Center"/>
                                                        <ContentControl Grid.Column="1"
                                                                        Content="{Binding Brief, Mode=OneWay, Converter={StaticResource MarkdownInlineConverter}, ConverterParameter=excerpt}"
                                                                        Foreground="{DynamicResource ForegroundBrush}"
                                                                        FontSize="12"
                                                                        VerticalAlignment="Center"
                                                                        Margin="10,0,0,0"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Visibility="{Binding IsExcerptVisible, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Grid.Column="2"
                                                                   x:Name="ToggleLink"
                                                                   Text="{Binding DetailToggleText}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   TextDecorations="Underline"
                                                                   FontSize="12" Cursor="Hand"
                                                                   Background="Transparent"
                                                                   VerticalAlignment="Center"
                                                                   Margin="6,0,0,0"
                                                                   MouseLeftButtonUp="DetailToggle_Click"/>
                                                    </Grid>

                                                    <StackPanel Grid.Column="3"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <Path Fill="{DynamicResource ForegroundBrush}" Stretch="Uniform"
                                                              Width="14" Height="14" Margin="0,0,4,0"
                                                              Data="M8 1.5C4.412 1.5 1.5 4.412 1.5 8S4.412 14.5 8 14.5 14.5 11.588 14.5 8 11.588 1.5 8 1.5zM8 2.5c3.036 0 5.5 2.464 5.5 5.5s-2.464 5.5-5.5 5.5S2.5 11.036 2.5 8 4.964 2.5 8 2.5zM11.354 5.646L10.646 4.94 6.5 9.086 4.854 7.44 4.146 8.146 6.146 10.146 6.5 10.5l.354-.354 4.5-4.5z"/>
                                                        <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                                                                   FontSize="12" VerticalAlignment="Center">
                                                            <Run Text="{loc:Loc &quot;完成于&quot;}"/>
                                                            <Run Text="{Binding CompletedAt, StringFormat=yyyy-MM-dd HH:mm, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CardActionBtn}"
                                                                Click="Edit_Click" Tag="{Binding}"
                                                                Foreground="{DynamicResource ForegroundBrush}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Fill="{DynamicResource ForegroundBrush}" Stretch="Uniform"
                                                                      Width="12" Height="12" Margin="0,0,4,0"
                                                                      Data="M14.452 1.548C14.087 1.183 13.608 1 13.13 1C12.652 1 12.173 1.183 11.808 1.548L6.979 6.377C6.697 6.659 6.498 7.011 6.401 7.398L6.027 8.896C5.883 9.473 6.329 10.002 6.886 10.002C6.958 10.002 7.031 9.993 7.106 9.975L8.604 9.601C8.99 9.504 9.343 9.305 9.625 9.023L14.454 4.194C15.184 3.464 15.184 2.28 14.454 1.549L14.452 1.548ZM13.745 3.485L8.916 8.314C8.763 8.467 8.57 8.576 8.36 8.629L7.04 8.962L7.371 7.64C7.424 7.43 7.532 7.237 7.686 7.084L12.516 2.255C12.68 2.091 12.899 2 13.131 2C13.363 2 13.582 2.091 13.746 2.255C14.085 2.594 14.085 3.146 13.746 3.486L13.745 3.485Z"/>
                                                                <TextBlock Text="{loc:Loc &quot;编辑&quot;}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Content="{loc:Loc &quot;撤销完成&quot;}" Style="{StaticResource CardActionBtn}"
                                                                Click="UndoComplete_Click" Tag="{Binding}"/>
                                                        <Button Content="{loc:Loc &quot;删除&quot;}" Style="{StaticResource CardActionBtn}"
                                                                Click="Delete_Click" Tag="{Binding}"
                                                                Foreground="#E86A6A"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel x:Name="DetailPanel"
                                                            ClipToBounds="True"
                                                            svc:ExpandAnimation.Expanded="{Binding IsDetailExpanded}">
                                                    <!-- 内容区：标题 / 简介 / 严重程度固定在上方，正文随区块变化 -->
                                                    <ItemsControl ItemsSource="{Binding Contents}"
                                                                  Margin="10,8,10,0"
                                                                  Visibility="{Binding HasContents, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ContentControl Content="{Binding Converter={StaticResource ContentBlockConverter}}"
                                                                                HorizontalAlignment="Stretch"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                                Visibility="{Binding HasType, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{loc:Loc &quot;类别&quot;}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                                        <ItemsControl ItemsSource="{Binding TypeTags}"
                                                                      VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border x:Name="TagBg" CornerRadius="3" Padding="6,2"
                                                                            Background="{DynamicResource SubtleBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                                                            BorderThickness="{DynamicResource UiBorderThickness}"
                                                                            Margin="0,0,5,0">
                                                                        <TextBlock x:Name="TagText" Text="{Binding Text}"
                                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                                   FontSize="11"
                                                                                   VerticalAlignment="Center"
                                                                                   Opacity="0.8"/>
                                                                    </Border>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding HasColor}" Value="True">
                                                                            <Setter TargetName="TagBg" Property="Background" Value="{Binding Background}"/>
                                                                            <Setter TargetName="TagBg" Property="BorderBrush" Value="{Binding Background}"/>
                                                                            <Setter TargetName="TagText" Property="Foreground" Value="White"/>
                                                                            <Setter TargetName="TagText" Property="Opacity" Value="1"/>
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FileCol"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LineCol"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColCol"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FuncCol"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{loc:Loc &quot;相关文件&quot;}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{loc:Loc &quot;函数&quot;}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   FontSize="11" Opacity="0.5" FontFamily="Consolas"
                                                                   Margin="16,0,0,0"/>
                                                        <TextBlock Grid.Column="2" Text="{loc:Loc &quot;行&quot;}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   FontSize="11" Opacity="0.5" FontFamily="Consolas"
                                                                   Margin="24,0,0,0"/>
                                                        <TextBlock Grid.Column="3" Text="{loc:Loc &quot;列&quot;}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   FontSize="11" Opacity="0.5" FontFamily="Consolas"
                                                                   Margin="16,0,0,0"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding RelatedFiles, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2,0,0"
                                                                      Background="Transparent"
                                                                      Cursor="Hand"
                                                                      ToolTip="{loc:Loc &quot;点击跳转到内容区里引用该文件的位置&quot;}"
                                                                      MouseLeftButtonUp="RelatedFile_Click">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FileCol"/>
                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LineCol"/>
                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ColCol"/>
                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FuncCol"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" FontSize="12"
                                                                               FontFamily="Consolas"
                                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                                               Text="{Binding Path, Mode=OneWay}"/>
                                                                    <TextBlock Grid.Column="1" FontSize="11"
                                                                               FontFamily="Consolas"
                                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                                               Opacity="0.6" Margin="16,0,0,0"
                                                                               Text="{Binding Function, Mode=OneWay}"/>
                                                                    <TextBlock Grid.Column="2" FontSize="11"
                                                                               FontFamily="Consolas"
                                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                                               Opacity="0.6" Margin="24,0,0,0"
                                                                               Text="{Binding Line, Mode=OneWay}"/>
                                                                    <TextBlock Grid.Column="3" FontSize="11"
                                                                               FontFamily="Consolas"
                                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                                               Opacity="0.6" Margin="16,0,0,0"
                                                                               Text="{Binding Column, Mode=OneWay}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button Style="{StaticResource CardActionBtn}"
                                                            Click="CopyInfo_Click" Tag="{Binding}"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,10,0,0"
                                                            Foreground="{DynamicResource ForegroundBrush}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Fill="{DynamicResource ForegroundBrush}" Stretch="Uniform"
                                                                  Width="12" Height="12" Margin="0,0,4,0"
                                                                  Data="M16 1H4C2.9 1 2 1.9 2 3V17H4V3H16V1ZM19 5H8C6.9 5 6 5.9 6 7V21C6 22.1 6.9 23 8 23H19C20.1 23 21 22.1 21 21V7C21 5.9 20.1 5 19 5ZM19 21H8V7H19V21Z"/>
                                                            <TextBlock Text="{loc:Loc &quot;复制信息&quot;}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                <!-- 概览：鼠标停留 2 秒时展开，点「详情」展开后持久显示（类别 + 完成度）；悬停或展开详情时条目左右扩宽到最大 -->
                                                <StackPanel x:Name="HoverOverview"
                                                            ClipToBounds="True"
                                                            svc:ExpandAnimation.Expanded="{Binding ShowOverview}">
                                                    <Grid Margin="0,10,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto" MaxWidth="320"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{loc:Loc &quot;概览&quot;}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Margin="0,0,10,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TypeSummary}"
                                                                   FontSize="11" Opacity="0.7"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                                        <Grid Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ProgressBar Grid.Column="0" Height="8"
                                                                         HorizontalAlignment="Stretch"
                                                                         Minimum="0" Maximum="100"
                                                                         Value="{Binding Progress, Mode=OneWay}"
                                                                         BorderThickness="0"
                                                                         Foreground="{DynamicResource PrimaryBrush}"
                                                                         Background="{DynamicResource SubtleBackgroundBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                                                                       FontSize="11" Opacity="0.7"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ShowOverview}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ThicknessAnimation Storyboard.TargetName="CardBorder"
                                                                            Storyboard.TargetProperty="Margin"
                                                                            To="0,0,0,0" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ThicknessAnimation Storyboard.TargetName="CardBorder"
                                                                            Storyboard.TargetProperty="Margin"
                                                                            To="6,0,6,0" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="EmptyPlaceholder"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="{DynamicResource UiBorderThickness}" CornerRadius="{DynamicResource UiCornerRadiusLarge}"
                    Margin="0,0,0,6" Padding="24,20"
                    VerticalAlignment="Top">
                <TextBlock Text="{loc:Loc &quot;没有已完成条目&quot;}"
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="15" Opacity="0.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
