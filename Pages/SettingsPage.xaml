<Page x:Class="OCCMissionGoals.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:loc="clr-namespace:OCCMissionGoals"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="2800" d:DesignWidth="1240"
      Title="SettingsPage"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="AccentSwatchRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Outer"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="13"
                                Padding="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border CornerRadius="8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                Padding="24,16" Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc &quot;设置&quot;}"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}"
                       Margin="8,0,0,0"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====== 侧边导航 ====== -->
            <Border Grid.Column="0"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Padding="10,12"
                    VerticalAlignment="Top"
                    Margin="0,0,8,0">
                <StackPanel>
                    <Button x:Name="Nav_Appearance"
                            Content="{loc:Loc &quot;外观主题&quot;}" Tag="Appearance"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"
                            FontWeight="Bold"/>

                    <Separator Margin="6,8,6,6" Opacity="0.3"/>

                    <Button x:Name="Nav_Project"
                            Content="{loc:Loc &quot;项目信息&quot;}" Tag="Project"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"/>
                    <Button x:Name="Nav_Push"
                            Content="{loc:Loc &quot;推送 / 仓库&quot;}" Tag="Push"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"/>
                    <Button x:Name="Nav_System"
                            Content="{loc:Loc &quot;系统 / 更新&quot;}" Tag="System"
                            Click="NavButton_Click"
                            Style="{StaticResource CardActionBtn}"
                            HorizontalContentAlignment="Left"
                            Height="32" Margin="0,1"
                            FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- ====== 内容区 ====== -->
            <ScrollViewer x:Name="ContentScroll"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="ContentScroll_ScrollChanged">
                <StackPanel>

                <!-- ==================== 外观主题 ==================== -->
                <Border x:Name="Section_Appearance"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Padding="24,20" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc &quot;外观主题&quot;}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,12"/>
                        <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="{loc:Loc &quot;选择应用的整体明暗风格。更改会立即生效并保存。&quot;}"/>

                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LightThemeRadio"
                                         Content="{loc:Loc &quot;浅色&quot;}"
                                         GroupName="ThemeGroup" Tag="light"
                                         Checked="ThemeRadio_Checked"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         FontSize="13" Margin="0,0,24,0"
                                         VerticalContentAlignment="Center"/>
                            <RadioButton x:Name="DarkThemeRadio"
                                         Content="{loc:Loc &quot;深色&quot;}"
                                         GroupName="ThemeGroup" Tag="dark"
                                         Checked="ThemeRadio_Checked"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         FontSize="13" Margin="0,0,0,0"
                                         VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc &quot;语言&quot;}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,18,0,8"/>
                        <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="{loc:Loc &quot;选择界面显示语言，更改会立即生效并保存。&quot;}"/>

                        <ComboBox x:Name="LanguageCombo"
                                  Style="{StaticResource DialogComboBox}"
                                  HorizontalAlignment="Left" Width="180"
                                  SelectionChanged="Language_SelectionChanged"/>


                        <TextBlock Text="{loc:Loc &quot;主题色&quot;}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,18,0,8"/>
                        <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="{loc:Loc &quot;选择应用的主题强调色，用于按钮、进度与选中态等。更改会立即生效并保存。&quot;}"/>

                        <WrapPanel x:Name="AccentSwatchPanel" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc &quot;自定义&quot;}" Style="{StaticResource DialogLabel}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="AccentHexBox" Width="110"
                                     Style="{StaticResource DialogTextBox}"
                                     VerticalAlignment="Center"/>
                            <Button Content="{loc:Loc &quot;应用&quot;}" Click="ApplyAccentHex_Click"
                                    Style="{StaticResource DialogConfirmButton}"
                                    Height="28" MinWidth="0" Width="64" Padding="0"
                                    Margin="8,0,0,0" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== 项目信息 ==================== -->
                <Border x:Name="Section_Project"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Padding="24,20" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc &quot;项目信息&quot;}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,12"/>
                        <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="{loc:Loc &quot;编辑当前打开项目的名称与描述。当前版本号由版本管理维护，此处只读展示。&quot;}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc &quot;项目名称&quot;}"
                                       Style="{StaticResource DialogLabel}"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="ProjectNameBox" Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource DialogTextBox}"
                                     VerticalAlignment="Center" Margin="0,3,0,3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc &quot;项目描述&quot;}"
                                       Style="{StaticResource DialogLabel}"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="ProjectDescBox" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource DialogTextBox}"
                                     VerticalAlignment="Center" Margin="0,3,0,3"
                                     Height="64" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc &quot;当前版本&quot;}"
                                       Style="{StaticResource DialogLabel}"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="ProjectVersionBox" Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource DialogTextBox}"
                                     IsReadOnly="True" Opacity="0.7" Margin="0,3,0,3"
                                     VerticalAlignment="Center"/>
                        </Grid>

                        <Button x:Name="SaveProjectBtn" Content="{loc:Loc &quot;保存项目信息&quot;}"
                                Click="SaveProject_Click"
                                Style="{StaticResource DialogConfirmButton}"
                                HorizontalAlignment="Left" MinWidth="120" Height="34"/>
                    </StackPanel>
                </Border>

                <!-- ==================== 推送 / 仓库 ==================== -->
                <Border x:Name="Section_Push"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Padding="24,20" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc &quot;推送 / 仓库设置&quot;}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,12"/>
                        <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="{loc:Loc &quot;管理「更新日志」提交生成时使用的目标仓库与提交选项。更改会自动保存。&quot;}"/>

                        <!-- 目标仓库（从 GitHub 选择） -->
                        <TextBlock x:Name="ReposHeader"
                                   Text="{loc:Loc &quot;目标仓库&quot;}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="RepoSelector" Grid.Column="0"
                                      Style="{StaticResource DialogComboBox}"
                                      ItemContainerStyle="{StaticResource DialogComboBoxItem}"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="RepoSelector_SelectionChanged"
                                      Margin="0,0,8,0"
                                      ToolTip="{loc:Loc &quot;从已登录的 GitHub 账号选择目标仓库&quot;}"/>
                            <Button Grid.Column="1" Content="{loc:Loc &quot;刷新&quot;}"
                                    Click="RefreshRepos_Click"
                                    Style="{StaticResource DialogConfirmButton}"
                                    Height="30" MinWidth="0" Width="64" Padding="0"/>
                        </Grid>
                        <TextBlock x:Name="RepoLoginHint" FontSize="12" Opacity="0.6"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="{loc:Loc &quot;未登录 GitHub：请先在账号页登录后点击「刷新」。&quot;}"/>

                        <!-- 分支（选择已有或输入新分支名） -->
                        <Grid x:Name="BranchRow" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Loc &quot;分支&quot;}"
                                       Style="{StaticResource DialogLabel}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="BranchSelector" Grid.Column="1"
                                      Style="{StaticResource DialogComboBox}"
                                      ItemContainerStyle="{StaticResource DialogComboBoxItem}"
                                      IsEditable="True"
                                      SelectionChanged="BranchSelector_SelectionChanged"
                                      LostFocus="BranchSelector_LostFocus"
                                      ToolTip="{loc:Loc &quot;选择已有分支，或输入新分支名以在推送时自动创建&quot;}"/>
                        </Grid>

                        <!-- 远程文件路径（从 bin 文件夹选择） -->
                        <Grid x:Name="RemotePathRow" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Loc &quot;要推送的文件&quot;}"
                                       Style="{StaticResource DialogLabel}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="RemotePathCombo" Grid.Column="1"
                                      Style="{StaticResource DialogComboBox}"
                                      ItemContainerStyle="{StaticResource DialogComboBoxItem}"
                                      SelectionChanged="RemotePath_SelectionChanged"
                                      Margin="0,0,8,0"
                                      ToolTip="{loc:Loc &quot;从程序 bin 文件夹中选择要推送的文件&quot;}"/>
                            <Button Grid.Column="2" Content="{loc:Loc &quot;刷新&quot;}"
                                    Click="RefreshBinFiles_Click"
                                    Style="{StaticResource DialogConfirmButton}"
                                    Height="30" MinWidth="0" Width="64" Padding="0"/>
                        </Grid>

                        <Separator Margin="0,4,0,12" Opacity="0.2"/>

                        <!-- 提交选项 -->
                        <TextBlock x:Name="CommitOptionsHeader"
                                   Text="{loc:Loc &quot;提交生成选项&quot;}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,8"/>

                        <CheckBox x:Name="IncludeAuthorCheck"
                                  Content="{loc:Loc &quot;提交信息包含作者&quot;}"
                                  Checked="IncludeAuthor_Changed" Unchecked="IncludeAuthor_Changed"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  FontSize="13" Margin="0,0,0,6"/>
                        <CheckBox x:Name="GroupByDateCheck"
                                  Content="{loc:Loc &quot;按日期分组&quot;}"
                                  Checked="GroupByDate_Changed" Unchecked="GroupByDate_Changed"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  FontSize="13" Margin="0,0,0,12"/>
                    </StackPanel>
                </Border>

                <!-- ==================== 系统 / 更新 ==================== -->
                <Border x:Name="Section_System"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Padding="24,20" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc &quot;系统 / 更新&quot;}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- 开机自启动 -->
                        <TextBlock Text="{loc:Loc &quot;开机自启动&quot;}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="{loc:Loc &quot;登录 Windows 后自动启动本应用，通过当前用户启动项注册表实现，无需管理员权限。&quot;}"/>

                        <CheckBox x:Name="AutoStartCheck"
                                  Content="{loc:Loc &quot;开机自动启动&quot;}"
                                  Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  FontSize="13" Margin="0,0,0,6"/>

                        <Separator Margin="0,10,0,14" Opacity="0.2"/>

                        <!-- 自动更新 -->
                        <TextBlock Text="{loc:Loc &quot;自动更新&quot;}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock FontSize="12" LineHeight="20" Opacity="0.5"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="{loc:Loc &quot;从 GitHub Releases 检查新版本，确认后自动下载并运行安装程序。&quot;}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc &quot;当前版本&quot;}"
                                       Style="{StaticResource DialogLabel}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="CurrentVersionText"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox x:Name="AutoCheckStartupCheck"
                                  Content="{loc:Loc &quot;启动时自动检查更新&quot;}"
                                  Checked="AutoCheckStartup_Changed" Unchecked="AutoCheckStartup_Changed"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  FontSize="13" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="CheckUpdateBtn"
                                    Content="{loc:Loc &quot;检查更新&quot;}"
                                    Click="CheckUpdate_Click"
                                    Style="{StaticResource DialogConfirmButton}"
                                    Height="32" MinWidth="0" Width="108" Padding="0" FontSize="12"/>
                            <Button x:Name="DownloadUpdateBtn"
                                    Content="{loc:Loc &quot;下载并安装&quot;}"
                                    Click="DownloadUpdate_Click"
                                    Style="{StaticResource DialogConfirmButton}"
                                    Height="32" MinWidth="0" Width="116" Padding="0" FontSize="12"
                                    Margin="8,0,0,0" Visibility="Collapsed"/>
                            <Button x:Name="OpenReleaseBtn"
                                    Content="{loc:Loc &quot;打开下载页&quot;}"
                                    Click="OpenRelease_Click"
                                    Style="{StaticResource DialogCancelButton}"
                                    Height="32" MinWidth="0" Width="116" Padding="0" FontSize="12"
                                    Margin="8,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <TextBlock x:Name="UpdateStatusText"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Opacity="0.7" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
