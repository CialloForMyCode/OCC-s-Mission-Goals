<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!-- 主题元数据：显示名（作为本地化键，UI 通过 LocalizationManager.T 翻译） -->
    <s:String x:Key="__theme_name">默认主题</s:String>

    <!-- ================================================================
         浅色配色（Light.*）
         运行时由 ThemeManager 根据当前明暗模式复制到应用资源（去掉前缀）
    ================================================================ -->

    <!-- 文字/图标 -->
    <SolidColorBrush x:Key="Light.ForegroundBrush" Color="#8a8a8a"/>

    <!-- 主背景 -->
    <SolidColorBrush x:Key="Light.BackgroundBrush"     Color="#f3f3f3"/>
    <SolidColorBrush x:Key="Light.MainBorderBrush"     Color="#808a8a8a"/>

    <!-- 卡片/面板 -->
    <SolidColorBrush x:Key="Light.CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Light.CardBorderBrush"     Color="#ebebeb"/>

    <!-- 搜索框 -->
    <SolidColorBrush x:Key="Light.SearchBackgroundBrush"  Color="#e7e7e7"/>
    <SolidColorBrush x:Key="Light.SearchBorderBrush"      Color="#e7e7e7"/>
    <SolidColorBrush x:Key="Light.SearchFocusBgBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Light.SearchFocusBorderBrush" Color="#c0c0c0"/>
    <SolidColorBrush x:Key="Light.SearchHoverBorderBrush" Color="#d8d8d8"/>

    <!-- 交互状态 -->
    <SolidColorBrush x:Key="Light.SubtleBackgroundBrush"   Color="#e6e6e6"/>
    <SolidColorBrush x:Key="Light.HoverBackgroundBrush"    Color="#e8e8e8"/>
    <SolidColorBrush x:Key="Light.PressedBackgroundBrush"  Color="#d0d0d0"/>
    <SolidColorBrush x:Key="Light.SelectedBackgroundBrush" Color="#b0b0b0"/>

    <!-- 窗口控制 -->
    <SolidColorBrush x:Key="Light.WinControlHoverBrush"   Color="#e0e0e0"/>
    <SolidColorBrush x:Key="Light.WinControlPressedBrush" Color="#c0c0c0"/>

    <!-- 菜单弹出层 -->
    <SolidColorBrush x:Key="Light.MenuPopupBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Light.MenuPopupBorderBrush"     Color="#c8c8c8"/>
    <SolidColorBrush x:Key="Light.DisabledForegroundBrush"  Color="#b0b0b0"/>

    <!-- 分隔线 -->
    <SolidColorBrush x:Key="Light.SeparatorBrush" Color="#d8d8d8"/>

    <!-- 路径/图标描边 -->
    <SolidColorBrush x:Key="Light.IconStrokeBrush" Color="#8a8a8a"/>

    <!-- 启动按钮 -->
    <SolidColorBrush x:Key="Light.RunButton" Color="#8a8a8a"/>

    <!-- 选中态前景色 -->
    <SolidColorBrush x:Key="Light.SelectedForegroundBrush" Color="#FFFFFF"/>

    <!-- 代码（Markdown 内联代码 / 代码块） -->
    <SolidColorBrush x:Key="Light.CodeBackgroundBrush" Color="#eef0f3"/>
    <SolidColorBrush x:Key="Light.CodeBorderBrush"     Color="#d6d9dd"/>

    <!-- 终端/控制台 -->
    <SolidColorBrush x:Key="Light.TerminalBackgroundBrush"     Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Light.TerminalForegroundBrush"     Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Light.TerminalScrollBarBrush"      Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Light.TerminalScrollBarHoverBrush" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Light.TerminalSelectionBrush"      Color="#ADD6FF"/>

    <!-- ================================================================
         深色配色（Dark.*）
    ================================================================ -->

    <!-- 文字/图标 -->
    <SolidColorBrush x:Key="Dark.ForegroundBrush" Color="#b0b0b0"/>

    <!-- 主背景 -->
    <SolidColorBrush x:Key="Dark.BackgroundBrush"     Color="#0e0e11"/>
    <SolidColorBrush x:Key="Dark.MainBorderBrush"     Color="#80222225"/>

    <!-- 卡片/面板 -->
    <SolidColorBrush x:Key="Dark.CardBackgroundBrush" Color="#18181b"/>
    <SolidColorBrush x:Key="Dark.CardBorderBrush"     Color="#222225"/>

    <!-- 搜索框 -->
    <SolidColorBrush x:Key="Dark.SearchBackgroundBrush"  Color="#202025"/>
    <SolidColorBrush x:Key="Dark.SearchBorderBrush"      Color="#222225"/>
    <SolidColorBrush x:Key="Dark.SearchFocusBgBrush"     Color="#18181b"/>
    <SolidColorBrush x:Key="Dark.SearchFocusBorderBrush" Color="#3a3a40"/>
    <SolidColorBrush x:Key="Dark.SearchHoverBorderBrush" Color="#2a2a2f"/>

    <!-- 交互状态 -->
    <SolidColorBrush x:Key="Dark.SubtleBackgroundBrush"   Color="#2a2a30"/>
    <SolidColorBrush x:Key="Dark.HoverBackgroundBrush"    Color="#2a2a30"/>
    <SolidColorBrush x:Key="Dark.PressedBackgroundBrush"  Color="#3a3a40"/>
    <SolidColorBrush x:Key="Dark.SelectedBackgroundBrush" Color="#696976"/>

    <!-- 窗口控制 -->
    <SolidColorBrush x:Key="Dark.WinControlHoverBrush"   Color="#2a2a30"/>
    <SolidColorBrush x:Key="Dark.WinControlPressedBrush" Color="#3a3a40"/>

    <!-- 菜单弹出层 -->
    <SolidColorBrush x:Key="Dark.MenuPopupBackgroundBrush" Color="#18181b"/>
    <SolidColorBrush x:Key="Dark.MenuPopupBorderBrush"     Color="#3a3a40"/>
    <SolidColorBrush x:Key="Dark.DisabledForegroundBrush"  Color="#555555"/>

    <!-- 分隔线 -->
    <SolidColorBrush x:Key="Dark.SeparatorBrush" Color="#3a3a40"/>

    <!-- 路径/图标描边 -->
    <SolidColorBrush x:Key="Dark.IconStrokeBrush" Color="#b0b0b0"/>

    <!-- 启动按钮 -->
    <SolidColorBrush x:Key="Dark.RunButton" Color="#b0b0b0"/>

    <!-- 选中态前景色 -->
    <SolidColorBrush x:Key="Dark.SelectedForegroundBrush" Color="#FFFFFF"/>

    <!-- 代码（Markdown 内联代码 / 代码块） -->
    <SolidColorBrush x:Key="Dark.CodeBackgroundBrush" Color="#222228"/>
    <SolidColorBrush x:Key="Dark.CodeBorderBrush"     Color="#33333a"/>

    <!-- 终端/控制台 -->
    <SolidColorBrush x:Key="Dark.TerminalBackgroundBrush"     Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Dark.TerminalForegroundBrush"     Color="#D4D4D4"/>
    <SolidColorBrush x:Key="Dark.TerminalScrollBarBrush"      Color="#424242"/>
    <SolidColorBrush x:Key="Dark.TerminalScrollBarHoverBrush" Color="#555555"/>
    <SolidColorBrush x:Key="Dark.TerminalSelectionBrush"      Color="#264f78"/>

</ResourceDictionary>
